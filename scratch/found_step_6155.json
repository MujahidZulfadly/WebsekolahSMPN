{
  "Path": "d:\\web-smpn1-rantepao\\views\\admin.ejs",
  "Replacement": "                <div class=\"flex justify-end gap-2 pt-4 border-t border-slate-100\">\n                    <button type=\"button\" onclick=\"closeModal('modal-edit-ppdb')\" class=\"px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\">Batal</button>\n                    <button type=\"submit\" class=\"px-5 py-2 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm\">Simpan Perubahan</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- ============================================== -->\n    <!-- MODAL PENGATURAN PPDB & GELOMBANG -->\n    <!-- ============================================== -->\n    <div id=\"modal-pengaturan-ppdb\" class=\"fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]\">\n            <div class=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n                <div>\n                    <h3 class=\"font-bold text-base sm:text-lg text-slate-800 flex items-center gap-2\">\n                        <i class=\"fa-solid fa-sliders text-indigo-600\"></i>\n                        <span>Pengaturan Loket & Kuota PPDB</span>\n                    </h3>\n                    <p class=\"text-xs text-slate-400 mt-0.5\">Atur status buka/tutup loket, daya tampung kuota jalur seleksi, dan tanggal pendaftaran</p>\n                </div>\n                <button type=\"button\" onclick=\"closeModal('modal-pengaturan-ppdb')\" class=\"text-slate-400 hover:text-slate-600\">\n                    <i class=\"fa-solid fa-xmark text-lg\"></i>\n                </button>\n            </div>\n\n            <form action=\"/admin/ppdb/pengaturan\" method=\"POST\" class=\"space-y-4 mt-4 text-xs\">\n                <% \n                   const pSetting = (typeof ppdbSetting !== 'undefined') ? ppdbSetting : {};\n                   const formatDate = (val) => {\n                       if (!val) return '';\n                       if (typeof val === 'string') return val.substring(0, 10);\n                       if (val instanceof Date) return val.toISOString().split('T')[0];\n                       return '';\n                   };\n                %>\n                <div class=\"grid sm:grid-cols-3 gap-4\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Status Loket Pendaftaran *</label>\n                        <select name=\"status_loket\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white font-bold text-slate-800\">\n                            <option value=\"Buka\" <%= (pSetting.status_loket === 'Buka') ? 'selected' : '' %>>🟢 Buka (Pendaftaran Aktif)</option>\n                            <option value=\"Verifikasi\" <%= (pSetting.status_loket === 'Verifikasi') ? 'selected' : '' %>>🟡 Verifikasi Berkas</option>\n                            <option value=\"Pengumuman\" <%= (pSetting.status_loket === 'Pengumuman') ? 'selected' : '' %>>🔵 Pengumuman Hasil</option>\n                            <option value=\"Daftar Ulang\" <%= (pSetting.status_loket === 'Daftar Ulang') ? 'selected' : '' %>>🟣 Daftar Ulang</option>\n                            <option value=\"Tutup\" <%= (pSetting.status_loket === 'Tutup') ? 'selected' : '' %>>🔴 Tutup</option>\n                        </select>\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Tahun Ajaran *</label>\n                        <input type=\"text\" name=\"tahun_ajaran\" value=\"<%= pSetting.tahun_ajaran || '2026/2027' %>\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Nama Gelombang *</label>\n                        <input type=\"text\" name=\"nama_gelombang\" value=\"<%= pSetting.nama_gelombang || 'Gelombang 1 (Reguler & Zonasi)' %>\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                </div>\n\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\">\n                    <h4 class=\"font-bold text-slate-700 text-[11px] uppercase tracking-wider flex items-center gap-1.5\">\n                        <i class=\"fa-solid fa-users-line text-blue-600\"></i>\n                        <span>Daya Tampung / Kuota Jalur Seleksi (Jumlah Siswa)</span>\n                    </h4>\n                    <div class=\"grid grid-cols-2 sm:grid-cols-5 gap-3\">\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Kuota Total</label>\n                            <input type=\"number\" name=\"kuota_total\" value=\"<%= pSetting.kuota_total || 320 %>\" required class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 font-bold text-blue-900 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Zonasi (50%)</label>\n                            <input type=\"number\" name=\"kuota_zonasi\" value=\"<%= pSetting.kuota_zonasi || 160 %>\" required class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Prestasi (30%)</label>\n                            <input type=\"number\" name=\"kuota_prestasi\" value=\"<%= pSetting.kuota_prestasi || 96 %>\" required class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Afirmasi (15%)</label>\n                            <input type=\"number\" name=\"kuota_afirmasi\" value=\"<%= pSetting.kuota_afirmasi || 48 %>\" required class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Mutasi (5%)</label>\n                            <input type=\"number\" name=\"kuota_mutasi\" value=\"<%= pSetting.kuota_mutasi || 16 %>\" required class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3\">\n                    <h4 class=\"font-bold text-slate-700 text-[11px] uppercase tracking-wider flex items-center gap-1.5\">\n                        <i class=\"fa-solid fa-calendar-days text-amber-600\"></i>\n                        <span>Jadwal Pelaksanaan PPDB</span>\n                    </h4>\n                    <div class=\"grid sm:grid-cols-4 gap-3\">\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Mulai Pendaftaran</label>\n                            <input type=\"date\" name=\"tgl_mulai_daftar\" value=\"<%= formatDate(pSetting.tgl_mulai_daftar) %>\" class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Batas Pendaftaran</label>\n                            <input type=\"date\" name=\"tgl_selesai_daftar\" value=\"<%= formatDate(pSetting.tgl_selesai_daftar) %>\" class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Pengumuman Hasil</label>\n                            <input type=\"date\" name=\"tgl_pengumuman\" value=\"<%= formatDate(pSetting.tgl_pengumuman) %>\" class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                        <div>\n                            <label class=\"block text-[11px] font-semibold text-slate-600 mb-1\">Daftar Ulang</label>\n                            <input type=\"date\" name=\"tgl_daftar_ulang\" value=\"<%= formatDate(pSetting.tgl_daftar_ulang) %>\" class=\"w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600\">\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"grid sm:grid-cols-3 gap-4\">\n                    <div class=\"sm:col-span-1\">\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Kontak WhatsApp Panitia PPDB</label>\n                        <input type=\"text\" name=\"kontak_panitia\" value=\"<%= pSetting.kontak_panitia || '0812-3456-7890' %>\" placeholder=\"Contoh: 0812-3456-7890\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div class=\"sm:col-span-2\">\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Teks Pengumuman untuk Calon Siswa</label>\n                        <textarea name=\"pesan_pengumuman\" rows=\"2\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600\" placeholder=\"Pesan resmi terkait tahapan atau instruksi pendaftaran...\"><%= pSetting.pesan_pengumuman || '' %></textarea>\n                    </div>\n                </div>\n\n                <div class=\"flex justify-end gap-2 pt-4 border-t border-slate-100\">\n                    <button type=\"button\" onclick=\"closeModal('modal-pengaturan-ppdb')\" class=\"px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\">Batal</button>\n                    <button type=\"submit\" class=\"px-5 py-2 font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm\">Simpan Pengaturan PPDB</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- ============================================== -->\n    <!-- MODAL TAMBAH PENGURUS OSIS -->\n    <!-- ============================================== -->\n    <div id=\"modal-tambah-osis-pengurus\" class=\"fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]\">\n            <div class=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n                <h3 class=\"font-bold text-base text-slate-800 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-user-plus text-blue-600\"></i>\n                    <span>Tambah Pengurus OSIS</span>\n                </h3>\n                <button type=\"button\" onclick=\"closeModal('modal-tambah-osis-pengurus')\" class=\"text-slate-400 hover:text-slate-600\">\n                    <i class=\"fa-solid fa-xmark text-lg\"></i>\n                </button>\n            </div>\n            <form action=\"/admin/osis/pengurus/tambah\" method=\"POST\" enctype=\"multipart/form-data\" class=\"space-y-4 mt-4 text-xs\">\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Nama Lengkap Siswa *</label>\n                    <input type=\"text\" name=\"nama_lengkap\" required placeholder=\"Contoh: Gabriel Ranteallo\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Jabatan *</label>\n                        <input type=\"text\" name=\"jabatan\" required placeholder=\"Contoh: Ketua OSIS / Sekbid 1\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Kategori Jabatan *</label>\n                        <select name=\"kategori\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white\">\n                            <option value=\"Pengurus Inti\">Pengurus Inti (Ketua, Wakil, Sek, Bend)</option>\n                            <option value=\"Seksi Bidang\">Seksi Bidang (Sekbid)</option>\n                            <option value=\"Anggota\">Anggota / Pembina</option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Kelas Siswa</label>\n                        <input type=\"text\" name=\"kelas\" placeholder=\"Contoh: Kelas VIII-A\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Nomor Urutan Tampil</label>\n                        <input type=\"number\" name=\"urutan_tampil\" value=\"10\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                </div>\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Motto / Komitmen Diri</label>\n                    <input type=\"text\" name=\"motto\" placeholder=\"Contoh: Belajar dengan tekun, memimpin dengan ketulusan.\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                </div>\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Foto Pengurus</label>\n                    <input type=\"file\" name=\"foto_osis\" accept=\"image/*\" class=\"w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100\">\n                </div>\n                <div class=\"flex justify-end gap-2 pt-3 border-t border-slate-100\">\n                    <button type=\"button\" onclick=\"closeModal('modal-tambah-osis-pengurus')\" class=\"px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\">Batal</button>\n                    <button type=\"submit\" class=\"px-5 py-2 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm\">Simpan Pengurus</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- ============================================== -->\n    <!-- MODAL EDIT PENGURUS OSIS -->\n    <!-- ============================================== -->\n    <div id=\"modal-edit-osis-pengurus\" class=\"fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]\">\n            <div class=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n                <h3 class=\"font-bold text-base text-slate-800 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-pen-to-square text-blue-600\"></i>\n                    <span>Edit Pengurus OSIS</span>\n                </h3>\n                <button type=\"button\" onclick=\"closeModal('modal-edit-osis-pengurus')\" class=\"text-slate-400 hover:text-slate-600\">\n                    <i class=\"fa-solid fa-xmark text-lg\"></i>\n                </button>\n            </div>\n            <form id=\"form-edit-osis-pengurus\" method=\"POST\" enctype=\"multipart/form-data\" class=\"space-y-4 mt-4 text-xs\">\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Nama Lengkap Siswa *</label>\n                    <input type=\"text\" id=\"edit-osis-pengurus-nama\" name=\"nama_lengkap\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Jabatan *</label>\n                        <input type=\"text\" id=\"edit-osis-pengurus-jabatan\" name=\"jabatan\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Kategori Jabatan *</label>\n                        <select id=\"edit-osis-pengurus-kategori\" name=\"kategori\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white\">\n                            <option value=\"Pengurus Inti\">Pengurus Inti</option>\n                            <option value=\"Seksi Bidang\">Seksi Bidang</option>\n                            <option value=\"Anggota\">Anggota / Pembina</option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Kelas Siswa</label>\n                        <input type=\"text\" id=\"edit-osis-pengurus-kelas\" name=\"kelas\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Nomor Urutan Tampil</label>\n                        <input type=\"number\" id=\"edit-osis-pengurus-urutan\" name=\"urutan_tampil\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                </div>\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Motto / Komitmen Diri</label>\n                    <input type=\"text\" id=\"edit-osis-pengurus-motto\" name=\"motto\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                </div>\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Ganti Foto Pengurus (Kosongkan jika tetap)</label>\n                    <input type=\"file\" name=\"foto_osis\" accept=\"image/*\" class=\"w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100\">\n                </div>\n                <div class=\"flex justify-end gap-2 pt-3 border-t border-slate-100\">\n                    <button type=\"button\" onclick=\"closeModal('modal-edit-osis-pengurus')\" class=\"px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\">Batal</button>\n                    <button type=\"submit\" class=\"px-5 py-2 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm\">Simpan Perubahan</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- ============================================== -->\n    <!-- MODAL TAMBAH PROKER OSIS -->\n    <!-- ============================================== -->\n    <div id=\"modal-tambah-osis-proker\" class=\"fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]\">\n            <div class=\"flex items-center justify-between pb-3 border-b border-slate-100\">\n                <h3 class=\"font-bold text-base text-slate-800 flex items-center gap-2\">\n                    <i class=\"fa-solid fa-plus text-blue-600\"></i>\n                    <span>Tambah Program Kerja OSIS</span>\n                </h3>\n                <button type=\"button\" onclick=\"closeModal('modal-tambah-osis-proker')\" class=\"text-slate-400 hover:text-slate-600\">\n                    <i class=\"fa-solid fa-xmark text-lg\"></i>\n                </button>\n            </div>\n            <form action=\"/admin/osis/proker/tambah\" method=\"POST\" class=\"space-y-4 mt-4 text-xs\">\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Nama Program Kerja *</label>\n                    <input type=\"text\" name=\"judul\" required placeholder=\"Contoh: Latihan Dasar Kepemimpinan Siswa (LDKS)\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Seksi Bidang (Kategori) *</label>\n                        <select name=\"kategori\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white\">\n                            <option value=\"Sekbid 1: Keagamaan & Budi Pekerti\">Sekbid 1: Keagamaan & Budi Pekerti</option>\n                            <option value=\"Sekbid 2: Kepemimpinan & Bela Negara\">Sekbid 2: Kepemimpinan & Bela Negara</option>\n                            <option value=\"Sekbid 3: Akademik & IPTEK\">Sekbid 3: Akademik & IPTEK</option>\n                            <option value=\"Sekbid 4: Seni, Budaya & Olahraga\">Sekbid 4: Seni, Budaya & Olahraga</option>\n                            <option value=\"Sekbid 5: Lingkungan Hidup & Sosial\">Sekbid 5: Lingkungan Hidup & Sosial</option>\n                            <option value=\"Sekbid 6: TIK & Literasi Digital\">Sekbid 6: TIK & Literasi Digital</option>\n                            <option value=\"Pengurus Inti\">Pengurus Inti</option>\n                        </select>\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Status Proker *</label>\n                        <select name=\"status\" required class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white\">\n                            <option value=\"Sedang Berjalan\">Sedang Berjalan</option>\n                            <option value=\"Terencana\">Terencana</option>\n                            <option value=\"Terlaksana\">Terlaksana</option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Jadwal Pelaksanaan</label>\n                        <input type=\"text\" name=\"jadwal\" placeholder=\"Contoh: Setiap Sabtu / November 2026\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Target Sasaran</label>\n                        <input type=\"text\" name=\"target\" placeholder=\"Contoh: Pengurus OSIS & MPK\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                </div>\n                <div class=\"grid sm:grid-cols-2 gap-3\">\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Ikon FontAwesome</label>\n                        <input type=\"text\" name=\"icon\" value=\"fa-compass\" placeholder=\"Contoh: fa-star\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 font-mono\">\n                    </div>\n                    <div>\n                        <label class=\"block font-semibold text-slate-600 mb-1\">Urutan Tampil</label>\n                        <input type=\"number\" name=\"urutan_tampil\" value=\"10\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600\">\n                    </div>\n                </div>\n                <div>\n                    <label class=\"block font-semibold text-slate-600 mb-1\">Deskripsi Singkat Program</label>\n                    <textarea name=\"deskripsi\" rows=\"3\" class=\"w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600\" placeholder=\"Jelaskan tujuan dan gambaran program kerja ini...\"></textarea>\n                </div>\n                <div class=\"flex justify-end gap-2 pt-3 border-t border-slate-100\">\n                    <button type=\"button\" onclick=\"closeModal('modal-tambah-osis-proker')\" class=\"px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg\">Batal</button>\n                    <button type=\"submit\" class=\"px-5 py-2 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm\">Simpan Proker</button>\n                </div>\n            </form>\n        </div>\n    </div>\n\n    <!-- ============================================== -->\n    <!-- MODAL EDIT PROKER OSIS -->\n    <!-- ============================================== -->\n    <div id=\"modal-edit-osis