<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri Dokumentasi & Kegiatan - <%= profil.nama_sekolah %></title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Unified Navbar Component -->
    <%- include('partials/navbar', { activePage: 'galeri' }) %>

    <!-- Breadcrumb Bar -->
    <div class="bg-slate-100 border-b border-slate-200 py-3.5 px-4">
        <div class="max-w-7xl mx-auto flex items-center text-xs text-slate-500 gap-2">
            <a href="/" class="hover:text-blue-900 font-medium">Beranda</a>
            <span>/</span>
            <span class="text-slate-800 font-semibold">Galeri Dokumentasi Sekolah</span>
        </div>
    </div>

    <!-- Hero Section Galeri -->
    <section class="bg-gradient-to-r from-blue-950 via-slate-900 to-blue-900 text-white py-14 px-4 relative overflow-hidden">
        <div class="max-w-7xl mx-auto relative z-10 text-center">
            <span class="inline-block bg-amber-500/20 text-amber-400 border border-amber-500/40 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-widest mb-3">
                Dokumentasi Visual
            </span>
            <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
                Galeri & Rekam Jejak Kegiatan
            </h1>
            <p class="text-slate-300 text-sm md:text-base max-w-2xl mx-auto mt-3 leading-relaxed">
                Koleksi foto dokumentasi aktivitas belajar mengajar, upacara, pelestarian budaya Toraja, fasilitas sarana sekolah, dan prestasi siswa <%= profil.nama_sekolah %>.
            </p>
        </div>
    </section>

    <!-- Main Content: Filter & Gallery Grid -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full flex-1">

        <!-- Filter Tab Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10">
            <a href="/galeri" class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 <%= (kategoriAktif === 'Semua') ? 'bg-blue-950 text-white shadow-md' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200' %>">
                <span>Semua Foto</span>
                <span class="px-2 py-0.5 rounded-full text-[11px] <%= (kategoriAktif === 'Semua') ? 'bg-amber-500 text-blue-950' : 'bg-slate-100 text-slate-600' %>">
                    <%= statsGaleri.total || galeriList.length %>
                </span>
            </a>
            <a href="/galeri?kategori=Kegiatan" class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 <%= (kategoriAktif === 'Kegiatan') ? 'bg-blue-950 text-white shadow-md' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200' %>">
                <span>🎭 Kegiatan Sekolah</span>
                <span class="px-2 py-0.5 rounded-full text-[11px] <%= (kategoriAktif === 'Kegiatan') ? 'bg-amber-500 text-blue-950' : 'bg-slate-100 text-slate-600' %>">
                    <%= statsGaleri.kegiatan || 0 %>
                </span>
            </a>
            <a href="/galeri?kategori=Fasilitas" class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 <%= (kategoriAktif === 'Fasilitas') ? 'bg-blue-950 text-white shadow-md' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200' %>">
                <span>🏛️ Sarana & Fasilitas</span>
                <span class="px-2 py-0.5 rounded-full text-[11px] <%= (kategoriAktif === 'Fasilitas') ? 'bg-amber-500 text-blue-950' : 'bg-slate-100 text-slate-600' %>">
                    <%= statsGaleri.fasilitas || 0 %>
                </span>
            </a>
            <a href="/galeri?kategori=Prestasi" class="px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center gap-2 <%= (kategoriAktif === 'Prestasi') ? 'bg-blue-950 text-white shadow-md' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200' %>">
                <span>🏆 Prestasi Siswa</span>
                <span class="px-2 py-0.5 rounded-full text-[11px] <%= (kategoriAktif === 'Prestasi') ? 'bg-amber-500 text-blue-950' : 'bg-slate-100 text-slate-600' %>">
                    <%= statsGaleri.prestasi || 0 %>
                </span>
            </a>
        </div>

        <!-- Gallery Grid -->
        <% if (galeriList && galeriList.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                <% galeriList.forEach((foto, idx) => { %>
                    <div class="gallery-card bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group cursor-pointer"
                         data-idx="<%= idx %>"
                         data-id="<%= foto.id_galeri %>"
                         data-judul="<%= foto.judul_foto %>"
                         data-kategori="<%= foto.kategori_galeri %>"
                         data-deskripsi="<%= foto.deskripsi_singkat || '' %>"
                         data-tgl="<%= new Date(foto.tanggal_upload).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>"
                         data-src="/uploads/galeri/<%= foto.file_foto %>">
                        
                        <!-- Image Container with Zoom effect -->
                        <div class="relative overflow-hidden aspect-[4/3] bg-slate-900">
                            <img src="/uploads/galeri/<%= foto.file_foto %>" 
                                 alt="<%= foto.judul_foto %>" 
                                 class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80';">
                            
                            <!-- Category Badge -->
                            <div class="absolute top-3 left-3 z-10">
                                <% if (foto.kategori_galeri === 'Prestasi') { %>
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-amber-500 text-blue-950 shadow-md">
                                        🏆 Prestasi
                                    </span>
                                <% } else if (foto.kategori_galeri === 'Fasilitas') { %>
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-600 text-white shadow-md">
                                        🏛️ Fasilitas
                                    </span>
                                <% } else { %>
                                    <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-blue-600 text-white shadow-md">
                                        🎭 Kegiatan
                                    </span>
                                <% } %>
                            </div>

                            <!-- Click to enlarge hover overlay -->
                            <div class="absolute inset-0 bg-blue-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                <span class="bg-white/90 text-blue-950 text-xs font-bold px-3.5 py-1.5 rounded-xl shadow flex items-center gap-1.5">
                                    🔍 Perbesar Foto
                                </span>
                            </div>
                        </div>

                        <!-- Card Content -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <p class="text-[11px] font-semibold text-slate-400 mb-1 flex items-center gap-1">
                                    <span>📅</span>
                                    <span><%= new Date(foto.tanggal_upload).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                                </p>
                                <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-blue-700 transition">
                                    <%= foto.judul_foto %>
                                </h3>
                                <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                                    <%= foto.deskripsi_singkat %>
                                </p>
                            </div>
                            <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs text-blue-700 font-semibold">
                                <span>Lihat Dokumentasi</span>
                                <span>→</span>
                            </div>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center max-w-lg mx-auto shadow-sm">
                <div class="w-16 h-16 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center text-3xl mx-auto mb-4">
                    🖼️
                </div>
                <h3 class="font-bold text-lg text-slate-800">Belum Ada Foto Dokumentasi</h3>
                <p class="text-xs text-slate-500 mt-2 leading-relaxed">
                    Koleksi foto untuk kategori <span class="font-semibold text-blue-900">"<%= kategoriAktif %>"</span> belum tersedia. Foto dokumentasi baru dapat diunggah melalui Panel Admin.
                </p>
                <div class="mt-6 flex justify-center gap-3">
                    <a href="/galeri" class="text-xs font-bold text-blue-800 bg-blue-50 hover:bg-blue-100 px-4 py-2 rounded-xl transition">
                        Semua Kategori
                    </a>
                    <a href="/admin?tab=galeri" class="text-xs font-bold text-white bg-blue-950 hover:bg-blue-900 px-4 py-2 rounded-xl transition">
                        Upload Foto di Admin ⚙
                    </a>
                </div>
            </div>
        <% } %>

    </main>

    <!-- Modal Lightbox / Viewer Foto Fullscreen -->
    <div id="modal-lightbox" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="relative max-w-4xl w-full bg-slate-900 rounded-2xl overflow-hidden shadow-2xl border border-slate-800 flex flex-col max-h-[92vh]">
            
            <!-- Modal Header -->
            <div class="px-5 py-3.5 bg-slate-950/80 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center gap-2 overflow-hidden pr-4">
                    <span id="lb-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-600 text-white">
                        Kegiatan
                    </span>
                    <span id="lb-tgl" class="text-xs text-slate-400">📅 Tanggal</span>
                </div>
                <button type="button" id="lb-close-btn" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-lg font-bold transition">
                    ✕
                </button>
            </div>

            <!-- Modal Image Preview -->
            <div class="relative bg-black flex items-center justify-center overflow-hidden flex-1 min-h-[300px] max-h-[60vh]">
                <img id="lb-img" src="" alt="Preview Foto" class="max-h-full max-w-full object-contain">
            </div>

            <!-- Modal Caption Footer -->
            <div class="p-5 bg-slate-950 text-white">
                <h2 id="lb-judul" class="text-base sm:text-lg font-bold leading-snug text-white">
                    Judul Foto
                </h2>
                <p id="lb-deskripsi" class="text-xs sm:text-sm text-slate-300 mt-1.5 leading-relaxed">
                    Deskripsi foto
                </p>
            </div>

        </div>
    </div>

    <!-- Unified Footer Component -->
    <%- include('partials/footer') %>

    <!-- Lightbox Interactive Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const lightbox = document.getElementById('modal-lightbox');
            const lbImg = document.getElementById('lb-img');
            const lbJudul = document.getElementById('lb-judul');
            const lbDeskripsi = document.getElementById('lb-deskripsi');
            const lbTgl = document.getElementById('lb-tgl');
            const lbBadge = document.getElementById('lb-badge');
            const closeBtn = document.getElementById('lb-close-btn');

            // Open Lightbox on card click
            document.querySelectorAll('.gallery-card').forEach(card => {
                card.addEventListener('click', () => {
                    const src = card.getAttribute('data-src');
                    const judul = card.getAttribute('data-judul');
                    const deskripsi = card.getAttribute('data-deskripsi');
                    const tgl = card.getAttribute('data-tgl');
                    const kategori = card.getAttribute('data-kategori');

                    lbImg.src = src;
                    lbJudul.textContent = judul;
                    lbDeskripsi.textContent = deskripsi || '-';
                    lbTgl.textContent = '📅 ' + tgl;
                    lbBadge.textContent = kategori;

                    if (kategori === 'Prestasi') {
                        lbBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-500 text-blue-950';
                    } else if (kategori === 'Fasilitas') {
                        lbBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-600 text-white';
                    } else {
                        lbBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-600 text-white';
                    }

                    lightbox.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                });
            });

            function closeLightbox() {
                lightbox.classList.add('hidden');
                lbImg.src = '';
                document.body.style.overflow = '';
            }

            if (closeBtn) closeBtn.addEventListener('click', closeLightbox);

            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) closeLightbox();
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !lightbox.classList.contains('hidden')) {
                    closeLightbox();
                }
            });
        });
    </script>
</body>
</html>
