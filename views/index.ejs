                                            <span class="w-12 h-12 rounded-2xl bg-amber-500 text-blue-950 flex items-center justify-center text-lg shadow-lg group-hover:scale-110 transition-transform">
                                                <i class="fa-solid fa-magnifying-glass-plus"></i>
                                            </span>
                                            <span class="text-white text-xs font-bold drop-shadow tracking-wide">
                                                Klik untuk Perbesar
                                            </span>
                                        </div>

                                        <!-- Category Tag Badge -->
                                        <div class="absolute top-3.5 left-3.5 z-10">
                                            <% if (foto.kategori_galeri === 'Prestasi') { %>
                                                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500 text-blue-950 shadow-md flex items-center gap-1.5">
                                                    <i class="fa-solid fa-trophy text-[9px]"></i>
                                                    <span>Prestasi</span>
                                                </span>
                                            <% } else if (foto.kategori_galeri === 'Fasilitas') { %>
                                                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white shadow-md flex items-center gap-1.5">
                                                    <i class="fa-solid fa-building-columns text-[9px]"></i>
                                                    <span>Fasilitas</span>
                                                </span>
                                            <% } else { %>
                                                <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-600 text-white shadow-md flex items-center gap-1.5">
                                                    <i class="fa-solid fa-camera text-[9px]"></i>
                                                    <span>Kegiatan</span>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>

                                    <div class="p-6 flex-1 flex flex-col justify-between">
                                        <div>
                                            <div class="flex items-center text-[11px] text-slate-400 font-medium">
                                                <span class="flex items-center gap-1.5">
                                                    <i class="fa-solid fa-calendar-day text-slate-400"></i>
                                                    <span>
                                                        <%= new Date(foto.tanggal_upload).toLocaleDateString('id-ID', {
                                                            day: 'numeric' , month: 'long' , year: 'numeric' }) %>
                                                    </span>
                                                </span>
                                            </div>
                                            <h3 class="font-bold text-slate-900 text-base mt-2 line-clamp-2 group-hover:text-blue-950 transition-colors leading-snug">
                                                <%= foto.judul_foto %>
                                            </h3>
                                            <% if (foto.deskripsi_singkat) { %>
                                                <p class="text-xs text-slate-500 mt-2 line-clamp-2 leading-relaxed">
                                                    <%= foto.deskripsi_singkat %>
                                                </p>
                                            <% } %>
                                        </div>
                                        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs text-blue-950 font-bold group-hover:text-amber-600 transition-colors">
                                            <span class="flex items-center gap-1.5">
                                                <i class="fa-regular fa-image text-amber-500"></i>
                                                <span>Lihat Pratinjau Foto</span>
                                            </span>
                                            <span class="text-amber-500 group-hover:translate-x-1 transition-transform">→</span>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <!-- Empty State if no photos match category -->
                        <div id="home-galeri-empty" class="hidden py-16 text-center bg-slate-50 rounded-3xl border border-slate-200 mt-4">
                            <div class="w-14 h-14 bg-blue-100 text-blue-950 rounded-2xl flex items-center justify-center text-2xl mx-auto mb-3">
                                <i class="fa-solid fa-images"></i>
                            </div>
                            <h4 class="font-bold text-slate-800 text-base">Belum Ada Dokumentasi pada Kategori Ini</h4>
                            <p class="text-xs text-slate-500 mt-1">Silakan pilih kategori lainnya untuk melihat dokumentasi sekolah.</p>
                        </div>

                        <!-- Tombol CTA Lihat Galeri Selengkapnya -->
                        <div class="mt-14 text-center" data-aos="fade-up">
                            <a href="/galeri"
                                class="inline-flex items-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-950 via-blue-900 to-blue-950 hover:from-blue-900 hover:to-blue-800 text-white font-extrabold text-sm sm:text-base shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 border border-blue-800/50 group">
                                <span>Buka Halaman Galeri Selengkapnya</span>
                                <span class="text-amber-400 font-black group-hover:translate-x-1.5 transition-transform duration-300 text-lg leading-none">→</span>
                            </a>
                        </div>
                    </div>
                </section>

                <!-- Modal Lightbox / Viewer Foto Fullscreen di Beranda -->
                <div id="home-lightbox-modal"
                    class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex items-center justify-center p-3 sm:p-6 transition-all duration-300">
                    <div class="relative max-w-4xl w-full bg-slate-900 rounded-3xl overflow-hidden shadow-2xl border border-slate-800 flex flex-col max-h-[92vh]">

                        <!-- Header Modal -->
                        <div class="px-5 py-3.5 bg-slate-950/90 border-b border-slate-800 flex items-center justify-between">
                            <div class="flex items-center gap-2 overflow-hidden pr-4">
                                <span id="home-lb-badge"
                                    class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-600 text-white">
                                    Kegiatan
                                </span>
                                <span class="text-xs text-slate-400 flex items-center gap-1.5">
                                    <i class="fa-solid fa-calendar-day text-slate-500"></i>
                                    <span id="home-lb-tgl">Tanggal</span>
                                </span>
                            </div>
                            <div class="flex items-center gap-2">
                                <a href="/galeri" class="text-[11px] text-amber-400 hover:underline flex items-center gap-1 hidden sm:inline-flex mr-2">
                                    <span>Halaman Galeri</span>
                                    <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                </a>
                                <button type="button" id="home-lb-close-btn"
                                    class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-sm font-bold transition">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Image Display with Nav Buttons -->
                        <div class="relative bg-black flex items-center justify-center overflow-hidden flex-1 min-h-[280px] max-h-[60vh] select-none">
                            <img id="home-lb-img" src="" alt="Preview Foto" class="max-h-full max-w-full object-contain transition-all duration-300">
                            
                            <!-- Prev & Next Arrows -->
                            <button type="button" id="home-lb-prev-btn"
