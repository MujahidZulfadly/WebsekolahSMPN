<!DOCTYPE html>
<html lang="id" class="scroll-smooth">

<head>
    <%- include('partials/head', { title: (profil.nama_sekolah || 'UPT SMPN 1 RANTEPAO' ) + ' - Kabupaten Toraja Utara'
        }) %>
</head>

<body
    class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-amber-400 selection:text-blue-950">

    <!-- ============================================================== -->
    <!-- 1. SPLASH SCREEN (PRELOADER) -->
    <!-- ============================================================== -->
    <div id="preloader"
        class="fixed inset-0 z-[9999] bg-blue-950 flex flex-col items-center justify-center transition-opacity duration-700 ease-out select-none">
        <div class="relative flex flex-col items-center px-4">
            <!-- Pulsing ambient glow -->
            <div class="absolute -inset-6 rounded-full bg-amber-400/20 blur-2xl animate-pulse"></div>

            <!-- School Logo Monogram with Rotating/Pulsing Animation -->
            <div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center transform hover:scale-105 transition-transform p-2">
                <% if (profil && profil.logo_sekolah) { %>
                    <img src="/uploads/profil/<%= profil.logo_sekolah %>" alt="Logo <%= profil.nama_sekolah || 'SMPN 1 Rantepao' %>" class="w-full h-full object-contain relative z-10 drop-shadow-md" onerror="this.onerror=null; this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');">
                    <span class="hidden animate-pulse tracking-tight">S1</span>
                <% } else { %>
                    <span class="animate-pulse tracking-tight">S1</span>
                <% } %>
                
            </div>

            <!-- School Title & Subtitle -->
            <h2 class="text-xl sm:text-2xl font-black text-white mt-6 tracking-wide text-center">
                <%= profil.nama_sekolah || 'UPT SMPN 1 RANTEPAO' %>
            </h2>
            <p class="text-xs sm:text-sm text-amber-400 font-medium mt-1 tracking-wider text-center">
                Kabupaten Toraja Utara • Akreditasi <%= profil.akreditasi || 'A' %>
            </p>

            <!-- Loading Bar with Amber-400 -->
            <div
                class="w-56 sm:w-72 h-1.5 bg-blue-900/80 rounded-full overflow-hidden mt-6 border border-blue-800/80 p-0.5">
                <div
                    class="h-full bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500 rounded-full animate-progress-bar">
                </div>
            </div>

            <p class="text-[11px] text-slate-400 mt-3 font-mono tracking-widest uppercase">
                Memuat Informasi Sekolah...
            </p>
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- 2 & 3. UNIFIED TOP BAR & NAVBAR (PARTIAL) -->
    <!-- ============================================================== -->
    <%- include('partials/navbar', { activePage: 'beranda' }) %>

        <!-- ============================================================== -->
        <!-- 4. HERO SECTION INTERAKTIF (CAROUSEL & SAMBUTAN) -->
        <!-- ============================================================== -->
        <!-- ========================================== -->
        <!-- HERO IMAGE SLIDER (DINAMIS DARI ADMIN)     -->
        <!-- ========================================== -->
        <section id="beranda" class="relative w-full h-[520px] sm:h-[580px] md:h-[650px] overflow-hidden select-none touch-pan-y">

            <!-- Wadah Gambar Background Slider -->
            <div id="hero-slides" class="relative w-full h-full">
                <% if (typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0) { %>
                    <% heroSliders.forEach((slide, idx) => { %>
                    <div class="hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out <%= idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0' %>">
                        <img src="<%= slide.gambar.startsWith('http') ? slide.gambar : (slide.gambar.startsWith('/') ? slide.gambar : '/' + slide.gambar) %>"
                            alt="<%= slide.judul %>"
                            class="w-full h-full object-cover object-center scale-105 transition-transform duration-[5000ms]">
                        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/75 via-slate-900/50 to-slate-950/30"></div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out opacity-100 z-10">
                        <img src="https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=1920&q=80"
                            alt="Suasana Sekolah"
                            class="w-full h-full object-cover object-center scale-105 transition-transform duration-[5000ms]">
                        <div class="absolute inset-0 bg-gradient-to-r from-slate-950/75 via-slate-900/50 to-slate-950/30"></div>
                    </div>
                <% } %>
            </div>

            <!-- Kotak Glassmorphism di Sebelah Kiri -->
            <div class="absolute inset-0 z-20 max-w-7xl mx-auto px-6 md:px-12 flex items-center">
                <div
                    class="bg-slate-900/65 backdrop-blur-md border border-white/20 p-5 sm:p-8 md:p-11 rounded-2xl sm:rounded-3xl max-w-xl text-white shadow-2xl transition-all duration-500">
                    <h2 id="slide-title" class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-amber-400 tracking-wide">
                        <%= (typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0) ? heroSliders[0].judul : 'Pendidikan Berkualitas' %>
                    </h2>
                    <p id="slide-desc" class="mt-2.5 sm:mt-4 text-xs sm:text-sm md:text-base text-slate-100 leading-relaxed font-normal line-clamp-3 sm:line-clamp-none">
                        <%= (typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0) ? (heroSliders[0].deskripsi || '') : ('Pendidikan Berkualitas bermula pada Pendidikan Berkarakter, Visioner, dan Berbudaya. ' + (typeof profil !== 'undefined' && profil.nama_sekolah ? profil.nama_sekolah : 'UPT SMPN 1 Rantepao') + ' berkomitmen mewujudkan sekolah yang Edukatif, Dinamis, dan Unggul di Toraja Utara.') %>
                    </p>
                    <div class="mt-5 sm:mt-7">
                        <a id="slide-btn" href="<%= (typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0 && heroSliders[0].link_tombol) ? heroSliders[0].link_tombol : '#profil' %>"
                            class="inline-flex items-center bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs sm:text-sm px-5 py-3 sm:px-7 sm:py-3.5 rounded-full shadow-lg transition transform hover:-translate-y-0.5">
                            <span id="slide-btn-text"><%= (typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0 && heroSliders[0].teks_tombol) ? heroSliders[0].teks_tombol : 'Lihat Selengkapnya' %></span> <span class="ml-2 text-lg leading-none">→</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Tombol Panah Kiri (<) dan Kanan (>) -->
            <button onclick="prevSlide()"
                class="absolute left-3 md:left-6 top-1/2 -translate-y-1/2 z-30 text-white/70 hover:text-white bg-black/20 hover:bg-black/40 p-3 rounded-full backdrop-blur-sm transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <button onclick="nextSlide()"
                class="absolute right-3 md:right-6 top-1/2 -translate-y-1/2 z-30 text-white/70 hover:text-white bg-black/20 hover:bg-black/40 p-3 rounded-full backdrop-blur-sm transition">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </button>

            <!-- Lekukan Gelombang Putih di Bagian Bawah (Wave Divider) -->
            <div class="absolute bottom-0 left-0 w-full z-20 overflow-hidden leading-none">
                <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg"
                    class="w-full h-14 md:h-24 preserve-3d">
                    <path d="M0,64 C320,140 560,-20 880,64 C1160,136 1320,80 1440,32 L1440,120 L0,120 Z"
                        class="fill-slate-50"></path>
                </svg>
            </div>

        </section>

        <!-- Script Penggerak Slider Otomatis -->
        <script>
            const slides = document.querySelectorAll('.hero-slide');
            const slideTitle = document.getElementById('slide-title');
            const slideDesc = document.getElementById('slide-desc');
            const slideBtn = document.getElementById('slide-btn');
            const slideBtnText = document.getElementById('slide-btn-text');

            const slideContents = <%- JSON.stringify((typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0) ? heroSliders.map(s => ({
                title: s.judul,
                desc: s.deskripsi || '',
                btnText: s.teks_tombol || 'Lihat Selengkapnya',
                btnLink: s.link_tombol || '#profil'
            })) : [
                {
                    title: "Pendidikan Berkualitas",
                    desc: "Pendidikan Berkualitas bermula pada Pendidikan Berkarakter, Visioner, dan Berbudaya. UPT SMPN 1 Rantepao berkomitmen mewujudkan generasi yang Edukatif, Dinamis, dan Optimis.",
                    btnText: "Lihat Selengkapnya",
                    btnLink: "#profil"
                }
            ]) %>;

            let currentSlide = 0;

            function showSlide(index) {
                if (!slides || !slides.length || !slideContents || !slideContents.length) return;
                slides.forEach((slide, i) => {
                    slide.classList.toggle('opacity-100', i === index);
                    slide.classList.toggle('z-10', i === index);
                    slide.classList.toggle('opacity-0', i !== index);
                    slide.classList.toggle('z-0', i !== index);
                });
                if (slideContents[index]) {
                    if (slideTitle) slideTitle.textContent = slideContents[index].title || '';
                    if (slideDesc) slideDesc.textContent = slideContents[index].desc || '';
                    if (slideBtnText) slideBtnText.textContent = slideContents[index].btnText || 'Lihat Selengkapnya';
                    if (slideBtn && slideContents[index].btnLink) slideBtn.setAttribute('href', slideContents[index].btnLink);
                }
            }

            function nextSlide() {
                if (!slides || !slides.length) return;
                currentSlide = (currentSlide + 1) % slides.length;
                showSlide(currentSlide);
            }

            function prevSlide() {
                if (!slides || !slides.length) return;
                currentSlide = (currentSlide - 1 + slides.length) % slides.length;
                showSlide(currentSlide);
            }

            // Geser gambar otomatis setiap 5 detik jika ada lebih dari 1 slide
            if (slides && slides.length > 1) {
                setInterval(nextSlide, 5000);
            }

            // Touch Swipe Support for Android & Mobile Touchscreens
            let touchStartX = 0;
            let touchEndX = 0;
            const heroEl = document.getElementById('beranda');
            if (heroEl) {
                heroEl.addEventListener('touchstart', function(e) {
                    if (e.changedTouches && e.changedTouches[0]) {
                        touchStartX = e.changedTouches[0].screenX;
                    }
                }, { passive: true });

                heroEl.addEventListener('touchend', function(e) {
                    if (e.changedTouches && e.changedTouches[0]) {
                        touchEndX = e.changedTouches[0].screenX;
                        const diff = touchEndX - touchStartX;
                        if (Math.abs(diff) > 40) {
                            if (diff < 0) {
                                nextSlide(); // Geser ke kiri -> slide berikutnya
                            } else {
                                prevSlide(); // Geser ke kanan -> slide sebelumnya
                            }
                        }
                    }
                }, { passive: true });
            }

        </script>

        <!-- PPDB 2026 CALLOUT RIBBON -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-8 relative z-20" data-aos="fade-up">
            <div
                class="rounded-3xl p-6 sm:p-8 bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-400 text-blue-950 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 border border-amber-300">
                <div class="flex items-center gap-4 text-center md:text-left flex-1">
                    <div
                        class="w-14 h-14 rounded-2xl bg-blue-950 text-amber-400 flex items-center justify-center text-2xl font-black shrink-0 shadow">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>
                    <div>
                        <span
                            class="inline-block px-3 py-0.5 rounded-full bg-blue-950 text-white font-black text-[10px] tracking-wider uppercase mb-1">
                            PPDB ONLINE T.A 2026/2027
                        </span>
                        <h3 class="text-lg sm:text-xl font-black leading-snug">
                            Penerimaan Peserta Didik Baru Resmi Dibuka!
                        </h3>
                        <p class="text-xs sm:text-sm text-blue-950/80 font-medium mt-0.5">
                            Tersedia 4 Jalur Seleksi: Zonasi, Afirmasi, Prestasi, dan Perpindahan Tugas Orang Tua. Cek
                            kuota
                            dan daftarkan putra-putri Anda.
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3 shrink-0">
                    <a href="/ppdb"
                        class="px-6 py-3.5 rounded-xl bg-blue-950 hover:bg-blue-900 text-amber-400 font-black text-xs sm:text-sm transition-all shadow-lg hover:scale-105 flex items-center gap-2">
                        <span>Daftar dan Cek Status PPDB</span>
                        <span>→</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- SAMBUTAN KEPALA SEKOLAH (BERADA TEPAT DI ATAS VISI & MISI) -->
        <!-- ============================================================== -->
        <section id="sambutan" class="py-20 bg-white border-y border-slate-200/80 relative overflow-hidden">
            <!-- Subtle background ambient glows -->
            <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-amber-400/10 blur-3xl pointer-events-none">
            </div>
            <div
                class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-blue-600/10 blur-3xl pointer-events-none">
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

                <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">

                    <!-- Foto / Profil Kepala Sekolah (4 Cols) -->
                    <div class="lg:col-span-4" data-aos="fade-right">
                        <div class="relative mx-auto max-w-sm group">

                            <!-- Ambient Dynamic Glow Aura (Soft, Natural, Non-Boxy) -->
                            <div
                                class="absolute -top-6 -left-6 w-60 h-60 bg-gradient-to-br from-amber-400/20 to-blue-600/20 rounded-full blur-3xl pointer-events-none group-hover:scale-110 transition-transform duration-700">
                            </div>
                            <div
                                class="absolute -bottom-6 -right-6 w-60 h-60 bg-gradient-to-tr from-blue-950/25 to-amber-500/15 rounded-full blur-3xl pointer-events-none">
                            </div>

                            <!-- Modern Organic Profile Card (Bersih, Elegan & Memberikan Space Khusus untuk Teks) -->
                            <div
                                class="relative z-10 bg-white rounded-[2.5rem] p-4 sm:p-5 shadow-xl shadow-slate-200/60 border border-slate-200/80 transition-all duration-500 group-hover:shadow-2xl group-hover:border-amber-400/40">

                                <!-- Frame Foto Khusus: Arched Dome Top with Smooth Corners -->
                                <div
                                    class="relative rounded-t-[2.2rem] rounded-b-2xl overflow-hidden bg-gradient-to-b from-blue-950 via-blue-900 to-slate-900 aspect-[4/4.8] shadow-md border-2 border-slate-100">

                                    <!-- Floating Top Pill Badge: Pimpinan Sekolah -->
                                    <div class="absolute top-3.5 inset-x-3 z-10 flex justify-center">
                                        <span
                                            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-950/80 backdrop-blur-md border border-white/20 text-white shadow-md text-[10px] font-black uppercase tracking-wider">
                                            <i class="fa-solid fa-award text-amber-400"></i>
                                            <span>Kepala Satuan Pendidikan</span>
                                        </span>
                                    </div>

                                    <!-- Photo Element -->
                                    <% const fotoAda=profil.foto_kepsek && profil.foto_kepsek !=='kepsek.jpg' ; %>
                                        <% if (fotoAda) { %>
                                            <img src="/uploads/profil/<%= profil.foto_kepsek %>"
                                                alt="<%= profil.nama_kepsek || 'Kepala Sekolah' %>"
                                                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 ease-out"
                                                onerror="this.onerror=null; this.parentElement.querySelector('.fallback-kepsek').classList.remove('hidden'); this.classList.add('hidden');">
                                            <% } %>

                                                <!-- Fallback Silhouette / Graphic if photo not yet uploaded -->
                                                <div
                                                    class="fallback-kepsek <%= fotoAda ? 'hidden' : '' %> w-full h-full flex flex-col items-center justify-center p-6 text-center text-white bg-gradient-to-b from-blue-950 via-blue-900 to-slate-900">
                                                    <div
                                                        class="w-24 h-24 rounded-full bg-gradient-to-tr from-amber-500 to-yellow-300 text-blue-950 flex items-center justify-center text-4xl font-black shadow-xl border-4 border-white/20 mb-3 group-hover:scale-110 transition-transform duration-500">
                                                        <%= profil.nama_kepsek ? profil.nama_kepsek.charAt(0) : 'K' %>
                                                    </div>
                                                    <span class="text-xs font-bold text-amber-300">UPT SMPN 1
                                                        Rantepao</span>
                                                    <span class="text-[10px] text-slate-300 mt-1">Foto pimpinan dapat
                                                        diunggah melalui Panel Admin</span>
                                                </div>
                                </div>

                                <!-- Dedicated Info Section (Memberikan Space Bersih & Terpisah untuk Nama & Identitas) -->
                                <div class="pt-5 pb-2 px-2 text-center">
                                    <span
                                        class="inline-block px-3 py-0.5 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-700 font-extrabold text-[10px] uppercase tracking-wider mb-1.5">
                                        Pimpinan Sekolah
                                    </span>

                                    <h3 class="font-black text-blue-950 text-lg sm:text-xl tracking-tight leading-snug">
                                        <%= profil.nama_kepsek || 'Drs. Kepala Sekolah, M.Pd.' %>
                                    </h3>

                                    <p class="text-xs font-bold text-slate-500 mt-0.5">
                                        Kepala UPT SMPN 1 Rantepao
                                    </p>

                                    <!-- NIP & Location Footer -->
                                    <div
                                        class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                                        <span
                                            class="inline-flex items-center gap-1 font-mono text-[11px] text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-full">
                                            NIP. <%= profil.nip_kepsek || '-' %>
                                        </span>
                                        <span
                                            class="inline-flex items-center gap-1.5 text-[11px] text-amber-600 font-bold uppercase tracking-wider">
                                            <i class="fa-solid fa-location-dot text-amber-500"></i>
                                            <span>Toraja Utara</span>
                                        </span>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Teks Sambutan Lengkap (8 Cols) -->
                    <div class="lg:col-span-8" data-aos="fade-left">
                        <div class="space-y-4">
                            <span
                                class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-50 px-3.5 py-1.5 rounded-full border border-amber-200 inline-block">
                                Sambutan Resmi Pimpinan
                            </span>

                            <h2
                                class="text-2xl sm:text-3xl md:text-4xl font-black text-blue-950 tracking-tight leading-snug">
                                Mewujudkan Pendidikan Bermutu & Generasi Berkarakter Luhur Toraja
                            </h2>

                            <!-- Large decorative quote marks & Sambutan Paragraphs -->
                            <div class="relative pt-2">
                                <span
                                    class="text-amber-500/25 text-7xl font-serif absolute -top-4 -left-3 select-none pointer-events-none">“</span>
                                <p
                                    class="text-slate-700 text-sm sm:text-base leading-relaxed relative z-10 italic font-medium pl-6 border-l-4 border-amber-400 text-justify">
                                    "<%= profil.sambutan_kepsek
                                        || 'Selamat datang di situs resmi UPT SMPN 1 Rantepao. Kami berkomitmen untuk terus berinovasi dalam mewujudkan pendidikan yang bermutu, inklusif, dan berwawasan masa depan bagi seluruh putra-putri bangsa. Mari bersama-sama kita wujudkan generasi cerdas, berprestasi, dan berakhlak mulia.'
                                        %>"
                                </p>
                            </div>

                            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed pt-2 text-justify">
                                Sebagai sekolah rujukan di Kabupaten Toraja Utara, kami terus mengintegrasikan
                                implementasi
                                <strong>Kurikulum Merdeka</strong> dengan pembinaan karakter kebangsaan dan pelestarian
                                nilai-nilai kearifan budaya lokal Toraja. Sinergi antara para pendidik, peserta didik,
                                orang
                                tua, dan masyarakat adalah fondasi utama keberhasilan kita bersama.
                            </p>
                        </div>
                    </div>

                </div>

            </div>
        </section>

        <!-- ============================================================== -->
        <!-- 6. SEJARAH, PROFIL, VISI & MISI SEKOLAH -->
        <!-- ============================================================== -->
        <div id="sejarah" class="scroll-mt-28"></div>
        <div id="visi-misi" class="scroll-mt-28"></div>
        <section id="profil" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-24">
            <div class="text-center max-w-2xl mx-auto mb-12" data-aos="fade-up">
                <span
                    class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-50 px-3.5 py-1.5 rounded-full border border-amber-200">
                    Profil & Landasan Pendidikan
                </span>
                <h2 class="text-3xl sm:text-4xl font-black text-blue-950 mt-3 tracking-tight">
                    Visi & Misi Sekolah
                </h2>
            </div>

            <div class="grid md:grid-cols-2 gap-8 items-stretch">

                <!-- Visi Card (data-aos fade-right) -->
                <div class="bg-white rounded-3xl p-8 sm:p-10 shadow-lg border-2 border-blue-900/10 hover:border-blue-900 hover:shadow-2xl transition-all duration-300 relative overflow-hidden group flex flex-col justify-between"
                    data-aos="fade-right" data-aos-delay="100">
                    <div
                        class="absolute -top-10 -right-10 w-36 h-36 bg-blue-50 rounded-full group-hover:scale-125 transition-transform duration-500">
                    </div>
                    <div class="relative z-10">
                        <div
                            class="w-12 h-12 rounded-2xl bg-blue-900 text-white flex items-center justify-center text-xl font-bold mb-6 shadow-md shadow-blue-900/20">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>
                        <span class="text-xs font-black text-blue-900 uppercase tracking-wider">Cita-Cita Utama</span>
                        <h3 class="text-2xl font-black text-blue-950 mt-1 mb-4">Visi Sekolah</h3>
                        <p class="text-slate-700 text-sm sm:text-base leading-relaxed font-normal font-sans text-left sm:text-justify">
                            "<%= profil.visi
                                || 'Terwujudnya Peserta Didik yang Beriman, Berakhlak Mulia, Cerdas, Terampil, Mandiri, dan Berbudaya Toraja.'
                                %>"
                        </p>
                    </div>
                    <div class="mt-8 pt-4 border-t border-slate-100 flex items-center text-xs font-bold text-blue-900">
                        <span>Berorientasi pada Profil Pelajar Pancasila</span>
                    </div>
                </div>

                <!-- Misi Card (data-aos fade-left) -->
                <div id="program"
                    class="bg-white rounded-3xl p-8 sm:p-10 shadow-lg border-2 border-amber-400/20 hover:border-amber-400 hover:shadow-2xl transition-all duration-300 relative overflow-hidden group flex flex-col justify-between scroll-mt-28"
                    data-aos="fade-left" data-aos-delay="200">
                    <div
                        class="absolute -top-10 -right-10 w-36 h-36 bg-amber-50 rounded-full group-hover:scale-125 transition-transform duration-500">
                    </div>
                    <div class="relative z-10">
                        <div
                            class="w-12 h-12 rounded-2xl bg-amber-500 text-blue-950 flex items-center justify-center text-xl font-bold mb-6 shadow-md shadow-amber-500/20">
                            <i class="fa-solid fa-rocket"></i>
                        </div>
                        <span class="text-xs font-black text-amber-600 uppercase tracking-wider">Langkah
                            Strategis & Program Kerja</span>
                        <h3 class="text-2xl font-black text-blue-950 mt-1 mb-4">Misi & Program Kerja Sekolah</h3>
                        <div
                            class="text-slate-700 text-sm sm:text-base whitespace-pre-line leading-relaxed font-normal font-sans text-left sm:text-justify">
                            <%= profil.misi
                                || '1. Menyelenggarakan proses pembelajaran yang efektif, bermutu, dan inovatif.\n2. Menumbuhkan nilai budi pekerti luhur dan ketaatan beragama.\n3. Mengembangkan potensi bakat akademik dan non-akademik siswa.\n4. Melestarikan budaya daerah Toraja serta peduli lingkungan hidup.'
                                %>
                        </div>
                    </div>
                    <div class="mt-8 pt-4 border-t border-slate-100 flex items-center text-xs font-bold text-amber-600">
                        <span>Terus Bergerak Maju Mencerdaskan Bangsa</span>
                    </div>
                </div>

            </div>
        </section>

        <!-- ============================================================== -->
        <!-- 7. BERITA & PENGUMUMAN TERBARU (AOS BERTINGKAT & MICRO-INTERACTIONS) -->
        <!-- ============================================================== -->
        <section id="berita" class="py-20 bg-slate-100/80 px-4 sm:px-6 lg:px-8 border-y border-slate-200">
            <div class="max-w-7xl mx-auto">

                <div class="grid lg:grid-cols-12 gap-10">

                    <!-- Kolom Berita Utama (8 Cols) -->
                    <div class="lg:col-span-8">
                        <div class="flex items-end justify-between mb-8" data-aos="fade-up">
                            <div>
                                <span
                                    class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-100 px-3 py-1 rounded-full">
                                    Publikasi Terkini
                                </span>
                                <h2 class="text-2xl sm:text-3xl font-black text-blue-950 mt-2">
                                    Berita & Kegiatan Sekolah
                                </h2>
                            </div>
                        </div>

                        <div class="grid sm:grid-cols-2 gap-6">
                            <% if (berita && berita.length> 0) { %>
                                <% berita.forEach((item, index)=> { %>
                                    <div class="bg-white rounded-3xl shadow-md overflow-hidden border border-slate-200/80 flex flex-col justify-between hover:-translate-y-2 hover:shadow-2xl transition-all duration-300 group"
                                        data-aos="fade-up" data-aos-delay="<%= (index % 4) * 100 %>">

                                        <!-- Image Thumbnail -->
                                        <div class="relative aspect-video overflow-hidden bg-slate-900">
                                            <% if (item.gambar && item.gambar !=='default.jpg' && item.gambar !=='' ) {
                                                %>
                                                <img src="/uploads/berita/<%= item.gambar %>" alt="<%= item.judul %>"
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                    loading="lazy">
                                                <% } else { %>
                                                    <div
                                                        class="w-full h-full bg-gradient-to-br from-blue-900 to-slate-900 flex flex-col items-center justify-center p-4 text-center">
                                                        <i
                                                            class="fa-solid fa-newspaper text-3xl mb-1 text-amber-400"></i>
                                                        <span class="text-xs font-bold text-amber-400">
                                                            <%= item.nama_kategori || 'Warta Sekolah' %>
                                                        </span>
                                                    </div>
                                                    <% } %>
                                                        <div class="absolute top-3 left-3">
                                                            <span
                                                                class="text-[10px] font-black px-3 py-1 rounded-full bg-blue-950/80 text-amber-400 backdrop-blur-sm border border-amber-400/30 uppercase tracking-wider">
                                                                <%= item.nama_kategori %>
                                                            </span>
                                                        </div>
                                        </div>

                                        <!-- Content -->
                                        <div class="p-6 flex-1 flex flex-col justify-between">
                                            <div>
                                                <h3
                                                    class="font-extrabold text-base sm:text-lg text-slate-900 line-clamp-2 group-hover:text-blue-900 transition-colors leading-snug">
                                                    <a href="/berita/<%= item.slug %>">
                                                        <%= item.judul %>
                                                    </a>
                                                </h3>
                                                <p class="text-xs text-slate-500 mt-2.5 line-clamp-3 leading-relaxed">
                                                    <%= item.isi_berita %>
                                                </p>
                                            </div>

                                            <div
                                                class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                                                <span class="flex items-center gap-1.5 font-medium">
                                                    <i class="fa-solid fa-calendar-day text-slate-400"></i>
                                                    <span>
                                                        <%= new Date(item.tanggal_publish).toLocaleDateString('id-ID')
                                                            %>
                                                    </span>
                                                </span>
                                                <a href="/berita/<%= item.slug %>"
                                                    class="text-blue-900 hover:text-amber-600 font-bold transition flex items-center gap-1">
                                                    <span>Baca Selengkapnya</span>
                                                    <span>→</span>
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                    <% }) %>
                                        <% } else { %>
                                            <div class="col-span-2 p-8 bg-white rounded-3xl text-center text-slate-500">
                                                Belum ada artikel berita yang dipublikasikan.
                                            </div>
                                            <% } %>
                        </div>
                    </div>

                    <!-- Kolom Pengumuman Resmi & Kalender Akademik (4 Cols) -->
                    <div id="pengumuman" class="lg:col-span-4 scroll-mt-24 space-y-8" data-aos="fade-left">
                        
                        <!-- 1. Bagian Pengumuman Resmi -->
                        <div>
                            <div class="mb-5 flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-black text-rose-600 uppercase tracking-widest bg-rose-50 px-3 py-1 rounded-full">
                                        Pemberitahuan
                                    </span>
                                    <h2 class="text-2xl font-black text-blue-950 mt-1.5">
                                        Pengumuman Resmi
                                    </h2>
                                </div>
                                <span class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xs shadow-sm">
                                    <i class="fa-solid fa-bullhorn"></i>
                                </span>
                            </div>

                            <div class="space-y-3.5">
                                <% if (pengumuman && pengumuman.length > 0) { %>
                                    <% pengumuman.slice(0, 3).forEach((info, idx) => { %>
                                        <div class="bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-slate-200/80 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 border-l-4 border-l-rose-500 group"
                                            data-aos="fade-left" data-aos-delay="<%= (idx % 3) * 100 %>">
                                            <div class="flex items-center justify-between text-[11px] text-slate-400 mb-1.5 font-medium">
                                                <span class="flex items-center gap-1.5 text-rose-600 font-bold">
                                                    <i class="fa-solid fa-thumbtack text-xs"></i>
                                                    <span>Terbit Resmi</span>
                                                </span>
                                                <span class="font-mono text-[10px]">
                                                    <%= new Date(info.tanggal_terbit).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                </span>
                                            </div>
                                            <h4 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-blue-900 transition-colors leading-snug">
                                                <%= info.judul_pengumuman %>
                                            </h4>
                                            <p class="text-xs text-slate-600 mt-1.5 line-clamp-2 leading-relaxed">
                                                <%= info.isi_pengumuman %>
                                            </p>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="p-6 bg-white rounded-2xl text-center text-slate-500 text-xs border border-dashed border-slate-200">
                                        Tidak ada pengumuman terbaru saat ini.
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- 2. Bagian Kalender Akademik & Agenda Sekolah -->
                        <div id="kalender-akademik" class="scroll-mt-24 pt-2">
                            <div class="mb-4 flex items-center justify-between">
                                <div>
                                    <span class="text-[10px] font-black text-amber-600 uppercase tracking-widest bg-amber-50 px-3 py-1 rounded-full">
                                        Agenda Sekolah
                                    </span>
                                    <h3 class="text-xl font-black text-blue-950 mt-1">
                                        Kalender Akademik
                                    </h3>
                                </div>
                                <button type="button" onclick="openAllKalenderModal()" 
                                    class="text-xs font-bold text-blue-900 hover:text-amber-600 flex items-center gap-1 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-xl transition">
                                    <span>Lihat Semua</span>
                                    <i class="fa-solid fa-calendar-week text-[11px]"></i>
                                </button>
                            </div>

                            <!-- List Agenda / Kalender Akademik -->
                            <div class="space-y-3">
                                <% if (typeof kalenderAkademik !== 'undefined' && kalenderAkademik && kalenderAkademik.length > 0) { %>
                                    <% kalenderAkademik.slice(0, 4).forEach((agenda) => { %>
                                        <% 
                                            const dMulai = new Date(agenda.tanggal_mulai);
                                            const dSelesai = agenda.tanggal_selesai ? new Date(agenda.tanggal_selesai) : null;
                                            const tglStr = dMulai.getDate();
                                            const blnStr = dMulai.toLocaleDateString('id-ID', { month: 'short' });
                                            
                                            let badgeBg = 'bg-blue-50 text-blue-800 border-blue-200';
                                            let dateBg = 'bg-blue-950 text-white';
                                            if (agenda.warna_badge === 'rose') {
                                                badgeBg = 'bg-rose-50 text-rose-800 border-rose-200';
                                                dateBg = 'bg-rose-700 text-white';
                                            } else if (agenda.warna_badge === 'emerald') {
                                                badgeBg = 'bg-emerald-50 text-emerald-800 border-emerald-200';
                                                dateBg = 'bg-emerald-700 text-white';
                                            } else if (agenda.warna_badge === 'amber') {
                                                badgeBg = 'bg-amber-50 text-amber-900 border-amber-200';
                                                dateBg = 'bg-amber-600 text-white';
                                            } else if (agenda.warna_badge === 'purple') {
                                                badgeBg = 'bg-purple-50 text-purple-800 border-purple-200';
                                                dateBg = 'bg-purple-700 text-white';
                                            }
                                        %>
                                        <div class="bg-white p-3.5 sm:p-4 rounded-2xl shadow-sm border border-slate-200/80 hover:shadow-md transition flex items-start gap-3.5 group">
                                            <!-- Date Badge (Day + Month) -->
                                            <div class="<%= dateBg %> w-12 sm:w-14 rounded-xl py-2 px-1 text-center shrink-0 shadow-sm flex flex-col justify-center items-center">
                                                <span class="text-[10px] uppercase font-bold tracking-wider leading-none opacity-90"><%= blnStr %></span>
                                                <span class="text-base sm:text-lg font-black leading-tight mt-0.5"><%= tglStr %></span>
                                            </div>

                                            <!-- Agenda Detail -->
                                            <div class="flex-1 min-w-0">
                                                <div class="flex items-center gap-2 mb-1">
                                                    <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-md border <%= badgeBg %>">
                                                        <%= agenda.kategori %>
                                                    </span>
                                                    <span class="text-[10px] text-slate-400 font-medium truncate">
                                                        <% if (dSelesai && dSelesai.getTime() !== dMulai.getTime()) { %>
                                                            <%= dMulai.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %> - <%= dSelesai.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                        <% } else { %>
                                                            <%= dMulai.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                        <% } %>
                                                    </span>
                                                </div>
                                                <h4 class="font-black text-xs sm:text-sm text-slate-900 group-hover:text-blue-900 transition-colors line-clamp-1 leading-snug">
                                                    <%= agenda.judul_kegiatan %>
                                                </h4>
                                                <% if (agenda.deskripsi) { %>
                                                    <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">
                                                        <%= agenda.deskripsi %>
                                                    </p>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="p-5 bg-white rounded-2xl text-center text-slate-400 text-xs border border-dashed border-slate-200">
                                        Belum ada agenda akademik yang dijadwalkan.
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div>

                </div>

            </div>
        </section>

        <!-- ============================================================== -->
        <!-- DIREKTORI GURU & PEGAWAI (CENTER-FOCUS CAROUSEL / SLIDER) -->
        <!-- ============================================================== -->
        <style>
            /* Center-Focus Carousel Styles */
            .guru-center-slider .swiper-slide {
                transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    filter 0.5s cubic-bezier(0.4, 0, 0.2, 1);
                transform: scale(0.90);
                opacity: 0.50;
                filter: blur(2px);
            }

            .guru-center-slider .swiper-slide-active {
                transform: scale(1.05);
                opacity: 1;
                filter: blur(0);
                z-index: 20;
            }

            .guru-center-slider .swiper-slide-active .guru-card-inner {
                box-shadow: 0 25px 50px -12px rgba(11, 19, 43, 0.25);
                border-color: rgba(245, 158, 11, 0.7);
            }
        </style>

        <!-- Anchor Civitas & Seksi Guru & Pegawai -->
        <div id="civitas" class="scroll-mt-28"></div>
        <section id="guru" class="py-20 bg-slate-50 border-t border-slate-200 overflow-hidden scroll-mt-28">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

                <!-- Header: Kiri Atas (Badge CIVITAS & Judul Guru & Pegawai), Kanan Atas (Link Lihat Semua →) -->
                <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4" data-aos="fade-up">
                    <div>
                        <span
                            class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-100/80 px-3.5 py-1.5 rounded-full border border-amber-200">
                            CIVITAS
                        </span>
                        <h2 class="text-3xl sm:text-4xl font-black text-blue-950 mt-3 tracking-tight">
                            Guru & Pegawai
                        </h2>
                        <p class="text-xs sm:text-sm text-slate-500 mt-2">
                            Pendidik dan staf profesional pembimbing tunas bangsa di <%= profil.nama_sekolah
                                || 'SMPN 1 Rantepao' %>.
                        </p>
                    </div>
                </div>

                <!-- Slider Wrapper with Side Navigation Arrows -->
                <div class="relative px-2 sm:px-12 py-4" data-aos="zoom-in">
                    <!-- Tombol Navigasi Panah Kiri (<) -->
                    <button type="button" id="guru-prev-btn"
                        class="absolute left-0 sm:left-1 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white hover:bg-blue-950 text-blue-950 hover:text-white shadow-xl border border-slate-200 flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
                        aria-label="Guru Sebelumnya">
                        <i class="fa-solid fa-chevron-left text-sm"></i>
                    </button>

                    <!-- Tombol Navigasi Panah Kanan (>) -->
                    <button type="button" id="guru-next-btn"
                        class="absolute right-0 sm:right-1 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white hover:bg-blue-950 text-blue-950 hover:text-white shadow-xl border border-slate-200 flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none"
                        aria-label="Guru Selanjutnya">
                        <i class="fa-solid fa-chevron-right text-sm"></i>
                    </button>

                    <!-- Swiper Slider Container -->
                    <div class="swiper guru-center-slider overflow-visible">
                        <div class="swiper-wrapper py-6">
                            <% if (guru && guru.length> 0) { %>
                                <% // Jika data guru kurang dari 6, duplikasi array agar Swiper loop berjalan mulus
                                    const guruItems=(guru.length < 6) ? [...guru, ...guru] : guru; %>
                                    <% guruItems.forEach((g)=> { %>
                                        <div class="swiper-slide select-none cursor-pointer">
                                            <div
                                                class="guru-card-inner bg-white rounded-3xl p-7 border border-slate-200/90 text-center flex flex-col items-center justify-between transition-all duration-500 shadow-sm">
                                                <div class="flex flex-col items-center w-full">
                                                    <!-- Teacher Photo with Ring -->
                                                    <div
                                                        class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden mb-4 border-4 border-amber-500 shadow-md flex items-center justify-center bg-blue-950 text-amber-400 font-black text-2xl flex-shrink-0">
                                                        <% if (g.foto && !g.foto.startsWith('default') && g.foto !=='' )
                                                            { %>
                                                            <img src="/uploads/guru/<%= g.foto %>"
                                                                alt="<%= g.nama_lengkap %>"
                                                                class="w-full h-full object-cover"
                                                                onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(g.nama_lengkap) %>&background=0b132b&color=f59e0b&size=150';">
                                                            <% } else { %>
                                                                <span>
                                                                    <%= g.nama_lengkap.charAt(0) %>
                                                                </span>
                                                                <% } %>
                                                    </div>

                                                    <span
                                                        class="text-[10px] font-black px-3 py-0.5 rounded-full bg-blue-50 text-blue-900 border border-blue-200 uppercase mb-2 inline-block">
                                                        <%= g.kategori_pegawai || 'Tenaga Pendidik' %>
                                                    </span>

                                                    <h3
                                                        class="font-extrabold text-slate-900 text-sm sm:text-base leading-snug line-clamp-2">
                                                        <%= g.nama_lengkap %>
                                                    </h3>

                                                    <p
                                                        class="text-xs sm:text-sm font-bold text-amber-600 mt-1 leading-snug">
                                                        <%= g.jabatan %>
                                                    </p>
                                                </div>

                                                <div class="w-full pt-3 mt-4 border-t border-slate-100 font-mono">
                                                    <p class="text-[11px] text-slate-400 font-medium">
                                                        NIP. <%= g.nip || '-' %>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Tombol Kapsul Berbingkai di Bawah Slider -->
                <div class="mt-8 text-center" data-aos="fade-up">
                    <a href="/civitas"
                        class="inline-flex items-center gap-3 rounded-full border-2 border-blue-900 hover:bg-blue-900 text-blue-900 hover:text-white font-extrabold text-xs sm:text-sm px-8 py-3.5 transition-all duration-300 shadow-sm hover:shadow-xl hover:scale-105 group">
                        <i class="fa-solid fa-users text-amber-500 group-hover:text-amber-400 text-base"></i>
                        <span>Lihat Seluruh Civitas Akademik (<%= (typeof guru !=='undefined' && guru) ? guru.length : 0
                                %> Pegawai)</span>
                        <span
                            class="group-hover:translate-x-1.5 transition-transform duration-300 text-amber-500 group-hover:text-amber-400 text-base">→</span>
                    </a>
                </div>

            </div>
        </section>

        <!-- ============================================================== -->
        <!-- STRUKTUR KOMITE SEKOLAH (INTERACTIVE ROYAL-NAVY & GOLD CAROUSEL) -->
        <!-- ============================================================== -->
        <style>
            /* Komite Center-Focus Carousel Styles (Royal Navy & Gold Theme) */
            .komite-center-slider .swiper-slide {
                transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1),
                    filter 0.5s cubic-bezier(0.4, 0, 0.2, 1);
                transform: scale(0.90);
                opacity: 0.50;
                filter: blur(1.5px);
            }

            .komite-center-slider .swiper-slide-active {
                transform: scale(1.05);
                opacity: 1;
                filter: blur(0);
                z-index: 20;
            }

            /* Inactive Card Styling (Translucent Royal Blue Glass) */
            .komite-slider-card {
                background: rgba(255, 255, 255, 0.10);
                border: 1px solid rgba(255, 255, 255, 0.18);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            }

            /* Active Centered Card Styling (Gleaming Prestige White Card) */
            .komite-center-slider .swiper-slide-active .komite-slider-card {
                background: #ffffff;
                border: 2px solid #f59e0b;
                box-shadow: 0 25px 50px -12px rgba(11, 19, 43, 0.45), 0 0 30px -5px rgba(245, 158, 11, 0.35);
            }

            /* Dynamic Text & Elements on Slide Active */
            .komite-slider-card .komite-nama {
                color: rgba(255, 255, 255, 0.90);
                transition: color 0.4s ease;
            }

            .komite-center-slider .swiper-slide-active .komite-slider-card .komite-nama {
                color: #0b132b;
            }

            .komite-slider-card .komite-unsur-box {
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                color: #e2e8f0;
                transition: all 0.4s ease;
            }

            .komite-center-slider .swiper-slide-active .komite-slider-card .komite-unsur-box {
                background: #f8fafc;
                border: 1px solid #e2e8f0;
                color: #334155;
            }

            .komite-slider-card .komite-footer {
                border-top: 1px solid rgba(255, 255, 255, 0.15);
                color: #fcd34d;
                transition: all 0.4s ease;
            }

            .komite-center-slider .swiper-slide-active .komite-slider-card .komite-footer {
                border-top: 1px solid #f1f5f9;
                color: #d97706;
            }

            /* Gold Pagination Dots */
            .komite-bullet {
                width: 10px;
                height: 10px;
                display: inline-block;
                border-radius: 9999px;
                background: rgba(255, 255, 255, 0.35);
                transition: all 0.35s ease;
                cursor: pointer;
            }

            .komite-bullet-active {
                width: 28px;
                background: linear-gradient(to right, #f59e0b, #fbbf24);
                box-shadow: 0 0 12px rgba(245, 158, 11, 0.8);
            }
        </style>

        <section id="komite"
            class="py-20 bg-gradient-to-br from-blue-950 via-blue-900 to-slate-900 text-white relative overflow-hidden border-t border-blue-800/50 scroll-mt-24">
            <!-- Glow Light Effect Background (Gold & Blue) -->
            <div class="absolute -top-32 -right-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none">
            </div>
            <div
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[36rem] h-[36rem] bg-amber-500/5 rounded-full blur-[140px] pointer-events-none">
            </div>
            <div
                class="absolute -bottom-32 -left-32 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none">
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="text-center max-w-2xl mx-auto mb-12" data-aos="fade-up">
                    <span
                        class="text-xs font-black text-amber-400 uppercase tracking-widest bg-amber-400/10 px-3.5 py-1.5 rounded-full border border-amber-400/30 inline-flex items-center gap-1.5 shadow-xs">
                        <i class="fa-solid fa-users-gear text-amber-400"></i> Mitra Strategis Sekolah
                    </span>
                    <h2 class="text-3xl sm:text-4xl font-black text-white mt-3 tracking-tight">
                        Struktur Komite Sekolah
                    </h2>
                    <p class="text-xs sm:text-sm text-slate-300 mt-2">
                        Wadah kemitraan sinergis antara masyarakat, orang tua peserta didik, dan sekolah dalam
                        mewujudkan keunggulan mutu pendidikan di <%= profil.nama_sekolah || 'SMPN 1 Rantepao' %>.
                    </p>
                </div>

                <% if (typeof komite !=='undefined' && komite.length> 0) { %>
                    <!-- Slider Wrapper with Side Navigation Arrows -->
                    <div class="relative px-2 sm:px-12 py-4" data-aos="zoom-in">
                        <!-- Tombol Navigasi Panah Kiri (<) -->
                        <button type="button" id="komite-prev-btn"
                            class="absolute left-0 sm:left-1 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/15 hover:bg-amber-500 text-white hover:text-blue-950 shadow-xl border border-white/25 flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none backdrop-blur-md"
                            aria-label="Komite Sebelumnya">
                            <i class="fa-solid fa-chevron-left text-sm"></i>
                        </button>

                        <!-- Tombol Navigasi Panah Kanan (>) -->
                        <button type="button" id="komite-next-btn"
                            class="absolute right-0 sm:right-1 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/15 hover:bg-amber-500 text-white hover:text-blue-950 shadow-xl border border-white/25 flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 focus:outline-none backdrop-blur-md"
                            aria-label="Komite Selanjutnya">
                            <i class="fa-solid fa-chevron-right text-sm"></i>
                        </button>

                        <!-- Swiper Slider Container -->
                        <div class="swiper komite-center-slider overflow-visible">
                            <div class="swiper-wrapper py-6">
                                <% // Duplikasi data komite jika < 6 agar Swiper infinite loop berjalan mulus const
                                    komiteItems=(komite.length < 6) ? [...komite, ...komite] : komite; %>
                                    <% komiteItems.forEach((k)=> { %>
                                        <div class="swiper-slide select-none cursor-pointer">
                                            <div
                                                class="komite-slider-card rounded-3xl p-6 sm:p-7 text-center flex flex-col items-center justify-between shadow-xl">

                                                <div class="flex flex-col items-center w-full">
                                                    <!-- Avatar Lingkaran Berbingkai Cincin Emas Ganda dengan Badge Jabatan Menempel -->
                                                    <div class="relative mb-5 flex flex-col items-center">
                                                        <!-- Cincin Ganda: Outer Border 2 + Inner Border 2 -->
                                                        <div
                                                            class="p-1 rounded-full border-2 border-amber-400 shadow-md shadow-amber-500/20 bg-gradient-to-tr from-amber-500/30 to-yellow-300/20">
                                                            <div
                                                                class="w-24 h-24 sm:w-28 sm:h-28 rounded-full overflow-hidden border-2 border-amber-300/90 bg-blue-950 flex items-center justify-center shadow-inner">
                                                                <% if (k.foto && !k.foto.startsWith('default') && k.foto
                                                                    !=='' ) { %>
                                                                    <img src="/uploads/komite/<%= k.foto %>"
                                                                        alt="<%= k.nama_lengkap %>"
                                                                        class="w-full h-full object-cover"
                                                                        onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(k.nama_lengkap) %>&background=0b132b&color=f59e0b&size=150';">
                                                                    <% } else { %>
                                                                        <div
                                                                            class="flex flex-col items-center justify-center">
                                                                            <i
                                                                                class="fa-solid fa-user-tie text-3xl mb-1 text-amber-400/90"></i>
                                                                            <span
                                                                                class="text-[9px] font-bold uppercase tracking-wider text-amber-300">
                                                                                <%= k.nama_lengkap.split(' ')[0] %>
                                                                            </span>
                                                                        </div>
                                                                    <% } %>
                                                            </div>
                                                        </div>

                                                        <!-- Badge Jabatan Emas Menempel di Bawah Lingkaran Foto -->
                                                        <div class="absolute -bottom-2.5 left-1/2 -translate-x-1/2 z-10 whitespace-nowrap">
                                                            <span class="bg-gradient-to-r from-amber-500 via-amber-400 to-yellow-300 text-blue-950 font-extrabold text-[11px] uppercase px-4 py-1 rounded-full shadow-lg shadow-amber-500/30 border border-white/40 flex items-center gap-1.5">
                                                                <i class="fa-solid fa-award text-[10px]"></i>
                                                                <span><%= k.jabatan %></span>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <!-- Nama Lengkap (Dynamic Color) -->
                                                    <h3 class="komite-nama font-bold text-lg mt-3 line-clamp-2 leading-snug">
                                                        <%= k.nama_lengkap %>
                                                    </h3>

                                                    <!-- Kotak Tipis Transparan Unsur / Pekerjaan (Dynamic) -->
                                                    <div class="komite-unsur-box w-full rounded-xl p-3 mt-3 text-xs text-center leading-relaxed backdrop-blur-xs">
                                                        <p class="flex items-center justify-center gap-1.5 font-medium">
                                                            <i class="fa-solid fa-user-tag text-amber-400 text-[11px] shrink-0"></i>
                                                            <span><%= k.pekerjaan_atau_unsur %></span>
                                                        </p>
                                                    </div>
                                                </div>

                                                <!-- Footer Masa Bakti (Dynamic) -->
                                                <div class="komite-footer w-full pt-3.5 mt-4 flex items-center justify-center text-xs font-semibold gap-1.5">
                                                    <i class="fa-regular fa-calendar-check text-xs"></i>
                                                    <span>Masa Bakti: <%= k.periode %></span>
                                                </div>

                                            </div>
                                        </div>
                                    <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Indikator Slide (Dots) di Bawah Slider Komite -->
                    <div id="komite-pagination" class="flex justify-center items-center gap-2 mt-8 z-20 relative"></div>

                    <!-- Tombol Navigasi Kapsul Aksen Emas ke Halaman /komite -->
                    <div class="mt-8 text-center" data-aos="fade-up">
                        <a href="/komite"
                            class="inline-flex items-center gap-3 rounded-full border-2 border-amber-400/80 bg-amber-400/15 hover:bg-amber-400 text-amber-300 hover:text-blue-950 font-extrabold text-xs sm:text-sm px-8 py-3.5 transition-all duration-300 shadow-lg shadow-amber-500/10 hover:shadow-amber-500/30 hover:scale-105 group backdrop-blur-md">
                            <i class="fa-solid fa-handshake text-amber-400 group-hover:text-blue-950 text-base transition-colors"></i>
                            <span>Lihat Seluruh Pengurus Komite Sekolah</span>
                            <span class="group-hover:translate-x-1.5 transition-transform duration-300 text-amber-400 group-hover:text-blue-950 text-base">→</span>
                        </a>
                    </div>

                <% } else { %>
                    <div class="text-center py-12 text-slate-300 text-xs bg-white/10 rounded-3xl border border-white/20 max-w-xl mx-auto backdrop-blur-md">
                        <i class="fa-solid fa-users-slash text-3xl text-amber-400 mb-2"></i>
                        <p>Belum ada data struktur Komite Sekolah yang ditampilkan.</p>
                    </div>
                <% } %>
            </div>
        </section>

    <!-- ============================================================== -->
    <!-- EKSTRAKURIKULER SISWA -->
    <!-- ============================================================== -->
    <section id="eskul" class="py-20 bg-slate-50 px-4 sm:px-6 lg:px-8 border-t border-slate-200">
        <div class="max-w-7xl mx-auto">

            <div class="text-center max-w-2xl mx-auto mb-14" data-aos="fade-up">
                <span
                    class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-50 px-3.5 py-1.5 rounded-full border border-amber-200">
                    Bakat & Minat Siswa
                </span>
                <h2 class="text-3xl sm:text-4xl font-black text-blue-950 mt-3 tracking-tight">
                    Ekstrakurikuler Sekolah
                </h2>
                <p class="text-xs sm:text-sm text-slate-500 mt-2">
                    Wadah pembinaan karakter, kreativitas, kepanduan, dan pelestarian budaya khas Toraja bagi seluruh
                    siswa.
                </p>
            </div>

            <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 sm:gap-8">
                <% if (eskul && eskul.length> 0) { %>
                    <% eskul.forEach((e, index)=> { %>
                        <div class="bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col group"
                            data-aos="fade-up" data-aos-delay="<%= (index % 3) * 100 %>">

                            <div class="relative aspect-video overflow-hidden bg-blue-950">
                                <% if (e.foto_eskul && e.foto_eskul !==' default-eskul.jpg' && e.foto_eskul !=='' ) {
                                                                                    %>
                                                                                    <img src="/uploads/eskul/<%= e.foto_eskul %>"
                                                                                        alt="<%= e.nama_eskul %>"
                                                                                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                                                                    <% } else { %>
                                                                                        <div
                                                                                            class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-900 to-slate-900 text-amber-400 text-3xl font-black">
                                                                                            <i
                                                                                                class="fa-solid fa-medal"></i>
                                                                                        </div>
                                                                                        <% } %>
                                                                                            <div
                                                                                                class="absolute top-3 left-3">
                                                                                                <span
                                                                                                    class="text-[11px] font-bold px-3 py-1 rounded-full bg-blue-950/80 text-amber-400 backdrop-blur-sm border border-amber-400/30 flex items-center gap-1.5">
                                                                                                    <i
                                                                                                        class="fa-solid fa-clock text-amber-300"></i>
                                                                                                    <span>
                                                                                                        <%= e.jadwal_latihan
                                                                                                            %>
                                                                                                    </span>
                                                                                                </span>
                                                                                            </div>
                                                                        </div>

                                                                        <div
                                                                            class="p-6 flex-1 flex flex-col justify-between">
                                                                            <div>
                                                                                <h3
                                                                                    class="font-black text-lg text-blue-950 group-hover:text-amber-600 transition-colors">
                                                                                    <%= e.nama_eskul %>
                                                                                </h3>
                                                                                <p
                                                                                    class="text-xs text-slate-500 font-medium mt-1 flex items-center gap-1.5">
                                                                                    <i
                                                                                        class="fa-solid fa-user-tie text-slate-400"></i>
                                                                                    <span>Pembina: <strong
                                                                                            class="text-slate-700">
                                                                                            <%= e.pembina %>
                                                                                        </strong></span>
                                                                                </p>
                                                                                <p
                                                                                    class="text-xs text-slate-600 mt-3 leading-relaxed">
                                                                                    <%= e.deskripsi %>
                                                                                </p>
                                                                            </div>
                                                                            <div
                                                                                class="pt-4 mt-4 border-t border-slate-100 flex items-center text-xs text-blue-900 font-bold">
                                                                                <span>Kegiatan Aktif Mingguan</span>
                                                                            </div>
                                                                        </div>

                                                            </div>
                                                            <% }) %>
                                                                <% } %>
                                                        </div>

                                                    </div>
        </section>

        <!-- ============================================================== -->
        <!-- PREVIEW GALERI KEGIATAN & FASILITAS / SARANA PRASARANA -->
        <!-- ============================================================== -->
        <div id="sarana" class="scroll-mt-28"></div>
        <% const listGaleri=(typeof galeri !=='undefined' && Array.isArray(galeri) && galeri.length> 0) ? galeri :
            ((typeof galeriPreview !== 'undefined' && Array.isArray(galeriPreview)) ? galeriPreview : []); %>
            <% if (listGaleri && listGaleri.length> 0) { %>
                <section id="galeri" class="py-20 bg-white px-4 sm:px-6 lg:px-8 border-t border-slate-200 scroll-mt-28">
                    <div class="max-w-7xl mx-auto">
                        <div class="text-center max-w-2xl mx-auto mb-10" data-aos="fade-up">
                            <span
                                class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-50 px-3.5 py-1.5 rounded-full border border-amber-200">
                                Sarana, Fasilitas & Dokumentasi
                            </span>
                            <h2 class="text-3xl sm:text-4xl font-black text-blue-950 mt-3 tracking-tight">
                                Sarana Prasarana & Galeri Fasilitas
                            </h2>
                            <p class="text-xs sm:text-sm text-slate-500 mt-2">
                                Fasilitas unggulan, sarana prasarana penunjang pembelajaran, dan ragam dokumentasi di
                                lingkungan <%= profil.nama_sekolah || 'SMPN 1 Rantepao' %>.
                            </p>
                        </div>

                        <!-- 1. Interactive Category Filter Tabs (Beranda) -->
                        <div data-aos="fade-up" class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10">
                            <button type="button" onclick="filterHomeGaleri('Semua', this)"
                                class="home-galeri-filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-2xl text-xs font-bold transition-all duration-300 flex items-center gap-2 bg-blue-950 text-white shadow-md shadow-blue-950/20 active-tab">
                                <span>Semua Foto</span>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-500 text-blue-950">
                                    <%= listGaleri.length %>
                                </span>
                            </button>
                            <button type="button" onclick="filterHomeGaleri('Kegiatan', this)"
                                class="home-galeri-filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-2xl text-xs font-bold transition-all duration-300 flex items-center gap-2 bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                                <i class="fa-solid fa-camera text-blue-600 text-xs"></i>
                                <span>Kegiatan Sekolah</span>
                            </button>
                            <button type="button" onclick="filterHomeGaleri('Fasilitas', this)"
                                class="home-galeri-filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-2xl text-xs font-bold transition-all duration-300 flex items-center gap-2 bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                                <i class="fa-solid fa-building-columns text-emerald-600 text-xs"></i>
                                <span>Sarana & Fasilitas</span>
                            </button>
                            <button type="button" onclick="filterHomeGaleri('Prestasi', this)"
                                class="home-galeri-filter-btn px-4 sm:px-5 py-2 sm:py-2.5 rounded-2xl text-xs font-bold transition-all duration-300 flex items-center gap-2 bg-white text-slate-600 hover:bg-slate-100 border border-slate-200">
                                <i class="fa-solid fa-trophy text-amber-500 text-xs"></i>
                                <span>Prestasi Siswa</span>
                            </button>
                        </div>

                        <!-- 2. Gallery Cards Grid with Lightbox Preview -->
                        <div id="home-galeri-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
                            <% listGaleri.forEach((foto, idx)=> { %>
                                <div class="home-galeri-item group bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-md hover:shadow-2xl hover:-translate-y-2 transition-all duration-300 flex flex-col cursor-pointer"
                                    data-category="<%= foto.kategori_galeri %>"
                                    data-src="/uploads/galeri/<%= foto.file_foto %>"
                                    data-judul="<%= foto.judul_foto %>"
                                    data-deskripsi="<%= foto.deskripsi_singkat || '' %>"
                                    data-tgl="<%= new Date(foto.tanggal_upload).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>"
                                    data-kategori="<%= foto.kategori_galeri %>"
                                    data-aos="zoom-in" data-aos-delay="<%= (idx % 3) * 100 %>">

                                    <div class="relative aspect-[4/3] overflow-hidden bg-blue-950">
                                        <img src="/uploads/galeri/<%= foto.file_foto %>" alt="<%= foto.judul_foto %>"
                                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
                                            loading="lazy"
                                            onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=800&q=80';">

                                        <!-- Hover Overlay with Magnifying Glass -->
