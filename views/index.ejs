                        <!-- ============================================================== -->
                        <!-- INDEX SCRIPTS (PRELOADER, COUNTER UP, KONTAK ALERT) -->
                        <!-- ============================================================== -->
                        <script>
                            // 1. Preloader Fade-out Handler
                            function hidePreloader() {
                                const preloader = document.getElementById('preloader');
                                if (preloader && preloader.style.display !== 'none') {
                                    preloader.style.opacity = '0';
                                    preloader.style.pointerEvents = 'none';
                                    setTimeout(() => {
                                        preloader.style.display = 'none';
                                    }, 700);
                                }
                            }
                            window.addEventListener('load', hidePreloader);
                            // Fallback: sembunyikan maksimal setelah 2.5 detik
                            setTimeout(hidePreloader, 2500);

                            // 2. Pesan Kontak Terkirim URL Query Handler
                            if (window.location.search.includes('pesan_terkirim=1')) {
                                const alertBox = document.getElementById('kontak-sukses-alert');
                                if (alertBox) alertBox.classList.remove('hidden');
                            }

                            // 4. Inisialisasi Center-Focus Carousel Guru & Pegawai
                            if (typeof Swiper !== 'undefined' && document.querySelector('.guru-center-slider')) {
                                const swiperGuru = new Swiper('.guru-center-slider', {
                                    slidesPerView: 1.2,
                                    spaceBetween: 16,
                                    centeredSlides: true,
                                    loop: true,
                                    slideToClickedSlide: true,
                                    grabCursor: true,
                                    autoplay: {
                                        delay: 3500,
                                        disableOnInteraction: false,
                                        pauseOnMouseEnter: true
                                    },
                                    navigation: {
                                        nextEl: '#guru-next-btn',
                                        prevEl: '#guru-prev-btn',
                                    },
                                    breakpoints: {
                                        640: {
                                            slidesPerView: 2.2,
                                            spaceBetween: 24,
                                        },
                                        1024: {
                                            slidesPerView: 3.2,
                                            spaceBetween: 32,
                                        },
                                        1280: {
                                            slidesPerView: 3.6,
                                            spaceBetween: 36,
                                        }
                                    }
                                });
                            }

                            // 5. Inisialisasi Center-Focus Carousel Komite Sekolah (Dark-Gold)
                            if (typeof Swiper !== 'undefined' && document.querySelector('.komite-center-slider')) {
                                const komiteCount = parseInt('<%= (typeof komite !== "undefined" && komite) ? komite.length : 0 %>', 10) || 0;
                                const swiperKomite = new Swiper('.komite-center-slider', {
                                    slidesPerView: 1.15,
                                    spaceBetween: 16,
                                    centeredSlides: true,
                                    loop: true,
                                    slideToClickedSlide: true,
                                    grabCursor: true,
                                    autoplay: {
                                        delay: 4000,
                                        disableOnInteraction: false,
                                        pauseOnMouseEnter: true
                                    },
                                    navigation: {
                                        nextEl: '#komite-next-btn',
                                        prevEl: '#komite-prev-btn',
                                    },
                                    pagination: {
                                        el: '#komite-pagination',
                                        clickable: true,
                                        bulletClass: 'komite-bullet',
                                        bulletActiveClass: 'komite-bullet-active',
                                        renderBullet: function (index, className) {
                                            if (index >= komiteCount) return '';
                                            return '<span class="' + className + '"></span>';
                                        }
                                    },
                                    breakpoints: {
                                        640: {
                                            slidesPerView: 1.8,
                                            spaceBetween: 24,
                                        },
                                        1024: {
                                            slidesPerView: 2.8,
                                            spaceBetween: 32,
                                        },
                                        1280: {
                                            slidesPerView: 3.2,
                                            spaceBetween: 36,
                                        }
                                    }
                                });
                            }

                            // ==========================================
                            // 6. Interactive Category Filter & Lightbox untuk Galeri di Beranda
                            // ==========================================
                            function filterHomeGaleri(kategori, btnEl) {
                                document.querySelectorAll('.home-galeri-filter-btn').forEach(btn => {
                                    btn.classList.remove('bg-blue-950', 'text-white', 'shadow-md', 'shadow-blue-950/20', 'active-tab');
                                    btn.classList.add('bg-white', 'text-slate-600', 'hover:bg-slate-100', 'border', 'border-slate-200');
                                });
                                if (btnEl) {
                                    btnEl.classList.remove('bg-white', 'text-slate-600', 'hover:bg-slate-100', 'border', 'border-slate-200');
                                    btnEl.classList.add('bg-blue-950', 'text-white', 'shadow-md', 'shadow-blue-950/20', 'active-tab');
                                }

                                const items = document.querySelectorAll('.home-galeri-item');
                                let visibleCount = 0;

                                items.forEach(item => {
                                    const itemCat = item.getAttribute('data-category');
                                    if (kategori === 'Semua' || itemCat === kategori) {
                                        item.classList.remove('hidden');
                                        visibleCount++;
                                    } else {
                                        item.classList.add('hidden');
                                    }
                                });

                                const emptyEl = document.getElementById('home-galeri-empty');
                                if (emptyEl) {
                                    if (visibleCount === 0) {
                                        emptyEl.classList.remove('hidden');
                                    } else {
                                        emptyEl.classList.add('hidden');
                                    }
                                }
                            }

                            // Lightbox modal logic for Home Gallery
                            document.addEventListener('DOMContentLoaded', () => {
                                const lightbox = document.getElementById('home-lightbox-modal');
                                if (!lightbox) return;

                                const lbImg = document.getElementById('home-lb-img');
                                const lbJudul = document.getElementById('home-lb-judul');
                                const lbDeskripsi = document.getElementById('home-lb-deskripsi');
                                const lbTgl = document.getElementById('home-lb-tgl');
                                const lbBadge = document.getElementById('home-lb-badge');
                                const closeBtn = document.getElementById('home-lb-close-btn');
                                const prevBtn = document.getElementById('home-lb-prev-btn');
                                const nextBtn = document.getElementById('home-lb-next-btn');

                                let currentItems = [];
                                let currentIndex = 0;

                                function updateLightboxContent(index) {
                                    if (index < 0 || index >= currentItems.length) return;
                                    currentIndex = index;
                                    const item = currentItems[index];

                                    const src = item.getAttribute('data-src');
                                    const judul = item.getAttribute('data-judul');
                                    const deskripsi = item.getAttribute('data-deskripsi');
                                    const tgl = item.getAttribute('data-tgl');
                                    const kategori = item.getAttribute('data-kategori');

                                    lbImg.src = src;
                                    lbJudul.textContent = judul;
                                    lbDeskripsi.textContent = deskripsi || 'Dokumentasi kegiatan dan sarana UPT SMP Negeri 1 Rantepao.';
                                    lbTgl.textContent = tgl;
                                    lbBadge.textContent = kategori;

                                    if (kategori === 'Prestasi') {
                                        lbBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500 text-blue-950 shadow-sm';
                                    } else if (kategori === 'Fasilitas') {
                                        lbBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-600 text-white shadow-sm';
                                    } else {
                                        lbBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-blue-600 text-white shadow-sm';
                                    }
                                }

                                // Click listener on gallery cards
                                document.querySelectorAll('.home-galeri-item').forEach(card => {
                                    card.addEventListener('click', () => {
                                        currentItems = Array.from(document.querySelectorAll('.home-galeri-item:not(.hidden)'));
                                        const idx = currentItems.indexOf(card);
                                        if (idx !== -1) {
                                            updateLightboxContent(idx);
                                            lightbox.classList.remove('hidden');
                                            document.body.style.overflow = 'hidden';
                                        }
                                    });
                                });

                                function closeLightbox() {
                                    lightbox.classList.add('hidden');
                                    lbImg.src = '';
                                    document.body.style.overflow = '';
                                }

                                if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
                                if (prevBtn) prevBtn.addEventListener('click', (e) => {
                                    e.stopPropagation();
                                    if (currentItems.length > 0) {
                                        const prevIdx = (currentIndex - 1 + currentItems.length) % currentItems.length;
                                        updateLightboxContent(prevIdx);
                                    }
                                });
                                if (nextBtn) nextBtn.addEventListener('click', (e) => {
                                    e.stopPropagation();
                                    if (currentItems.length > 0) {
                                        const nextIdx = (currentIndex + 1) % currentItems.length;
                                        updateLightboxContent(nextIdx);
                                    }
                                });

                                lightbox.addEventListener('click', (e) => {
                                    if (e.target === lightbox) closeLightbox();
                                });

                                document.addEventListener('keydown', (e) => {
                                    if (lightbox.classList.contains('hidden')) return;
                                    if (e.key === 'Escape') closeLightbox();
                                    if (e.key === 'ArrowLeft' && currentItems.length > 0) {
                                        const prevIdx = (currentIndex - 1 + currentItems.length) % currentItems.length;
                                        updateLightboxContent(prevIdx);
                                    }
                                    if (e.key === 'ArrowRight' && currentItems.length > 0) {
                                        const nextIdx = (currentIndex + 1) % currentItems.length;
                                        updateLightboxContent(nextIdx);
                                    }
                                });
                            });

                            // 7. Auto-updater Statistik Pengunjung Real-Time
                            (function () {
                                function refreshLiveStats() {
                                    fetch('/api/statistik-pengunjung')
                                        .then(res => res.json())
                                        .then(res => {
                                            if (res && res.success && res.data) {
                                                const d = res.data;
                                                const elOnline = document.getElementById('stat-online');
                                                const elHariIni = document.getElementById('stat-hari-ini');
                                                const elKemarin = document.getElementById('stat-kemarin');
                                                const elBulanIni = document.getElementById('stat-bulan-ini');
                                                const elTotal = document.getElementById('stat-total');
                                                const elHits = document.getElementById('stat-hits');

                                                if (elOnline && d.online !== undefined) elOnline.textContent = Number(d.online).toLocaleString('id-ID');
                                                if (elHariIni && d.hariIni !== undefined) elHariIni.textContent = Number(d.hariIni).toLocaleString('id-ID');
                                                if (elKemarin && d.kemarin !== undefined) elKemarin.textContent = Number(d.kemarin).toLocaleString('id-ID');
                                                if (elBulanIni && d.bulanIni !== undefined) elBulanIni.textContent = Number(d.bulanIni).toLocaleString('id-ID');
                                                if (elTotal && d.totalPengunjung !== undefined) elTotal.textContent = Number(d.totalPengunjung).toLocaleString('id-ID');
                                                if (elHits && d.totalHits !== undefined) elHits.textContent = Number(d.totalHits).toLocaleString('id-ID');
                                            }
                                        })
                                        .catch(() => {});
                                }
                                // Polling setiap 30 detik untuk update data pengunjung real-time
                                setInterval(refreshLiveStats, 30000);
                            })();

                            // 8. Modal Kalender Akademik Lengkap
                            function openAllKalenderModal() {
                                const modal = document.getElementById('modal-kalender-lengkap');
                                if (modal) {
                                    modal.classList.remove('hidden');
                                    document.body.style.overflow = 'hidden';
                                }
                            }

                            function closeAllKalenderModal() {
                                const modal = document.getElementById('modal-kalender-lengkap');
                                if (modal) {
                                    modal.classList.add('hidden');
                                    document.body.style.overflow = '';
                                }
                            }
                        </script>

                        <!-- Modal Kalender Akademik Lengkap -->
                        <div id="modal-kalender-lengkap" class="fixed inset-0 z-50 hidden bg-slate-950/70 backdrop-blur-sm flex items-center justify-center p-4">
                            <div class="bg-white rounded-3xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 max-h-[85vh] flex flex-col">
                                <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-950 flex items-center justify-center font-bold text-lg shadow-sm">
                                            <i class="fa-solid fa-calendar-days"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-black text-lg text-blue-950">Kalender Akademik Sekolah</h3>
                                            <p class="text-xs text-slate-500">Jadwal kegiatan, ujian, rapat, dan hari libur SMPN 1 Rantepao</p>
                                        </div>
                                    </div>
                                    <button type="button" onclick="closeAllKalenderModal()" class="w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:text-slate-800 hover:bg-slate-200 flex items-center justify-center transition">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>

                                <!-- List of All Events -->
                                <div class="overflow-y-auto py-4 space-y-3 flex-1 pr-1">
                                    <% if (typeof kalenderAkademik !== 'undefined' && kalenderAkademik && kalenderAkademik.length > 0) { %>
                                        <% kalenderAkademik.forEach((agenda) => { %>
                                            <% 
                                                const dMulai = new Date(agenda.tanggal_mulai);
                                                const dSelesai = agenda.tanggal_selesai ? new Date(agenda.tanggal_selesai) : null;
                                                const tglStr = dMulai.getDate();
                                                const blnStr = dMulai.toLocaleDateString('id-ID', { month: 'short' });
                                                let badgeBg = 'bg-blue-50 text-blue-800 border-blue-200';
                                                let dateBg = 'bg-blue-950 text-white';
                                                if (agenda.warna_badge === 'rose') {
                                                    badgeBg = 'bg-rose-50 text-rose-800 border-rose-200';
                                                    dateBg = 'bg-rose-700 text-white';
                                                } else if (agenda.warna_badge === 'emerald') {
                                                    badgeBg = 'bg-emerald-50 text-emerald-800 border-emerald-200';
                                                    dateBg = 'bg-emerald-700 text-white';
                                                } else if (agenda.warna_badge === 'amber') {
                                                    badgeBg = 'bg-amber-50 text-amber-900 border-amber-200';
                                                    dateBg = 'bg-amber-600 text-white';
                                                } else if (agenda.warna_badge === 'purple') {
                                                    badgeBg = 'bg-purple-50 text-purple-800 border-purple-200';
                                                    dateBg = 'bg-purple-700 text-white';
                                                }
                                            %>
                                            <div class="p-3.5 sm:p-4 rounded-2xl border border-slate-200/80 hover:border-blue-300 transition flex items-start gap-3.5 bg-slate-50/50">
                                                <div class="<%= dateBg %> w-12 sm:w-14 rounded-xl py-2 text-center shrink-0 shadow-sm flex flex-col justify-center items-center">
                                                    <span class="text-[10px] uppercase font-bold tracking-wider leading-none opacity-90"><%= blnStr %></span>
                                                    <span class="text-base sm:text-lg font-black leading-tight mt-0.5"><%= tglStr %></span>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex flex-wrap items-center gap-2 mb-1">
                                                        <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-md border <%= badgeBg %>">
                                                            <%= agenda.kategori %>
                                                        </span>
                                                        <span class="text-[11px] text-slate-500 font-medium">
                                                            <i class="fa-regular fa-clock text-[10px] mr-0.5 text-slate-400"></i>
                                                            <% if (dSelesai && dSelesai.getTime() !== dMulai.getTime()) { %>
                                                                <%= dMulai.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %> - <%= dSelesai.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                                            <% } else { %>
                                                                <%= dMulai.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                                            <% } %>
                                                        </span>
                                                        <% if (agenda.lokasi) { %>
                                                            <span class="text-[11px] text-slate-400 flex items-center gap-1">
                                                                <i class="fa-solid fa-location-dot text-[10px] text-amber-500"></i>
                                                                <%= agenda.lokasi %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <h4 class="font-black text-xs sm:text-sm text-slate-900 leading-snug">
                                                        <%= agenda.judul_kegiatan %>
                                                    </h4>
                                                    <% if (agenda.deskripsi) { %>
                                                        <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                                                            <%= agenda.deskripsi %>
                                                        </p>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="text-center py-10 text-slate-400 text-xs">
                                            Belum ada data kalender akademik.
                                        </div>
                                    <% } %>
                                </div>

                                <div class="pt-4 border-t border-slate-100 flex justify-end">
                                    <button type="button" onclick="closeAllKalenderModal()" class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition">
                                        Tutup
                                    </button>
                                </div>
                            </div>
                        </div>
</body>

</html>