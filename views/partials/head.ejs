<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="format-detection" content="telephone=no">
<title><%= (typeof title !== 'undefined' && title) ? title : ((typeof profil !== 'undefined' && profil.nama_sekolah) ? (profil.nama_sekolah + ' - Kabupaten Toraja Utara') : 'UPT SMPN 1 Rantepao - Toraja Utara') %></title>

<!-- Meta SEO & Informasi Sekolah -->
<meta name="description" content="<%= (typeof description !== 'undefined' && description) ? description : ('Portal Resmi ' + ((typeof profil !== 'undefined' && profil.nama_sekolah) ? profil.nama_sekolah : 'UPT SMP Negeri 1 Rantepao') + ' - Melayani dengan integritas, prestasi, dan keluhuran budaya Toraja.') %>">
<meta name="keywords" content="SMPN 1 Rantepao, UPT SMP Negeri 1 Rantepao, Toraja Utara, Sekolah Penggerak, PPDB 2026, Profil Pelajar Pancasila">
<meta name="theme-color" content="#0b132b">

<!-- Open Graph / Meta Berbagi Media Sosial (WhatsApp, Facebook, Telegram) -->
<meta property="og:type" content="<%= (typeof ogType !== 'undefined' && ogType) ? ogType : 'website' %>">
<meta property="og:site_name" content="<%= (typeof profil !== 'undefined' && profil.nama_sekolah) ? profil.nama_sekolah : 'UPT SMP Negeri 1 Rantepao' %>">
<meta property="og:title" content="<%= (typeof title !== 'undefined' && title) ? title : ((typeof profil !== 'undefined' && profil.nama_sekolah) ? (profil.nama_sekolah + ' - Kabupaten Toraja Utara') : 'UPT SMPN 1 Rantepao') %>">
<meta property="og:description" content="<%= (typeof description !== 'undefined' && description) ? description : 'Portal Resmi Informasi, Akademik, PPDB Online, dan Kegiatan Sekolah UPT SMP Negeri 1 Rantepao, Toraja Utara.' %>">
<meta property="og:image" content="<%= (typeof ogImage !== 'undefined' && ogImage) ? ogImage : ((typeof profil !== 'undefined' && profil.logo_sekolah) ? ('/uploads/profil/' + profil.logo_sekolah) : '/uploads/profil/logo-smpn1-rantepao.svg') %>">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= (typeof title !== 'undefined' && title) ? title : ((typeof profil !== 'undefined' && profil.nama_sekolah) ? profil.nama_sekolah : 'UPT SMPN 1 Rantepao') %>">
<meta name="twitter:description" content="<%= (typeof description !== 'undefined' && description) ? description : 'Portal Resmi UPT SMP Negeri 1 Rantepao, Kabupaten Toraja Utara.' %>">

<!-- Favicon Dinamis Logo Sekolah -->
<link rel="icon" type="image/x-icon" href="<%= (typeof profil !== 'undefined' && profil && profil.logo_sekolah) ? ('/uploads/profil/' + profil.logo_sekolah) : '/uploads/profil/logo-smpn1-rantepao.svg' %>">

<!-- Google Fonts: Poppins -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

<!-- AOS (Animate On Scroll) CSS CDN -->
<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

<!-- Font Awesome 6 Icons CDN (Aset Ikon Vektor Resmi) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<!-- Swiper Carousel CSS CDN -->
