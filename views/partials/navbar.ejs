                                <a href="javascript:void(0)" onclick="openHalamanModal('sejarah')" class="block px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-white/5 cursor-pointer">2. Sejarah Singkat</a>
                                <a href="/#visi-misi" class="block px-2.5 py-1.5 rounded-lg text-slate-300 hover:text-amber-400 hover:bg-white/5">3. Visi Misi</a>
