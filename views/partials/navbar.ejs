                                            <!-- 2. Sejarah Singkat (Modal Popup) -->
                                            <a href="javascript:void(0)" onclick="openHalamanModal('sejarah')" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-300 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/item cursor-pointer">
                                                <i class="fa-solid fa-landmark text-amber-400 group-hover/item:text-blue-950 transition-colors w-4 text-center"></i>
                                                <span>Sejarah Singkat</span>
                                            </a>
                                            <!-- 3. Visi Misi (Scroll ke Beranda) -->
                                            <a href="/#visi-misi" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-300 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/item">
