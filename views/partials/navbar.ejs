                                                <i class="fa-solid fa-building-columns text-amber-400 group-hover/item:text-blue-950 transition-colors w-4 text-center"></i>
                                                <span>Sarana dan Prasarana</span>
                                            </a>
                                            <!-- 5. Program Kerja (Modal Popup) -->
                                            <a href="javascript:void(0)" onclick="openHalamanModal('program-kerja')" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-300 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/item cursor-pointer">
                                                <i class="fa-solid fa-list-check text-amber-400 group-hover/item:text-blue-950 transition-colors w-4 text-center"></i>
                                                <span>Program Kerja</span>
                                            </a>
                                            <!-- 6. Kondisi Siswa / Statistik (Modal Popup) -->
                                            <a href="javascript:void(0)" onclick="openHalamanModal('kondisi-siswa')" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-300 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/item cursor-pointer">
                                                <i class="fa-solid fa-chart-pie text-amber-400 group-hover/item:text-blue-950 transition-colors w-4 text-center"></i>
                                                <span>Kondisi Siswa / Statistik</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sub-menu 2: Civitas Akademik (Scroll ke Slider Guru & Pegawai di Beranda) -->
                                <a href="/#guru" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-200 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/civitas">
                                    <span class="flex items-center gap-2.5">
                                        <i class="fa-solid fa-chalkboard-user text-amber-400 group-hover/civitas:text-blue-950 transition-colors w-4 text-center"></i>
                                        <span>Civitas Akademik</span>
                                    </span>
                                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/civitas:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>

                                <!-- Sub-menu 3: Komite Sekolah (Scroll ke Bagian Komite di Beranda) -->
                                <a href="/#komite" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-200 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/komite">
                                    <span class="flex items-center gap-2.5">
                                        <i class="fa-solid fa-users-gear text-amber-400 group-hover/komite:text-blue-950 transition-colors w-4 text-center"></i>
                                        <span>Komite Sekolah</span>
                                    </span>
                                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/komite:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>

                                <!-- Sub-menu 4: Kalender Akademik (Scroll ke Kalender Akademik di Beranda) -->
                                <a href="/#kalender-akademik" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-200 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/kalender">
                                    <span class="flex items-center gap-2.5">
                                        <i class="fa-solid fa-calendar-days text-amber-400 group-hover/kalender:text-blue-950 transition-colors w-4 text-center"></i>
                                        <span>Kalender Akademik</span>
                                    </span>
                                    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/kalender:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                                    </svg>
                                </a>

                            </div>
                        </div>
                    </div>

                    <a href="/#berita"
                        class="<%= currentActive === 'berita' ? 'text-amber-400 font-bold py-1.5 relative after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-amber-400' : 'text-slate-200 hover:text-amber-400 transition-colors py-1.5 relative group' %>">
                        Berita
                        <% if (currentActive !=='berita' ) { %><span
                                class="absolute bottom-0 left-0 w-0 h-0.5 bg-amber-400 group-hover:w-full transition-all duration-300"></span>
                            <% } %>
                    </a>

                    <a href="/#pengumuman"
                        class="<%= currentActive === 'pengumuman' ? 'text-amber-400 font-bold py-1.5 relative after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-amber-400' : 'text-slate-200 hover:text-amber-400 transition-colors py-1.5 relative group' %>">
                        Pengumuman
                        <% if (currentActive !=='pengumuman' ) { %><span
