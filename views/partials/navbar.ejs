                            <span>Profil</span>
                            <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/profil:rotate-180 text-slate-400 group-hover/profil:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-amber-400 group-hover/profil:w-full transition-all duration-300"></span>
                        </button>

                        <!-- Dropdown Level 1 (Profil) -->
                        <div class="invisible opacity-0 translate-y-2 pointer-events-none group-hover/profil:visible group-hover/profil:opacity-100 group-hover/profil:translate-y-0 group-hover/profil:pointer-events-auto transition-all duration-300 ease-out absolute top-full left-0 pt-2 w-64 z-50">
                            <div class="bg-slate-900/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-2 space-y-1">
                                
                                <!-- Sub-menu 1: Tentang Kami with nested flyout -->
                                <div class="relative group/tentang">
                                    <button type="button" class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-200 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group-hover/tentang:bg-amber-500 group-hover/tentang:text-blue-950 text-left">
