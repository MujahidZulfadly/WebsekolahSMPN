                                    <div class="invisible opacity-0 translate-x-2 pointer-events-none group-hover/tentang:visible group-hover/tentang:opacity-100 group-hover/tentang:translate-x-0 group-hover/tentang:pointer-events-auto transition-all duration-300 ease-out absolute top-0 left-full pl-2 w-64 z-50">
                                        <div class="bg-slate-900/95 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl p-2 space-y-1">
                                            <!-- 1. Sambutan Kepala Sekolah (Scroll ke Beranda) -->
                                            <a href="/#sambutan" class="flex items-center gap-2.5 px-3 py-2 rounded-xl text-slate-300 hover:bg-amber-500 hover:text-blue-950 font-semibold text-xs transition-all duration-200 group/item">
