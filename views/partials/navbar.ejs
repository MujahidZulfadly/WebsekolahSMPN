    <!-- ============================================================== -->
    <!-- MODAL POPUP INTERAKTIF: TENTANG KAMI (HALAMAN STATIS) -->
    <!-- ============================================================== -->
    <div id="modal-halaman-statis" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4 sm:p-6 overflow-y-auto" role="dialog" aria-modal="true">
        <!-- Backdrop Gelap dengan Blur -->
        <div class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm transition-opacity duration-300" onclick="closeHalamanModal()"></div>

        <!-- Modal Box Container -->
        <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-slate-100 z-10 overflow-hidden transform transition-all duration-300 scale-95 opacity-0 flex flex-col max-h-[88vh]" id="modal-halaman-box">
            
            <!-- Header Modal Bergaris Tipis -->
            <div class="px-6 py-4.5 border-b border-slate-100 flex items-center justify-between bg-gradient-to-r from-slate-50/90 to-white">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center text-lg font-bold border border-amber-500/20 shadow-sm shrink-0" id="modal-halaman-icon-wrapper">
                        <i class="fa-solid fa-school text-amber-600" id="modal-halaman-icon"></i>
                    </div>
                    <div>
                        <span class="text-[10px] font-black tracking-widest uppercase text-amber-600 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                            Profil & Informasi
                        </span>
                        <h3 class="text-base sm:text-lg font-black text-blue-950 tracking-tight leading-tight mt-0.5" id="modal-halaman-title">
                            Memuat Informasi...
                        </h3>
                    </div>
                </div>
                <!-- Tombol Tutup (×) -->
                <button type="button" onclick="closeHalamanModal()" class="w-9 h-9 rounded-full bg-slate-100 hover:bg-rose-50 text-slate-500 hover:text-rose-600 flex items-center justify-center text-lg font-bold transition-colors focus:outline-none cursor-pointer" aria-label="Tutup Modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Body Area Konten dengan Scrollbar Halus -->
            <div class="p-6 sm:p-7 overflow-y-auto space-y-4 text-slate-700 text-sm leading-relaxed" id="modal-halaman-body">
                <!-- Loading Skeleton -->
                <div class="space-y-3 py-6 animate-pulse" id="modal-halaman-loading">
                    <div class="h-4 bg-slate-200 rounded-full w-3/4"></div>
                    <div class="h-4 bg-slate-200 rounded-full w-full"></div>
                    <div class="h-4 bg-slate-200 rounded-full w-5/6"></div>
                    <div class="h-4 bg-slate-200 rounded-full w-2/3"></div>
                </div>
                <div id="modal-halaman-content" class="hidden"></div>
            </div>

            <!-- Footer Modal -->
            <div class="px-6 py-3.5 bg-slate-50/80 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                <span class="flex items-center gap-1.5 text-slate-400 text-[11px]" id="modal-halaman-meta">
                    <i class="fa-solid fa-clock-rotate-left"></i> Terakhir Diperbarui: <span id="modal-halaman-date">-</span>
                </span>
                <button type="button" onclick="closeHalamanModal()" class="px-4 py-1.5 rounded-xl bg-blue-950 hover:bg-blue-900 text-white font-bold text-xs transition shadow-sm cursor-pointer">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <script>
        function toggleMobileSubmenu(menuId, arrowId) {
            var menu = document.getElementById(menuId);
            var arrow = document.getElementById(arrowId);
            if (menu) {
                menu.classList.toggle('hidden');
            }
            if (arrow) {
                arrow.classList.toggle('rotate-180');
            }
        }

        // Modal Popup Halaman Statis / Profil Logic
        const iconHalamanMap = {
            'sejarah': 'fa-landmark',
            'visi-misi': 'fa-bullseye',
            'sarana': 'fa-building-columns',
            'program-kerja': 'fa-list-check',
            'kondisi-siswa': 'fa-chart-pie'
        };

        async function openHalamanModal(slug) {
            const modal = document.getElementById('modal-halaman-statis');
            const box = document.getElementById('modal-halaman-box');
            const titleEl = document.getElementById('modal-halaman-title');
            const loadingEl = document.getElementById('modal-halaman-loading');
            const contentEl = document.getElementById('modal-halaman-content');
            const dateEl = document.getElementById('modal-halaman-date');
            const iconEl = document.getElementById('modal-halaman-icon');

            if (!modal) return;

            // Close mobile menu drawer if open
            const mobilePane = document.getElementById('mobile-menu-pane');
            if (mobilePane && !mobilePane.classList.contains('hidden')) {
                mobilePane.classList.add('hidden');
            }

            // Update icon
            if (iconEl && iconHalamanMap[slug]) {
                iconEl.className = `fa-solid ${iconHalamanMap[slug]} text-amber-600`;
            }

            // Reset modal state
            titleEl.textContent = 'Memuat Informasi...';
            loadingEl.classList.remove('hidden');
            contentEl.classList.add('hidden');
            contentEl.innerHTML = '';
            dateEl.textContent = '-';

            // Show modal backdrop
            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');

            setTimeout(() => {
                box.classList.remove('scale-95', 'opacity-0');
                box.classList.add('scale-100', 'opacity-100');
            }, 10);

            try {
                const res = await fetch('/api/halaman/' + encodeURIComponent(slug));
                const result = await res.json();
                if (result && result.success && result.data) {
                    titleEl.textContent = result.data.judul;
                    contentEl.innerHTML = result.data.konten;
                    if (iconEl && result.data.ikon) {
                        iconEl.className = `${result.data.ikon} text-amber-600`;
                    }
                    if (result.data.updated_at) {
                        const d = new Date(result.data.updated_at);
                        dateEl.textContent = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
                    } else {
                        dateEl.textContent = 'Terkini';
                    }
                    loadingEl.classList.add('hidden');
                    contentEl.classList.remove('hidden');
                } else {
                    titleEl.textContent = 'Informasi Belum Tersedia';
                    contentEl.innerHTML = `<p class="text-rose-500 font-medium">Halaman informasi "${slug}" sedang dipersiapkan oleh pihak sekolah.</p>`;
                    loadingEl.classList.add('hidden');
                    contentEl.classList.remove('hidden');
                }
            } catch (err) {
                titleEl.textContent = 'Koneksi Terputus';
                contentEl.innerHTML = `<p class="text-rose-500 font-medium">Gagal memuat data: ${err.message}</p>`;
                loadingEl.classList.add('hidden');
                contentEl.classList.remove('hidden');
            }
        }

        function closeHalamanModal() {
            const modal = document.getElementById('modal-halaman-statis');
            const box = document.getElementById('modal-halaman-box');
            if (!modal) return;
            box.classList.remove('scale-100', 'opacity-100');
            box.classList.add('scale-95', 'opacity-0');
            document.body.classList.remove('overflow-hidden');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        window.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeHalamanModal();
            }
        });

        // Smooth scroll & auto-close mobile drawer for internal anchor links
        document.addEventListener('DOMContentLoaded', function() {
            const anchorLinks = document.querySelectorAll('a[href^="/#"], a[href^="#"]');
            anchorLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    const href = this.getAttribute('href');
                    const hashIndex = href.indexOf('#');
                    if (hashIndex !== -1) {
                        const targetId = href.substring(hashIndex + 1);
                        if (window.location.pathname === '/' || window.location.pathname === '') {
                            const targetEl = document.getElementById(targetId);
                            if (targetEl) {
                                e.preventDefault();
                                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                history.pushState(null, null, '#' + targetId);

                                // Close mobile menu drawer if open
                                const mobilePane = document.getElementById('mobile-menu-pane');
                                if (mobilePane && !mobilePane.classList.contains('hidden')) {
                                    mobilePane.classList.add('hidden');
                                }
                            }
                        }
                    }
                });
            });
        });
    </script>