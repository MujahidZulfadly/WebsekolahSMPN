<% const footerProfil = (typeof profil !== 'undefined' && profil) ? profil : {}; %>
    <!-- ============================================================== -->
    <!-- UNIFIED FOOTER SMPN 1 RANTEPAO -->
    <!-- ============================================================== -->
    <footer class="bg-slate-950 text-slate-400 py-10 text-center text-sm border-t border-slate-800 relative z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center justify-center space-y-3">

            <!-- School Logo & Title -->
            <div class="flex items-center justify-center gap-3">
                <div class="w-10 h-10 sm:w-11 sm:h-11 flex items-center justify-center shrink-0">
                    <% if (footerProfil && footerProfil.logo_sekolah) { %>
                        <img src="/uploads/profil/<%= footerProfil.logo_sekolah %>" alt="Logo" class="w-full h-full object-contain" onerror="this.onerror=null; this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');">
                        <span class="hidden">S1</span>
                    <% } else { %>
                        <span>S1</span>
                    <% } %>
                </div>
                <p class="font-extrabold text-white text-base sm:text-lg tracking-wide">
                    <%= footerProfil.nama_sekolah || 'UPT SMP NEGERI 1 RANTEPAO' %>
                </p>
            </div>

            <!-- Stacked Copyright & Developer Info (Clean & Centered) -->
            <div class="space-y-1 text-xs text-slate-400 pt-1">
                <p>
                    &copy; <%= new Date().getFullYear() %> <span class="font-semibold text-slate-300"><%= footerProfil.nama_sekolah || 'UPT SMPN 1 RANTEPAO' %></span>. All Rights Reserved.
                </p>
                <p>
                    <a href="https://www.linyjayainformatika.co.id/" target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 hover:underline font-medium transition-colors">Developed by PT. Liny Jaya Informatika</a>
                </p>
            </div>
        </div>
    </footer>

    <!-- Swiper Carousel JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- AOS (Animate On Scroll) JS CDN -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        // Inisialisasi AOS Animation
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    once: true,
                    duration: 800,
                    offset: 50,
                    easing: 'ease-out-cubic'
                });
            }

            // Mobile Menu Toggle Universal Handler
            const mobileBtn = document.getElementById('mobile-toggle-btn');
            const mobileMenu = document.getElementById('mobile-menu-pane');
            if (mobileBtn && mobileMenu) {
                mobileBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }
        });
    </script>
