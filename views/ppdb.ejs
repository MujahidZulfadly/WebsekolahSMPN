                        </div>
                    </div>
                    <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-start gap-3">
                        <span class="text-lg">💬</span>
                        <div>
                            <p class="font-bold text-slate-800">WhatsApp Panitia PPDB:</p>
                            <a href="https://wa.me/6281234567890?text=Halo%20Panitia%20PPDB%20SMPN%201%20Rantepao,%20saya%20ingin%20bertanya%20mengenai%20pendaftaran" target="_blank" class="inline-block mt-1 text-xs font-bold text-emerald-700 hover:text-emerald-800 bg-emerald-50 px-3 py-1.5 rounded-lg border border-emerald-200 transition">
                                Hubungi via WhatsApp Chat →
                            </a>
                        </div>
                    </div>
                </div>

                <div class="pt-2">
                    <a href="/" class="w-full py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl flex items-center justify-center gap-1 transition">
                        <span>← Kembali ke Halaman Beranda</span>
                    </a>
                </div>
            </div>

        </section>

    </main>

    <!-- Unified Footer Component -->
    <%- include('partials/footer') %>

    <!-- Script to check URL params for success alert and AJAX PPDB Status Checker -->
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        
        // Handle New Registration Alert
        if (urlParams.get('daftar_sukses') === '1') {
            const alertBox = document.getElementById('ppdb-sukses-alert');
            const noReg = urlParams.get('no_reg');
            if (noReg) {
                const regDisplay = document.getElementById('nomor-registrasi-display');
                if (regDisplay) regDisplay.textContent = decodeURIComponent(noReg);
            }
            if (alertBox) {
                alertBox.classList.remove('hidden');
                alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // Handle URL search parameter ?q=... on initial load
        const queryParam = urlParams.get('q');
        if (queryParam) {
            const inputEl = document.getElementById('input-cek-keyword');
            if (inputEl) inputEl.value = queryParam;
            // If server didn't pre-render or if user navigated
            const container = document.getElementById('hasil-cek-container');
            if (container && container.classList.contains('hidden')) {
                checkStatusAjax(queryParam);
            }
        }

        // AJAX Status Checker
        async function checkStatusAjax(keyword) {
            const container = document.getElementById('hasil-cek-container');
            const btnText = document.getElementById('btn-cek-text');
            const btnSpinner = document.getElementById('btn-cek-spinner');
            const submitBtn = document.getElementById('btn-cek-submit');

            if (!keyword || !keyword.trim()) return;

            btnText.textContent = 'Memeriksa...';
            btnSpinner.classList.remove('hidden');
            submitBtn.disabled = true;

            try {
                const res = await fetch('/api/ppdb/cek?q=' + encodeURIComponent(keyword.trim()));
                const data = await res.json();

                container.classList.remove('hidden');

                if (data.success && data.data) {
                    const p = data.data;
                    const dateFormatted = new Date(p.tanggal_daftar).toLocaleDateString('id-ID', {
                        weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
                    });

                    let statusBanner = '';
                    if (p.status_seleksi === 'Diterima') {
                        statusBanner = `
                            <div class="p-5 rounded-2xl bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/20 space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-2xl">🎉</span>
                                    <span class="text-xs font-black uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full">HASIL AKHIR SELEKSI</span>
                                </div>
                                <h4 class="text-lg sm:text-xl font-black">SELAMAT! Calon Peserta Didik Dinyatakan DITERIMA</h4>
                                <p class="text-xs text-emerald-100">
                                    Calon siswa telah memenuhi kriteria seleksi pada <strong>Jalur ${p.jalur_pendaftaran}</strong>. Silakan melakukan lapor diri / verifikasi daftar ulang di loket sekolah.
                                </p>
                            </div>
                        `;
                    } else if (p.status_seleksi === 'Berkas Terverifikasi') {
                        statusBanner = `
                            <div class="p-5 rounded-2xl bg-gradient-to-r from-blue-600 to-blue-700 text-white shadow-lg shadow-blue-500/20 space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-2xl">✓</span>
                                    <span class="text-xs font-black uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full">STATUS ADMINISTRASI</span>
                                </div>
                                <h4 class="text-lg sm:text-xl font-black">BERKAS FISIK TERVERIFIKASI & VALID</h4>
                                <p class="text-xs text-blue-100">
                                    Dokumen fisik calon siswa telah dinyatakan lengkap oleh panitia. Data saat ini dalam tahap pemeringkatan kuota akhir.
                                </p>
                            </div>
                        `;
                    } else if (p.status_seleksi === 'Tidak Diterima') {
                        statusBanner = `
                            <div class="p-5 rounded-2xl bg-gradient-to-r from-rose-600 to-rose-700 text-white shadow-lg shadow-rose-500/20 space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-2xl">✕</span>
                                    <span class="text-xs font-black uppercase tracking-wider bg-white/20 px-2.5 py-0.5 rounded-full">HASIL SELEKSI</span>
                                </div>
                                <h4 class="text-lg sm:text-xl font-black">MOHON MAAF, BELUM MEMENUHI KUOTA SELEKSI</h4>
                                <p class="text-xs text-rose-100">
                                    Peringkat nilai atau radius zonasi telah memenuhi batas kuota penerimaan jalur ini. Tetap semangat dalam meraih prestasi.
                                </p>
                            </div>
                        `;
                    } else {
                        statusBanner = `
                            <div class="p-5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 shadow-lg shadow-amber-500/20 space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-2xl">⏳</span>
                                    <span class="text-xs font-black uppercase tracking-wider bg-black/10 px-2.5 py-0.5 rounded-full">STATUS PENDAFTARAN</span>
                                </div>
                                <h4 class="text-lg sm:text-xl font-black">PENDAFTARAN MASUK - MENUNGGU VERIFIKASI LOKET</h4>
                                <p class="text-xs text-slate-900 font-medium">
                                    Data calon siswa telah tersimpan di sistem. Silakan bawa berkas fisik (fotokopi KK, Akta Kelahiran, dan SKL/Rapor) ke loket PPDB sekolah untuk verifikasi fisik.
                                </p>
                            </div>
                        `;
                    }

                    container.innerHTML = `
                        <div class="bg-white rounded-3xl p-6 sm:p-8 text-slate-800 shadow-2xl border border-slate-200 space-y-6">
                            <div class="border-b border-slate-200 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-2xl bg-blue-900 text-amber-400 flex items-center justify-center font-black text-xl shadow flex-shrink-0">
                                        S1
                                    </div>
                                    <div>
                                        <p class="text-[10px] font-bold text-amber-600 uppercase tracking-widest">Lembar Bukti Status PPDB 2026/2027</p>
                                        <h3 class="text-base sm:text-lg font-black text-blue-950 leading-tight"><%= profil.nama_sekolah || 'SMP NEGERI 1 RANTEPAO' %></h3>
                                        <p class="text-[11px] text-slate-400">Toraja Utara, Sulawesi Selatan</p>
                                    </div>
                                </div>
                                <div class="text-left sm:text-right">
                                    <span class="font-mono font-bold text-sm bg-slate-100 text-slate-800 px-3 py-1 rounded-lg border border-slate-200 block sm:inline-block">
                                        ${p.no_pendaftaran}
                                    </span>
                                </div>
                            </div>

                            ${statusBanner}

                            <div class="grid sm:grid-cols-2 gap-4 text-xs bg-slate-50 p-5 rounded-2xl border border-slate-200">
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Nama Calon Siswa:</span>
                                    <span class="font-bold text-slate-900 text-sm">${p.nama_siswa}</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px]">NISN / Jenis Kelamin:</span>
                                    <span class="font-semibold text-slate-800 font-mono">
                                        ${p.nisn || '-'} (${p.jenis_kelamin})
                                    </span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Asal Sekolah SD / MI:</span>
                                    <span class="font-semibold text-slate-800">${p.asal_sekolah}</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Pilihan Jalur Masuk:</span>
                                    <span class="font-bold text-blue-800">Jalur ${p.jalur_pendaftaran}</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Nama Orang Tua / Wali:</span>
                                    <span class="font-semibold text-slate-800">${p.nama_ortu}</span>
                                </div>
                                <div>
                                    <span class="text-slate-400 block text-[11px]">Waktu Pendaftaran:</span>
                                    <span class="font-semibold text-slate-700">📅 ${dateFormatted}</span>
                                </div>
                            </div>

                            <div class="p-4 rounded-xl bg-blue-50/60 border border-blue-200/80 text-xs text-slate-700 space-y-1">
                                <p class="font-bold text-blue-950 flex items-center gap-1.5">
                                    <span>📌 Catatan Resmi Panitia PPDB:</span>
                                </p>
                                <p class="leading-relaxed">
                                    ${p.catatan ? p.catatan : 'Berkas pendaftaran sedang dalam peninjauan oleh tim panitia PPDB UPT SMPN 1 Rantepao.'}
                                </p>
                            </div>

                            <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100">
                                <button type="button" onclick="window.print()" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-1.5">
                                    <span>🖨️ Cetak Bukti Status</span>
                                </button>
                                <a href="https://wa.me/6281234567890?text=Halo%20Panitia%20PPDB%20SMPN%201%20Rantepao,%20saya%20ingin%20konfirmasi%20status%20pendaftaran%20nomor%20${encodeURIComponent(p.no_pendaftaran)}" 
                                   target="_blank" 
                                   class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-1.5">
                                    <span>💬 Hubungi Panitia (WA)</span>
                                </a>
                            </div>
                        </div>
                    `;
                } else {
                    container.innerHTML = `
                        <div class="bg-red-950/80 border-2 border-red-500 text-red-200 rounded-3xl p-6 sm:p-8 text-center space-y-3 shadow-xl">
                            <div class="text-3xl">🔍❌</div>
                            <h4 class="text-lg font-bold text-white">Data Pendaftaran Tidak Ditemukan</h4>
                            <p class="text-xs sm:text-sm text-red-200 max-w-md mx-auto">
                                Tidak ditemukan calon siswa dengan Nomor Pendaftaran atau NISN <strong>"${keyword}"</strong>.
                            </p>
                            <p class="text-[11px] text-slate-400">
                                Silakan periksa kembali nomor yang Anda masukkan atau hubungi sekretariat panitia loket PPDB sekolah.
                            </p>
                        </div>
                    `;
                }

                container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } catch (e) {
                console.error(e);
            } finally {
                btnText.textContent = 'Periksa Status';
                btnSpinner.classList.add('hidden');
                submitBtn.disabled = false;
            }
        }

        function handleCekStatusSubmit(e) {
            e.preventDefault();
            const val = document.getElementById('input-cek-keyword').value;
            checkStatusAjax(val);
        }

        function quickFillCheck(val) {
            document.getElementById('input-cek-keyword').value = val;
            checkStatusAjax(val);
        }

        function checkRegisteredNow() {
            const regDisplay = document.getElementById('nomor-registrasi-display');
            if (regDisplay) {
                const code = regDisplay.textContent.trim();
                quickFillCheck(code);
                document.getElementById('cek-status').scrollIntoView({ behavior: 'smooth' });
            }
        }
    </script>

</body>
</html>
