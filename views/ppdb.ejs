                            <input type="text" name="asal_sekolah" required placeholder="Contoh: SDN 1 Rantepao" class="w-full text-xs text-slate-900 border border-slate-300 rounded-xl px-4 py-3 focus:outline-amber-500 bg-white">
                        </div>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-amber-400 mb-1">Nama Orang Tua / Wali Siswa *</label>
