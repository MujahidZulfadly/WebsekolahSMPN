<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <%- include('partials/head', { title: itemBerita.judul + ' - ' + (profil.nama_sekolah || 'SMPN 1 RANTEPAO') }) %>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-amber-400 selection:text-blue-950">

    <!-- Unified Navbar Component -->
    <%- include('partials/navbar', { activePage: 'berita' }) %>

    <!-- Sub-Hero Banner -->
    <%- include('partials/subhero', {
        badge: itemBerita.nama_kategori || 'Warta Sekolah',
        title: itemBerita.judul,
        subtitle: 'Dipublikasikan pada ' + new Date(itemBerita.tanggal_publish).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }),
        breadcrumbs: [
            { label: 'Beranda', url: '/' },
            { label: 'Berita', url: '/#berita' },
            { label: 'Detail Berita' }
        ],
        waveFill: 'text-slate-50'
    }) %>

    <!-- Main Content Layout -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12 grid lg:grid-cols-12 gap-10 flex-1">
        
        <!-- Article Column (8 Cols) -->
        <article data-aos="fade-up" class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
            <div>
                <!-- Metadata Badges -->
                <div class="flex flex-wrap items-center gap-2.5 mb-4">
                    <span class="bg-amber-100 text-amber-800 border border-amber-200 text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider">
                        <%= itemBerita.nama_kategori || 'Warta Sekolah' %>
                    </span>
                    <span class="text-xs text-slate-400 flex items-center gap-1.5">
                        <i class="fa-solid fa-calendar-day text-slate-400"></i>
                        <span><%= new Date(itemBerita.tanggal_publish).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </span>
                    <span class="text-xs text-slate-400 flex items-center gap-1.5">
                        <i class="fa-solid fa-eye text-slate-400"></i>
                        <span><%= itemBerita.views || 0 %> kali dibaca</span>
                    </span>
                </div>

                <!-- Big News Title -->
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-blue-950 leading-tight mb-6 tracking-tight">
                    <%= itemBerita.judul %>
                </h1>

                <!-- Author & Editor Info -->
                <div class="flex items-center gap-3.5 pb-6 mb-8 border-b border-slate-100">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-blue-950 to-blue-800 text-amber-400 font-black flex items-center justify-center text-sm shadow">
                        S1
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-800">Ditulis oleh: <%= itemBerita.penulis_nama || 'Humas SMPN 1 Rantepao' %></p>
                        <p class="text-[11px] text-slate-400">Tim Publikasi & Dokumentasi UPT SMPN 1 Rantepao</p>
                    </div>
                </div>

                <!-- Featured Image -->
                <% if (itemBerita.gambar && itemBerita.gambar !== 'default.jpg' && itemBerita.gambar !== '') { %>
                    <div class="mb-8 rounded-3xl overflow-hidden border border-slate-200/80 shadow-md">
                        <img src="/uploads/berita/<%= itemBerita.gambar %>" alt="<%= itemBerita.judul %>" class="w-full max-h-[460px] object-cover">
                    </div>
                <% } else { %>
                    <div class="mb-8 rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-blue-950 via-slate-900 to-blue-900 text-white flex items-center justify-between border border-blue-900 shadow-md">
                        <div>
                            <span class="text-amber-400 text-xs font-black uppercase tracking-wider">Warta Resmi Sekolah</span>
                            <h3 class="text-xl sm:text-2xl font-black mt-1"><%= profil.nama_sekolah || 'UPT SMPN 1 RANTEPAO' %></h3>
                            <p class="text-xs text-slate-300 mt-1 max-w-md">Membangun generasi unggul yang cerdas, berintegritas, dan berakhlak mulia.</p>
                        </div>
                        <div class="text-5xl opacity-40 text-amber-400"><i class="fa-solid fa-newspaper"></i></div>
                    </div>
                <% } %>

                <!-- Article Content Body -->
                <div class="text-slate-700 leading-relaxed text-sm sm:text-base space-y-4 whitespace-pre-line font-normal">
                    <%= itemBerita.isi_berita %>
                </div>
            </div>

            <!-- Share & Navigation Section -->
            <div class="mt-12 pt-6 border-t border-slate-100">
                <p class="text-xs font-extrabold uppercase tracking-wider text-slate-400 mb-3">Bagikan Informasi Ini:</p>
                <div class="flex flex-wrap gap-2.5 items-center">
                    <button type="button" onclick="shareToWA()" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl flex items-center gap-2 transition shadow-sm hover:scale-105 active:scale-95">
                        <i class="fa-brands fa-whatsapp text-sm"></i>
                        <span>WhatsApp</span>
                    </button>
                    <button type="button" onclick="copyArticleLink()" class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl flex items-center gap-2 transition hover:scale-105 active:scale-95">
                        <span id="copy-btn-text" class="flex items-center gap-1.5"><i class="fa-solid fa-copy"></i><span>Salin Tautan</span></span>
                    </button>
                    <a href="/#berita" class="ml-auto px-5 py-2.5 bg-blue-950 hover:bg-blue-900 text-amber-400 text-xs font-bold rounded-xl transition shadow flex items-center gap-1.5 hover:scale-105">
                        <span>← Kembali ke Beranda</span>
                    </a>
                </div>
            </div>

        </article>

        <!-- Sidebar Column (4 Cols) -->
        <aside class="lg:col-span-4 space-y-8">
            
            <!-- Berita Terbaru Lainnya -->
            <div class="bg-white p-6 sm:p-7 rounded-3xl border border-slate-200/80 shadow-sm">
                <h3 class="font-black text-base text-blue-950 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-newspaper text-amber-500"></i>
                    <span>Berita Terbaru Lainnya</span>
                </h3>
                <div class="divide-y divide-slate-100 mt-2">
                    <% if (!beritaLainnya || beritaLainnya.length === 0) { %>
                        <p class="text-xs text-slate-400 py-4">Belum ada berita lainnya.</p>
                    <% } else { %>
                        <% beritaLainnya.forEach(other => { %>
                            <div class="py-3.5 group">
                                <span class="text-[10px] font-black text-amber-600 uppercase tracking-wider"><%= other.nama_kategori %></span>
                                <a href="/berita/<%= other.slug %>" class="block font-bold text-xs sm:text-sm text-slate-800 group-hover:text-blue-900 transition mt-1 line-clamp-2 leading-snug">
                                    <%= other.judul %>
                                </a>
                                <span class="text-[10px] text-slate-400 mt-1 flex items-center gap-1.5">
                                    <i class="fa-solid fa-calendar-day text-slate-400"></i>
                                    <span><%= new Date(other.tanggal_publish).toLocaleDateString('id-ID') %></span>
                                </span>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Pengumuman Terkini -->
            <div class="bg-white p-6 sm:p-7 rounded-3xl border border-slate-200/80 shadow-sm">
                <h3 class="font-black text-base text-blue-950 pb-3 border-b border-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-bullhorn text-amber-500"></i>
                    <span>Pengumuman Terkini</span>
                </h3>
                <div class="space-y-3 mt-3">
                    <% if (!pengumumanList || pengumumanList.length === 0) { %>
                        <p class="text-xs text-slate-400 py-2">Tidak ada pengumuman terbaru.</p>
                    <% } else { %>
                        <% pengumumanList.forEach(p => { %>
                            <div class="p-3.5 bg-amber-50/60 rounded-2xl border border-amber-200/60">
                                <span class="text-[10px] text-amber-800 font-bold flex items-center gap-1.5">
                                    <i class="fa-solid fa-thumbtack text-amber-600"></i>
                                    <span><%= new Date(p.tanggal_terbit).toLocaleDateString('id-ID') %></span>
                                </span>
                                <h4 class="font-bold text-xs text-slate-900 mt-1"><%= p.judul_pengumuman %></h4>
                                <p class="text-[11px] text-slate-600 mt-1 line-clamp-2 leading-relaxed"><%= p.isi_pengumuman %></p>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <!-- Kartu PPDB Cepat -->
            <div class="bg-gradient-to-br from-amber-500 to-yellow-400 text-blue-950 p-6 rounded-3xl shadow-lg border border-amber-300">
                <span class="px-2.5 py-0.5 rounded-full bg-blue-950 text-white font-black text-[10px] tracking-wider uppercase mb-2 inline-block">
                    PPDB 2026/2027
                </span>
                <h4 class="font-black text-base leading-snug">Penerimaan Siswa Baru</h4>
                <p class="text-xs text-blue-950/80 mt-1 leading-relaxed">
                    Pendaftaran dan pengecekan hasil seleksi calon siswa SMPN 1 Rantepao sudah dapat diakses online.
                </p>
                <a href="/ppdb" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2.5 bg-blue-950 hover:bg-blue-900 text-amber-400 font-bold text-xs rounded-xl shadow transition">
                    <span>Cek Alur PPDB Online</span>
                    <span>→</span>
                </a>
            </div>

            <!-- Info Kontak Singkat -->
            <div class="bg-gradient-to-br from-blue-950 to-slate-900 text-white p-6 rounded-3xl shadow-md border border-white/10">
                <h4 class="font-black text-sm text-amber-400 mb-2"><%= profil.nama_sekolah || 'SMPN 1 Rantepao' %></h4>
                <p class="text-xs text-slate-300 leading-relaxed"><%= profil.alamat || 'Jl. Sam Ratulangi No. 1, Rantepao' %></p>
                <div class="mt-4 pt-4 border-t border-white/10 text-xs text-slate-300 space-y-1.5 font-medium">
                    <p class="flex items-center gap-2"><i class="fa-solid fa-phone text-amber-400"></i><span>Telp: <%= profil.telepon || '(0423) 21123' %></span></p>
                    <p class="flex items-center gap-2"><i class="fa-solid fa-envelope text-amber-400"></i><span>Email: <%= profil.email_sekolah || 'info@smpn1rantepao.sch.id' %></span></p>
                </div>
            </div>

        </aside>

    </main>

    <!-- Unified Footer Component -->
    <%- include('partials/footer') %>

    <script>
        function shareToWA() {
            const url = window.location.href;
            const title = "<%= itemBerita.judul.replace(/"/g, '\\"') %>";
            window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(title + '\n' + url), '_blank');
        }

        function copyArticleLink() {
            navigator.clipboard.writeText(window.location.href).then(() => {
                const btn = document.getElementById('copy-btn-text');
                btn.innerHTML = '<i class="fa-solid fa-check text-emerald-600"></i><span>Tautan Disalin!</span>';
                setTimeout(() => { 
                    btn.innerHTML = '<i class="fa-solid fa-copy"></i><span>Salin Tautan</span>'; 
                }, 2000);
            });
        }
    </script>
</body>
</html>
