    <!-- CLIENT SCRIPT LOGIC -->
    <script>
        // OSIS Sidebar Mobile Drawer Controller
        function openSidebar() {
            const pane = document.getElementById('sidebar-pane');
            const backdrop = document.getElementById('osis-sidebar-backdrop');
            if (pane) pane.classList.remove('-translate-x-full');
            if (backdrop) {
                backdrop.classList.remove('opacity-0', 'pointer-events-none');
                backdrop.classList.add('opacity-100');
            }
            document.body.classList.add('overflow-hidden', 'lg:overflow-auto');
        }

        function closeSidebar() {
            const pane = document.getElementById('sidebar-pane');
            const backdrop = document.getElementById('osis-sidebar-backdrop');
            if (pane) pane.classList.add('-translate-x-full');
            if (backdrop) {
                backdrop.classList.remove('opacity-100');
                backdrop.classList.add('opacity-0', 'pointer-events-none');
            }
            document.body.classList.remove('overflow-hidden', 'lg:overflow-auto');
        }

        function toggleSidebar() {
            const pane = document.getElementById('sidebar-pane');
            if (pane && pane.classList.contains('-translate-x-full')) {
                openSidebar();
            } else {
                closeSidebar();
            }
        }

        function switchTab(tabId) {
            if (window.innerWidth < 1024) {
                closeSidebar();
            }
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            const targetEl = document.getElementById('tab-' + tabId);
            if (targetEl) {
                targetEl.classList.add('active');
            }
            document.querySelectorAll('.nav-btn').forEach(btn => {
                if (btn.dataset.tab === tabId) {
                    btn.className = 'nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-blue-900 text-white shadow-sm font-bold transition';
                } else {
                    btn.className = 'nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800 hover:text-white transition group font-semibold';
                }
            });
            // Update URL without reload
            const url = new URL(window.location);
            url.searchParams.set('tab', tabId);
            window.history.replaceState({}, '', url);
        }

        function openModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.remove('hidden');
        }

        function closeModal(id) {
            const m = document.getElementById(id);
            if (m) m.classList.add('hidden');
        }

        function previewKetuaImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('preview-foto-ketua').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Event Delegation for Edit Buttons
            document.body.addEventListener('click', function(e) {
                // Edit Pengurus
                const editPengurusBtn = e.target.closest('.btn-edit-pengurus');
                if (editPengurusBtn) {
                    document.getElementById('form-edit-pengurus').action = '/osis/pengurus/edit/' + editPengurusBtn.dataset.id;
                    document.getElementById('edit-pengurus-nama').value = editPengurusBtn.dataset.nama || '';
                    document.getElementById('edit-pengurus-jabatan').value = editPengurusBtn.dataset.jabatan || '';
                    document.getElementById('edit-pengurus-kategori').value = editPengurusBtn.dataset.kategori || 'Pengurus Inti';
                    document.getElementById('edit-pengurus-kelas').value = editPengurusBtn.dataset.kelas || '';
                    document.getElementById('edit-pengurus-motto').value = editPengurusBtn.dataset.motto || '';
                    document.getElementById('edit-pengurus-urutan').value = editPengurusBtn.dataset.urutan || 10;
                    openModal('modal-edit-pengurus');
                    return;
                }

                // Edit Proker
                const editProkerBtn = e.target.closest('.btn-edit-proker');
                if (editProkerBtn) {
                    document.getElementById('form-edit-proker').action = '/osis/proker/edit/' + editProkerBtn.dataset.id;
                    document.getElementById('edit-proker-judul').value = editProkerBtn.dataset.judul || '';
                    document.getElementById('edit-proker-kategori').value = editProkerBtn.dataset.kategori || '';
                    document.getElementById('edit-proker-icon').value = editProkerBtn.dataset.icon || 'fa-compass';
                    document.getElementById('edit-proker-jadwal').value = editProkerBtn.dataset.jadwal || '';
                    document.getElementById('edit-proker-target').value = editProkerBtn.dataset.target || '';
                    document.getElementById('edit-proker-status').value = editProkerBtn.dataset.status || 'Sedang Berjalan';
                    document.getElementById('edit-proker-deskripsi').value = editProkerBtn.dataset.deskripsi || '';
                    document.getElementById('edit-proker-urutan').value = editProkerBtn.dataset.urutan || 10;
                    openModal('modal-edit-proker');
                    return;
                }

                // Edit Mading
                const editMadingBtn = e.target.closest('.btn-edit-mading');
                if (editMadingBtn) {
                    document.getElementById('form-edit-mading').action = '/osis/mading/edit/' + editMadingBtn.dataset.id;
                    document.getElementById('edit-mading-judul').value = editMadingBtn.dataset.judul || '';
                    document.getElementById('edit-mading-kategori').value = editMadingBtn.dataset.kategori || 'Puisi Siswa';
                    document.getElementById('edit-mading-penulis').value = editMadingBtn.dataset.penulis || '';
                    document.getElementById('edit-mading-kelas').value = editMadingBtn.dataset.kelas || '';
                    document.getElementById('edit-mading-tanggal').value = editMadingBtn.dataset.tanggal || '';
                    document.getElementById('edit-mading-cuplikan').value = editMadingBtn.dataset.cuplikan || '';
                    document.getElementById('edit-mading-likes').value = editMadingBtn.dataset.likes || 0;
                    openModal('modal-edit-mading');
                    return;
                }

                // Edit Galeri
                const editGaleriBtn = e.target.closest('.btn-edit-galeri');
                if (editGaleriBtn) {
                    document.getElementById('form-edit-galeri').action = '/osis/galeri/edit/' + editGaleriBtn.dataset.id;
                    document.getElementById('edit-galeri-judul').value = editGaleriBtn.dataset.judul || '';
                    document.getElementById('edit-galeri-kategori').value = editGaleriBtn.dataset.kategori || 'Kegiatan';
                    document.getElementById('edit-galeri-tanggal').value = editGaleriBtn.dataset.tanggal || '';
                    document.getElementById('edit-galeri-keterangan').value = editGaleriBtn.dataset.keterangan || '';
                    openModal('modal-edit-galeri');
                    return;
                }
            });

            // Activate initial tab from URL
            const urlParams = new URLSearchParams(window.location.search);
            const initialTab = urlParams.get('tab') || 'overview';
            switchTab(initialTab);
        });
    </script>
