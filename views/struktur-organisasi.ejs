<!DOCTYPE html>
<html lang="id" class="scroll-smooth">

<head>
    <%- include('partials/head', { title: (typeof title !== 'undefined' && title) ? title : ('Struktur Organisasi - ' + (profil.nama_sekolah || 'UPT SMPN 1 Rantepao')) }) %>
</head>

<body class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen selection:bg-amber-500 selection:text-blue-950">

    <!-- Navbar Global -->
    <%- include('partials/navbar', { activePage: 'profil' }) %>

    <!-- ============================================================== -->
    <!-- 1. SUB-HERO BANNER & LIVE SEARCH BAR -->
    <!-- ============================================================== -->
    <section class="relative bg-gradient-to-br from-blue-950 via-blue-900 to-slate-900 text-white pt-14 pb-24 sm:pt-16 sm:pb-28 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Ambient Background Glow Circles -->
        <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-blue-600/20 blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/2 -right-24 w-80 h-80 rounded-full bg-amber-500/15 blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-amber-500/10 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto relative z-10 text-center">

            <!-- Breadcrumbs Navigation -->
            <nav class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs text-slate-300 mb-5" data-aos="fade-down" data-aos-duration="600">
                <a href="/" class="hover:text-amber-400 transition-colors font-medium">Beranda</a>
                <span class="text-slate-500 text-[10px]">/</span>
                <span class="text-slate-300">Profil</span>
                <span class="text-slate-500 text-[10px]">/</span>
                <span class="text-amber-400 font-bold">Struktur Organisasi</span>
            </nav>

            <!-- Badge Tata Kelola -->
            <div data-aos="fade-up" data-aos-duration="700">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/40 text-amber-300 text-xs font-black uppercase tracking-wider backdrop-blur-md mb-4 shadow-sm shadow-amber-500/10">
                    <i class="fa-solid fa-sitemap text-amber-400"></i>
                    <span>Tata Kelola &amp; Kepemimpinan</span>
                </span>
            </div>

            <!-- Big Page Title -->
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight" data-aos="fade-up" data-aos-duration="800">
                <%= (typeof strukturInfo !== 'undefined' && strukturInfo.judul) ? strukturInfo.judul : 'Struktur Organisasi Sekolah' %>
            </h1>

            <!-- Subtitle -->
            <p class="mt-3.5 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-duration="900">
                <%= (typeof strukturInfo !== 'undefined' && strukturInfo.keterangan) ? strukturInfo.keterangan : 'Bagan hierarki kepemimpinan, koordinasi kelembagaan, pembagian wewenang manajerial, serta tata kelola administrasi akademik dan kesiswaan di lingkungan UPT SMP Negeri 1 Rantepao.' %>
            </p>

            <!-- Periode Pill -->
            <div class="mt-4" data-aos="fade-up" data-aos-duration="950">
                <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/15 text-amber-300 text-xs font-bold backdrop-blur-sm">
                    <i class="fa-solid fa-calendar-check"></i>
                    <span>Periode: <%= (typeof strukturInfo !== 'undefined' && strukturInfo.periode) ? strukturInfo.periode : 'Tahun Ajaran 2025/2026' %></span>
                </span>
            </div>

            <!-- Large Capsule Search Bar -->
            <div class="mt-8 max-w-2xl mx-auto px-2" data-aos="fade-up" data-aos-duration="1000">
                <div class="relative bg-white rounded-full shadow-2xl p-2 sm:p-2.5 flex items-center border border-white/30 focus-within:ring-4 focus-within:ring-amber-400/50 transition-all duration-300 group">
                    <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-blue-950 text-amber-400 flex items-center justify-center shrink-0 text-base shadow-md group-focus-within:bg-amber-500 group-focus-within:text-blue-950 transition-colors duration-300">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <input type="text" id="strukturSearchInput"
                        placeholder="Cari nama pejabat, NIP, atau jabatan struktural..."
                        class="w-full bg-transparent border-none text-slate-800 placeholder-slate-400 text-xs sm:text-sm font-semibold px-4 py-2 focus:outline-none"
                        autocomplete="off">
                    <button type="button" id="strukturClearBtn"
                        class="hidden text-slate-400 hover:text-rose-500 px-3 py-1.5 text-sm transition focus:outline-none cursor-pointer"
                        title="Hapus Pencarian">
                        <i class="fa-solid fa-circle-xmark text-base"></i>
                    </button>
                </div>
            </div>

        </div>

        <!-- Wave SVG Divider -->
        <div class="absolute bottom-0 left-0 right-0 leading-none z-10 pointer-events-none">
            <svg class="w-full h-8 sm:h-12 text-slate-50 fill-current" viewBox="0 0 1440 80" preserveAspectRatio="none">
                <path d="M0,32L80,42.7C160,53,320,75,480,74.7C640,75,800,53,960,42.7C1120,32,1280,32,1360,32L1440,32L1440,80L1360,80C1280,80,1120,80,960,80C800,80,640,80,480,80C320,80,160,80,80,80L0,80Z"></path>
            </svg>
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- 2. KONTEN UTAMA: BAGAN STRUKTUR ORGANISASI VISUAL -->
    <!-- ============================================================== -->
    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full space-y-16">

        <!-- KARTU BAGAN VISUAL BESAR -->
        <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-950 rounded-3xl p-5 sm:p-8 text-white shadow-2xl border border-blue-900/40 relative overflow-hidden" data-aos="fade-up">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 mb-5 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <span class="w-12 h-12 rounded-2xl bg-amber-500 text-blue-950 font-black flex items-center justify-center text-xl shadow-lg shadow-amber-500/20">
                        <i class="fa-solid fa-network-wired"></i>
                    </span>
                    <div>
                        <h2 class="font-extrabold text-lg sm:text-xl text-white">Bagan Visual Alur Koordinasi &amp; Komando</h2>
                        <p class="text-xs text-slate-300">Struktur Hierarki Kepemimpinan <%= profil.nama_sekolah || 'UPT SMPN 1 Rantepao' %></p>
                    </div>
                </div>
                <div class="flex items-center gap-2 self-stretch sm:self-auto">
                    <button type="button" onclick="openBaganModal()" class="flex-1 sm:flex-initial px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-blue-950 font-extrabold text-xs transition-all shadow-md shadow-amber-500/20 flex items-center justify-center gap-2 cursor-pointer">
                        <i class="fa-solid fa-maximize"></i>
                        <span>Perbesar Layar Penuh</span>
                    </button>
                    <% 
                    const baganFile = (typeof strukturInfo !== 'undefined' && strukturInfo.foto_bagan) 
                        ? ('/uploads/struktur/' + strukturInfo.foto_bagan) 
                        : '/img/default-bagan-struktur.svg'; 
                    %>
                    <a href="<%= baganFile %>" download="Bagan_Struktur_Organisasi_SMPN1_Rantepao" class="px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/15 transition-all flex items-center justify-center gap-2">
                        <i class="fa-solid fa-download"></i>
                        <span class="hidden sm:inline">Unduh Bagan</span>
                    </a>
                </div>
            </div>

            <!-- Gambar Bagan dengan Interaksi Klik Zoom -->
            <div onclick="openBaganModal()" class="relative rounded-2xl overflow-hidden bg-slate-950/80 border border-white/10 cursor-pointer group flex items-center justify-center min-h-[340px] sm:min-h-[500px]">
                <img id="bagan-img-display" src="<%= baganFile %>" alt="Bagan Struktur Organisasi" class="w-full h-auto max-h-[650px] object-contain group-hover:scale-[1.01] transition-transform duration-500">
                <div class="absolute inset-0 bg-blue-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2 backdrop-blur-[2px]">
                    <span class="px-5 py-2.5 rounded-full bg-amber-500 text-blue-950 font-black text-xs shadow-xl flex items-center gap-2">
                        <i class="fa-solid fa-magnifying-glass-plus text-sm"></i>
                        <span>Klik untuk Melihat Tampilan Resolusi Penuh</span>
                    </span>
                </div>
            </div>
        </div>

        <!-- ============================================================== -->
        <!-- 3. DAFTAR PEJABAT & PERSONIL STRUKTURAL -->
        <!-- ============================================================== -->
        <section class="space-y-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-4 border-b border-slate-200">
                <div>
                    <span class="text-xs font-black text-amber-600 uppercase tracking-widest bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
                        Jajaran Pejabat
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-black text-blue-950 mt-2">Daftar Pejabat &amp; Personil Struktural</h2>
                    <p class="text-xs sm:text-sm text-slate-500 mt-1">Pimpinan, wakil kepala sekolah, koordinator unit, dan tenaga administrasi</p>
                </div>

                <!-- Filter Kategori Kapsul -->
                <div class="flex flex-wrap items-center gap-1.5 p-1.5 bg-slate-100 rounded-2xl border border-slate-200">
                    <button type="button" onclick="filterKategori('semua')" class="cat-filter-btn active px-3 py-1.5 rounded-xl text-xs font-bold transition-all bg-blue-950 text-white shadow-sm cursor-pointer">Semua</button>
                    <button type="button" onclick="filterKategori('Pimpinan')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-blue-950 transition-all cursor-pointer">Pimpinan</button>
                    <button type="button" onclick="filterKategori('Wakil Kepala Sekolah')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-blue-950 transition-all cursor-pointer">Wakasek</button>
                    <button type="button" onclick="filterKategori('Tata Usaha')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-blue-950 transition-all cursor-pointer">Tata Usaha</button>
                    <button type="button" onclick="filterKategori('Koordinator')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold text-slate-600 hover:text-blue-950 transition-all cursor-pointer">Koordinator</button>
                </div>
            </div>

            <!-- Grid Personil Cards -->
            <div id="grid-pejabat-struktur" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                <% if (typeof strukturAnggota !== 'undefined' && strukturAnggota.length > 0) { %>
                    <% strukturAnggota.forEach((p, idx) => { %>
                        <div class="pejabat-card bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between group"
                             data-nama="<%= p.nama_lengkap.toLowerCase() %>"
                             data-nip="<%= (p.nip || '').toLowerCase() %>"
                             data-jabatan="<%= p.jabatan.toLowerCase() %>"
                             data-kategori="<%= p.kategori || 'Pimpinan' %>"
                             data-aos="fade-up" data-aos-delay="<%= (idx % 4) * 80 %>">
                            <div>
                                <!-- Photo Frame -->
                                <div class="relative w-28 h-28 mx-auto mb-5">
                                    <div class="w-full h-full rounded-full p-1 border-2 border-amber-400 shadow-md group-hover:scale-105 transition-transform duration-300 overflow-hidden bg-blue-950 flex items-center justify-center text-amber-400 font-bold">
                                        <% 
                                        let photoPath = '/img/default-avatar.svg';
                                        if (p.foto && p.foto.trim() !== '') {
                                            if (p.foto.startsWith('foto_kepsek')) {
                                                photoPath = '/uploads/profil/' + p.foto;
                                            } else if (p.foto.startsWith('foto_komite')) {
                                                photoPath = '/uploads/komite/' + p.foto;
                                            } else if (p.foto.startsWith('foto-')) {
                                                photoPath = '/uploads/guru/' + p.foto;
                                            } else {
                                                photoPath = '/uploads/struktur/' + p.foto;
                                            }
                                        }
                                        %>
                                        <img src="<%= photoPath %>" alt="<%= p.nama_lengkap %>" class="w-full h-full object-cover rounded-full" onerror="this.onerror=null; this.src='/img/default-avatar.svg';">
                                    </div>
                                    <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider shadow-sm <%= p.kategori === 'Pimpinan' ? 'bg-amber-500 text-blue-950' : 'bg-blue-900 text-white' %> whitespace-nowrap">
                                        <%= p.kategori || 'Pimpinan' %>
                                    </span>
                                </div>

                                <!-- Nama & Jabatan -->
                                <div class="text-center pt-1">
                                    <h3 class="font-extrabold text-base text-blue-950 group-hover:text-amber-600 transition-colors line-clamp-2">
                                        <%= p.nama_lengkap %>
                                    </h3>
                                    <p class="text-xs font-semibold text-amber-600 mt-1">
                                        <%= p.jabatan %>
                                    </p>
                                    <% if (p.nip && p.nip !== '-' && p.nip.trim() !== '') { %>
                                        <p class="text-[11px] text-slate-400 mt-1 font-mono">
                                            NIP: <%= p.nip %>
                                        </p>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-16 text-center text-slate-400 bg-white rounded-3xl border border-slate-200">
                        <i class="fa-solid fa-users text-4xl text-slate-300 mb-3"></i>
                        <p class="text-sm font-semibold">Data pejabat struktur organisasi belum diinput.</p>
                    </div>
                <% } %>
            </div>

            <!-- Not Found State for Search -->
            <div id="no-search-results" class="hidden py-16 text-center text-slate-400 bg-white rounded-3xl border border-slate-200">
                <i class="fa-solid fa-user-slash text-4xl text-slate-300 mb-3"></i>
                <p class="text-sm font-semibold text-slate-600">Pejabat atau jabatan struktural tidak ditemukan.</p>
                <p class="text-xs text-slate-400 mt-1">Coba gunakan kata kunci pencarian yang lain.</p>
            </div>
        </section>

    </main>

    <!-- LIGHTBOX MODAL UNTUK PERBESAR BAGAN STRUKTUR ORGANISASI -->
    <div id="modal-bagan-lightbox" class="fixed inset-0 z-50 hidden bg-slate-950/90 backdrop-blur-md p-4 sm:p-8 flex flex-col items-center justify-center transition-all duration-300">
        <div class="w-full max-w-6xl max-h-[92vh] flex flex-col bg-slate-900 rounded-3xl border border-white/20 shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            <!-- Modal Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/10 bg-slate-950">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-sitemap text-amber-400 text-lg"></i>
                    <div>
                        <h3 class="text-sm sm:text-base font-extrabold text-white">Bagan Struktur Organisasi Sekolah</h3>
                        <p class="text-[11px] text-slate-400"><%= (typeof strukturInfo !== 'undefined' && strukturInfo.periode) ? strukturInfo.periode : 'Tahun Ajaran 2025/2026' %></p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <a href="<%= baganFile %>" download="Bagan_Struktur_Organisasi_SMPN1_Rantepao" class="px-3.5 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-blue-950 font-bold text-xs transition flex items-center gap-1.5 shadow">
                        <i class="fa-solid fa-download"></i>
                        <span>Unduh File</span>
                    </a>
                    <button type="button" onclick="closeBaganModal()" class="w-9 h-9 rounded-xl bg-white/10 hover:bg-red-500/80 text-white font-bold flex items-center justify-center transition cursor-pointer">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
            </div>
            <!-- Modal Image View -->
            <div class="p-4 sm:p-6 overflow-auto flex-1 flex items-center justify-center bg-slate-950">
                <img src="<%= baganFile %>" alt="Bagan Struktur Organisasi Resolusi Penuh" class="max-w-full max-h-[75vh] object-contain rounded-xl shadow-lg">
            </div>
        </div>
    </div>

    <!-- Footer Global -->
    <%- include('partials/footer') %>

    <!-- CLIENT SCRIPT UNTUK SEARCH & FILTER -->
    <script>
        function openBaganModal() {
            const modal = document.getElementById('modal-bagan-lightbox');
            if (modal) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
        }
        function closeBaganModal() {
            const modal = document.getElementById('modal-bagan-lightbox');
            if (modal) {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('modal-bagan-lightbox');
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) closeBaganModal();
                });
            }

            const searchInput = document.getElementById('strukturSearchInput');
            const clearBtn = document.getElementById('strukturClearBtn');
            const cards = document.querySelectorAll('.pejabat-card');
            const noResults = document.getElementById('no-search-results');

            let currentKategori = 'semua';

            function applyFilter() {
                const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
                let visibleCount = 0;

                cards.forEach(card => {
                    const nama = card.dataset.nama || '';
                    const nip = card.dataset.nip || '';
                    const jabatan = card.dataset.jabatan || '';
                    const kategori = card.dataset.kategori || '';

                    const matchesQuery = !query || nama.includes(query) || nip.includes(query) || jabatan.includes(query);
                    const matchesCategory = (currentKategori === 'semua') || (kategori.toLowerCase() === currentKategori.toLowerCase());

                    if (matchesQuery && matchesCategory) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResults) {
                    noResults.classList.toggle('hidden', visibleCount > 0);
                }

                if (clearBtn) {
                    clearBtn.classList.toggle('hidden', !query);
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', applyFilter);
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    searchInput.value = '';
                    applyFilter();
                    searchInput.focus();
                });
            }

            window.filterKategori = function(kat) {
                currentKategori = kat;
                document.querySelectorAll('.cat-filter-btn').forEach(btn => {
                    btn.classList.remove('bg-blue-950', 'text-white', 'shadow-sm');
                    btn.classList.add('text-slate-600');
                });
                const clicked = event.target;
                if (clicked) {
                    clicked.classList.remove('text-slate-600');
                    clicked.classList.add('bg-blue-950', 'text-white', 'shadow-sm');
                }
                applyFilter();
            };
        });
    </script>
</body>
</html>

