    <!-- CLIENT JAVASCRIPT LOGIC -->
    <script>
        // Tab switching logic
        const tabTitles = {
            'overview': 'Dashboard Overview',
            'berita': 'Kelola Berita & Publikasi Sekolah',
            'pengumuman': 'Kelola Pengumuman Resmi Sekolah',
            'kalender': 'Kelola Kalender Akademik',
            'guru': 'Kelola Tenaga Pendidik & Kependidikan',
            'komite': 'Kelola Komite Sekolah',
            'struktur': 'Kelola Bagan & Struktur Organisasi',
            'ppdb': 'Kelola Penerimaan Peserta Didik Baru (PPDB 2026/2027)',
            'eskul': 'Kelola Ekstrakurikuler Siswa',
            'galeri': 'Kelola Galeri Dokumentasi Foto',
            'profil': 'Edit Profil & Informasi Sekolah',
            'halaman-statis': 'Kelola Halaman Informasi & Sarana Sekolah',
            'pesan': 'Kotak Masuk Pesan Pengunjung'
        };



        function switchTab(tabId) {
            if (window.innerWidth < 768) {
                closeSidebar();
            }
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white');
                btn.classList.add('text-slate-300');
            });

            const targetEl = document.getElementById('tab-' + tabId);
            if (targetEl) {
                targetEl.classList.add('active');
            }

            const activeBtn = document.querySelector(`.nav-btn[data-tab="${tabId}"]`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-300');
                activeBtn.classList.add('bg-blue-600', 'text-white');
            }

            const titleEl = document.getElementById('topbar-title');
            if (titleEl && tabTitles[tabId]) {
                titleEl.textContent = tabTitles[tabId];
            }

            window.location.hash = tabId;
        }

        // Modal Handlers
        function openModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('hidden');
        }

        function closeModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        }

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('[id^="modal-"]').forEach(el => el.classList.add('hidden'));
            }
        });

        // Event Delegation for Edit & Detail Modals (Prevents any auto-formatter regex breaking!)
        document.addEventListener('click', function(e) {
            // 0. Edit Hero Slider
            const editSliderBtn = e.target.closest('.btn-edit-slider');
            if (editSliderBtn) {
                document.getElementById('form-edit-slider').action = '/admin/slider/edit/' + editSliderBtn.dataset.id;
                document.getElementById('edit-slider-judul').value = editSliderBtn.dataset.judul || '';
                document.getElementById('edit-slider-deskripsi').value = editSliderBtn.dataset.deskripsi || '';
                document.getElementById('edit-slider-teks-tombol').value = editSliderBtn.dataset.tekstombol || '';
                document.getElementById('edit-slider-link-tombol').value = editSliderBtn.dataset.linktombol || '';
                document.getElementById('edit-slider-urutan').value = editSliderBtn.dataset.urutan || 1;
                document.getElementById('edit-slider-status').value = editSliderBtn.dataset.status || 'Aktif';

                const imgContainer = document.getElementById('edit-slider-preview-container');
                const imgTag = document.getElementById('edit-slider-preview-img');
                const currentImg = editSliderBtn.dataset.gambar;
                if (currentImg && imgContainer && imgTag) {
                    imgTag.src = currentImg.startsWith('http') ? currentImg : (currentImg.startsWith('/') ? currentImg : '/' + currentImg);
                    imgContainer.classList.remove('hidden');
                } else if (imgContainer) {
                    imgContainer.classList.add('hidden');
                }

                openModal('modal-edit-slider');
                return;
            }

            // 1. Edit Berita
            const editBeritaBtn = e.target.closest('.btn-edit-berita');
            if (editBeritaBtn) {
                document.getElementById('form-edit-berita').action = '/admin/berita/edit/' + editBeritaBtn.dataset.id;
                document.getElementById('edit-berita-judul').value = editBeritaBtn.dataset.judul;
                document.getElementById('edit-berita-kategori').value = editBeritaBtn.dataset.kategori;
                document.getElementById('edit-berita-isi').value = editBeritaBtn.dataset.isi;
                document.getElementById('edit-berita-status').value = editBeritaBtn.dataset.status;
                openModal('modal-edit-berita');
                return;
            }

            // 2. Edit Pengumuman
            const editPengumumanBtn = e.target.closest('.btn-edit-pengumuman');
            if (editPengumumanBtn) {
                document.getElementById('form-edit-pengumuman').action = '/admin/pengumuman/edit/' + editPengumumanBtn.dataset.id;
                document.getElementById('edit-pengumuman-judul').value = editPengumumanBtn.dataset.judul;
                document.getElementById('edit-pengumuman-isi').value = editPengumumanBtn.dataset.isi;
                document.getElementById('edit-pengumuman-tanggal').value = editPengumumanBtn.dataset.tanggal;
                openModal('modal-edit-pengumuman');
                return;
            }

            // Edit Kalender Akademik
            const editKalenderBtn = e.target.closest('.btn-edit-kalender');
            if (editKalenderBtn) {
                document.getElementById('form-edit-kalender').action = '/admin/kalender/edit/' + editKalenderBtn.dataset.id;
                document.getElementById('edit-kalender-judul').value = editKalenderBtn.dataset.judul;
                document.getElementById('edit-kalender-mulai').value = editKalenderBtn.dataset.mulai;
                document.getElementById('edit-kalender-selesai').value = editKalenderBtn.dataset.selesai || '';
                document.getElementById('edit-kalender-kategori').value = editKalenderBtn.dataset.kategori;
                document.getElementById('edit-kalender-warna').value = editKalenderBtn.dataset.warna;
                document.getElementById('edit-kalender-lokasi').value = editKalenderBtn.dataset.lokasi || '';
                document.getElementById('edit-kalender-deskripsi').value = editKalenderBtn.dataset.deskripsi || '';
                document.getElementById('edit-kalender-urutan').value = editKalenderBtn.dataset.urutan || 0;
                openModal('modal-edit-kalender');
                return;
            }

            // 3. Edit Guru
            const editGuruBtn = e.target.closest('.btn-edit-guru');
            if (editGuruBtn) {
                document.getElementById('form-edit-guru').action = '/admin/guru/edit/' + editGuruBtn.dataset.id;
                document.getElementById('edit-guru-nama').value = editGuruBtn.dataset.nama;
                document.getElementById('edit-guru-nip').value = editGuruBtn.dataset.nip;
                document.getElementById('edit-guru-jk').value = editGuruBtn.dataset.jk;
                document.getElementById('edit-guru-jabatan').value = editGuruBtn.dataset.jabatan;
                document.getElementById('edit-guru-kategori').value = editGuruBtn.dataset.kategori;
                document.getElementById('edit-guru-urutan').value = editGuruBtn.dataset.urutan;
                document.getElementById('edit-guru-status').value = editGuruBtn.dataset.status;
                openModal('modal-edit-guru');
                return;
            }

            // 3b. Edit Komite Sekolah
            const editKomiteBtn = e.target.closest('.btn-edit-komite');
            if (editKomiteBtn) {
                openEditKomite(editKomiteBtn);
                return;
            }

            // 4. Detail Pesan
            const detailPesanBtn = e.target.closest('.btn-detail-pesan');
            if (detailPesanBtn) {
                document.getElementById('detail-pesan-pengirim').textContent = detailPesanBtn.dataset.pengirim;
                document.getElementById('detail-pesan-kontak').textContent = detailPesanBtn.dataset.kontak;
                document.getElementById('detail-pesan-subjek').textContent = detailPesanBtn.dataset.subjek;
                document.getElementById('detail-pesan-isi').textContent = detailPesanBtn.dataset.isi;
                document.getElementById('detail-pesan-tanggal').textContent = detailPesanBtn.dataset.tanggal;
                openModal('modal-lihat-pesan');
                return;
            }

            // 5. Edit Ekstrakurikuler
            const editEskulBtn = e.target.closest('.btn-edit-eskul');
            if (editEskulBtn) {
                document.getElementById('form-edit-eskul').action = '/admin/eskul/edit/' + editEskulBtn.dataset.id;
                document.getElementById('edit-eskul-nama').value = editEskulBtn.dataset.nama;
                document.getElementById('edit-eskul-pembina').value = editEskulBtn.dataset.pembina;
                document.getElementById('edit-eskul-jadwal').value = editEskulBtn.dataset.jadwal;
                document.getElementById('edit-eskul-deskripsi').value = editEskulBtn.dataset.deskripsi;
                openModal('modal-edit-eskul');
                return;
            }

            // 6. Edit Galeri Foto
            const editGaleriBtn = e.target.closest('.btn-edit-galeri');
            if (editGaleriBtn) {
                document.getElementById('form-edit-galeri').action = '/admin/galeri/edit/' + editGaleriBtn.dataset.id;
                document.getElementById('edit-galeri-judul').value = editGaleriBtn.dataset.judul;
                document.getElementById('edit-galeri-kategori').value = editGaleriBtn.dataset.kategori;
                document.getElementById('edit-galeri-tanggal').value = editGaleriBtn.dataset.tgl;
                document.getElementById('edit-galeri-deskripsi').value = editGaleriBtn.dataset.deskripsi;
                openModal('modal-edit-galeri');
                return;
            }

            // Edit Struktur Organisasi
            const editStrukturBtn = e.target.closest('.btn-edit-struktur');
            if (editStrukturBtn) {
                document.getElementById('form-edit-struktur').action = '/admin/struktur-organisasi/anggota/edit/' + editStrukturBtn.dataset.id;
                document.getElementById('edit-struktur-nama').value = editStrukturBtn.dataset.nama || '';
                document.getElementById('edit-struktur-nip').value = editStrukturBtn.dataset.nip || '';
                document.getElementById('edit-struktur-jabatan').value = editStrukturBtn.dataset.jabatan || '';
                document.getElementById('edit-struktur-kategori').value = editStrukturBtn.dataset.kategori || 'Pimpinan';
                document.getElementById('edit-struktur-urutan').value = editStrukturBtn.dataset.urutan || 1;
                openModal('modal-edit-struktur');
                return;
            }

            // 7. Detail Pendaftar PPDB
            const detailPPDBBtn = e.target.closest('.btn-detail-ppdb');
            if (detailPPDBBtn) {
                document.getElementById('detail-ppdb-no').textContent = detailPPDBBtn.dataset.no;
                document.getElementById('detail-ppdb-nama').textContent = detailPPDBBtn.dataset.nama;
                document.getElementById('detail-ppdb-nisn').textContent = detailPPDBBtn.dataset.nisn;
                document.getElementById('detail-ppdb-jk').textContent = detailPPDBBtn.dataset.jk;
                document.getElementById('detail-ppdb-sekolah').textContent = detailPPDBBtn.dataset.sekolah;
                document.getElementById('detail-ppdb-jalur').textContent = 'Jalur ' + detailPPDBBtn.dataset.jalur;
                document.getElementById('detail-ppdb-ortu').textContent = detailPPDBBtn.dataset.ortu;
                document.getElementById('detail-ppdb-hp').textContent = detailPPDBBtn.dataset.hp;
