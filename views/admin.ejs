                                <span>Builder Kartu / Item (<span id="builder-item-counter">0</span>)</span>
                            </button>
                            <button type="button" id="tab-btn-wysiwyg" onclick="switchHalamanContentMode('wysiwyg')" class="px-3 py-1.5 rounded-lg text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5 cursor-pointer">
                                <i class="fa-solid fa-align-left text-xs"></i>
                                <span>Editor Bebas (WYSIWYG)</span>
