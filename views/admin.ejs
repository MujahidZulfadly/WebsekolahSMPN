                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB: KELOLA KALENDER AKADEMIK & AGENDA -->
            <!-- ============================================== -->
            <div id="tab-kalender" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-calendar-days text-amber-500"></i>
                                <span>Kalender Akademik & Agenda Sekolah</span>
                            </h3>
                            <p class="text-xs text-slate-400">Kelola jadwal ujian, hari libur, kegiatan sekolah, dan agenda rapat</p>
                        </div>
                        <button type="button" onclick="openModal('modal-tambah-kalender')"
                            class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 self-start sm:self-auto">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            <span>Tambah Agenda Baru</span>
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Tanggal Pelaksanaan</th>
                                    <th class="py-3 px-4">Judul Kegiatan</th>
                                    <th class="py-3 px-4">Kategori</th>
                                    <th class="py-3 px-4">Lokasi</th>
                                    <th class="py-3 px-4">Keterangan</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% const kalenderList = (typeof kalender !== 'undefined' && kalender) ? kalender : []; %>
                                <% if (kalenderList.length === 0) { %>
                                    <tr>
                                        <td colspan="6" class="py-8 text-center text-xs text-slate-400">Belum ada agenda kalender akademik yang dibuat.</td>
                                    </tr>
                                <% } %>
                                <% kalenderList.forEach(k => { %>
                                    <% 
                                        const d1 = new Date(k.tanggal_mulai);
                                        const d2 = k.tanggal_selesai ? new Date(k.tanggal_selesai) : null;
                                        let badgeClass = 'bg-blue-50 text-blue-700 border-blue-200';
                                        if (k.warna_badge === 'rose') badgeClass = 'bg-rose-50 text-rose-700 border-rose-200';
                                        if (k.warna_badge === 'emerald') badgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                                        if (k.warna_badge === 'amber') badgeClass = 'bg-amber-50 text-amber-800 border-amber-200';
                                        if (k.warna_badge === 'purple') badgeClass = 'bg-purple-50 text-purple-700 border-purple-200';
                                    %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3 px-4 text-xs font-mono whitespace-nowrap text-slate-700">
                                            <% if (d2 && d2.getTime() !== d1.getTime()) { %>
                                                <span class="font-bold"><%= d1.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %></span> - <span class="font-bold"><%= d2.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                            <% } else { %>
                                                <span class="font-bold"><%= d1.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                            <% } %>
                                        </td>
                                        <td class="py-3 px-4 font-bold text-slate-800 text-xs">
                                            <%= k.judul_kegiatan %>
                                        </td>
                                        <td class="py-3 px-4 whitespace-nowrap">
                                            <span class="text-[10px] font-extrabold uppercase px-2.5 py-0.5 rounded-full border <%= badgeClass %>">
                                                <%= k.kategori %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">
                                            <%= k.lokasi || '-' %>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 max-w-xs">
                                            <p class="line-clamp-2"><%= k.deskripsi || '-' %></p>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button"
                                                    class="btn-edit-kalender p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition"
                                                    title="Edit Agenda"
                                                    data-id="<%= k.id %>"
                                                    data-judul="<%= k.judul_kegiatan %>"
                                                    data-deskripsi="<%= k.deskripsi || '' %>"
                                                    data-mulai="<%= new Date(k.tanggal_mulai).toISOString().split('T')[0] %>"
                                                    data-selesai="<%= k.tanggal_selesai ? new Date(k.tanggal_selesai).toISOString().split('T')[0] : '' %>"
                                                    data-kategori="<%= k.kategori %>"
                                                    data-warna="<%= k.warna_badge %>"
                                                    data-lokasi="<%= k.lokasi || '' %>"
                                                    data-urutan="<%= k.urutan || 0 %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                                    </svg>
                                                </button>
                                                <form action="/admin/kalender/hapus/<%= k.id %>" method="POST"
                                                    onsubmit="return confirm('Apakah Anda yakin ingin menghapus agenda kalender ini?')">
                                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Agenda">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                        </svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

