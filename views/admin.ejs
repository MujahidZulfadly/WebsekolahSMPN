                            <div class="flex items-center gap-2">
                                <!-- Pilihan Model Layout Kartu -->
                                <div class="flex items-center gap-1 text-[11px] text-slate-600 font-semibold bg-slate-100 px-2 py-1 rounded-xl border border-slate-200">
                                    <span>Model:</span>
                                    <select id="edit-halaman-layout-type" onchange="changeHalamanLayoutType(this.value)" class="bg-transparent text-xs font-bold text-blue-950 focus:outline-none cursor-pointer">
