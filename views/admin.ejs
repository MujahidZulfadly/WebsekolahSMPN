                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Status Seleksi *</label>
                        <select id="edit-ppdb-status" name="status_seleksi" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white">
                            <option value="Menunggu Verifikasi">Menunggu Verifikasi</option>
                            <option value="Berkas Terverifikasi">Berkas Terverifikasi</option>
                            <option value="Diterima">Diterima</option>
                            <option value="Tidak Diterima">Tidak Diterima</option>
                        </select>
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Nama Orang Tua / Wali *</label>
                        <input type="text" id="edit-ppdb-ortu" name="nama_ortu" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">No. WhatsApp / HP *</label>
                        <input type="text" id="edit-ppdb-hp" name="no_hp" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Alamat Domisili Siswa *</label>
                    <input type="text" id="edit-ppdb-alamat" name="alamat_domisili" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                </div>

                <div>
                    <label class="block font-semibold text-slate-600 mb-1">Catatan Khusus</label>
                    <textarea id="edit-ppdb-catatan" name="catatan" rows="2" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600"></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modal-edit-ppdb')" class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Batal</button>
                    <button type="submit" class="px-5 py-2 font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ============================================== -->
    <!-- MODAL PENGATURAN PPDB & GELOMBANG -->
    <!-- ============================================== -->
    <div id="modal-pengaturan-ppdb" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div>
                    <h3 class="font-bold text-base sm:text-lg text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-indigo-600"></i>
                        <span>Pengaturan Loket & Kuota PPDB</span>
                    </h3>
                    <p class="text-xs text-slate-400 mt-0.5">Atur status buka/tutup loket, daya tampung kuota jalur seleksi, dan tanggal pendaftaran</p>
                </div>
                <button type="button" onclick="closeModal('modal-pengaturan-ppdb')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form action="/admin/ppdb/pengaturan" method="POST" class="space-y-4 mt-4 text-xs">
                <% 
                   const pSetting = (typeof ppdbSetting !== 'undefined') ? ppdbSetting : {};
                   const formatDate = (val) => {
                       if (!val) return '';
                       if (typeof val === 'string') return val.substring(0, 10);
                       if (val instanceof Date) return val.toISOString().split('T')[0];
                       return '';
                   };
                %>
                <div class="grid sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Status Loket Pendaftaran *</label>
                        <select name="status_loket" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white font-bold text-slate-800">
                            <option value="Buka" <%= (pSetting.status_loket === 'Buka') ? 'selected' : '' %>>🟢 Buka (Pendaftaran Aktif)</option>
                            <option value="Verifikasi" <%= (pSetting.status_loket === 'Verifikasi') ? 'selected' : '' %>>🟡 Verifikasi Berkas</option>
                            <option value="Pengumuman" <%= (pSetting.status_loket === 'Pengumuman') ? 'selected' : '' %>>🔵 Pengumuman Hasil</option>
                            <option value="Daftar Ulang" <%= (pSetting.status_loket === 'Daftar Ulang') ? 'selected' : '' %>>🟣 Daftar Ulang</option>
                            <option value="Tutup" <%= (pSetting.status_loket === 'Tutup') ? 'selected' : '' %>>🔴 Tutup</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Tahun Ajaran *</label>
                        <input type="text" name="tahun_ajaran" value="<%= pSetting.tahun_ajaran || '2026/2027' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Nama Gelombang *</label>
                        <input type="text" name="nama_gelombang" value="<%= pSetting.nama_gelombang || 'Gelombang 1 (Reguler & Zonasi)' %>" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                </div>

                <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3">
                    <h4 class="font-bold text-slate-700 text-[11px] uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-users-line text-blue-600"></i>
                        <span>Daya Tampung / Kuota Jalur Seleksi (Jumlah Siswa)</span>
                    </h4>
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Kuota Total</label>
                            <input type="number" name="kuota_total" value="<%= pSetting.kuota_total || 320 %>" required class="w-full border border-slate-300 rounded-lg px-2.5 py-2 font-bold text-blue-900 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Zonasi (50%)</label>
                            <input type="number" name="kuota_zonasi" value="<%= pSetting.kuota_zonasi || 160 %>" required class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Prestasi (30%)</label>
                            <input type="number" name="kuota_prestasi" value="<%= pSetting.kuota_prestasi || 96 %>" required class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Afirmasi (15%)</label>
                            <input type="number" name="kuota_afirmasi" value="<%= pSetting.kuota_afirmasi || 48 %>" required class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Mutasi (5%)</label>
                            <input type="number" name="kuota_mutasi" value="<%= pSetting.kuota_mutasi || 16 %>" required class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                    </div>
                </div>

                <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200/80 space-y-3">
                    <h4 class="font-bold text-slate-700 text-[11px] uppercase tracking-wider flex items-center gap-1.5">
                        <i class="fa-solid fa-calendar-days text-amber-600"></i>
                        <span>Jadwal Pelaksanaan PPDB</span>
                    </h4>
                    <div class="grid sm:grid-cols-4 gap-3">
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Mulai Pendaftaran</label>
                            <input type="date" name="tgl_mulai_daftar" value="<%= formatDate(pSetting.tgl_mulai_daftar) %>" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Batas Pendaftaran</label>
                            <input type="date" name="tgl_selesai_daftar" value="<%= formatDate(pSetting.tgl_selesai_daftar) %>" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Pengumuman Hasil</label>
                            <input type="date" name="tgl_pengumuman" value="<%= formatDate(pSetting.tgl_pengumuman) %>" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">Daftar Ulang</label>
                            <input type="date" name="tgl_daftar_ulang" value="<%= formatDate(pSetting.tgl_daftar_ulang) %>" class="w-full border border-slate-300 rounded-lg px-2.5 py-2 focus:outline-blue-600">
                        </div>
                    </div>
                </div>

                <div class="grid sm:grid-cols-3 gap-4">
                    <div class="sm:col-span-1">
                        <label class="block font-semibold text-slate-600 mb-1">Kontak WhatsApp Panitia PPDB</label>
                        <input type="text" name="kontak_panitia" value="<%= pSetting.kontak_panitia || '0812-3456-7890' %>" placeholder="Contoh: 0812-3456-7890" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block font-semibold text-slate-600 mb-1">Teks Pengumuman untuk Calon Siswa</label>
                        <textarea name="pesan_pengumuman" rows="2" class="w-full border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600" placeholder="Pesan resmi terkait tahapan atau instruksi pendaftaran..."><%= pSetting.pesan_pengumuman || '' %></textarea>
                    </div>
                </div>

                <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modal-pengaturan-ppdb')" class="px-4 py-2 font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Batal</button>
                    <button type="submit" class="px-5 py-2 font-bold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm">Simpan Pengaturan PPDB</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDIT HALAMAN PROFIL (STATIS) & SLIP KARTU -->
    <div id="modal-edit-halaman" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-3 sm:p-4">
        <div class="bg-white rounded-3xl max-w-4xl w-full p-5 sm:p-7 shadow-2xl border border-slate-200 overflow-y-auto max-h-[94vh]">
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
                <div class="flex items-center gap-3">
                    <div id="edit-halaman-modal-icon-badge" class="w-10 h-10 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-lg font-bold border border-blue-100 transition-colors">
                        <i id="edit-halaman-header-icon" class="fa-solid fa-file-lines"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-base text-slate-900 leading-tight">Edit Konten, Ikon & Slip Kartu Profil</h3>
                        <p class="text-xs text-slate-400 mt-0.5">Kode Identifikasi: <span id="edit-halaman-slug-label" class="font-mono font-bold text-blue-600 bg-blue-50 px-2 py-0.5 rounded border border-blue-100">slug</span></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('modal-edit-halaman')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-800 flex items-center justify-center text-sm font-bold transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            
            <form id="form-edit-halaman" method="POST" class="space-y-4 mt-4">
                <!-- Judul Halaman -->
                <div>
