                                <i class="fa-solid fa-id-card text-3xl"></i>
                            </div>
                            <div id="detail-ppdb-akta-link-container" class="mt-2 w-full"></div>
                        </div>

                        <!-- Ijazah / SKL -->
                        <div class="p-3 bg-white rounded-xl border border-slate-200 text-center flex flex-col justify-between items-center">
                            <span class="text-[10px] font-bold text-slate-500 uppercase block mb-1.5">Ijazah / SKL SD</span>
                            <div class="w-16 h-20 bg-slate-50 rounded-lg border flex items-center justify-center my-1 text-amber-500">
                                <i class="fa-solid fa-graduation-cap text-3xl"></i>
                            </div>
                            <div id="detail-ppdb-ijazah-link-container" class="mt-2 w-full"></div>
