                                        <td colspan="5" class="py-8 text-center text-xs text-slate-400">Belum ada data berita. Klik "Tambah Berita" untuk mulai menulis.</td>
                                    </tr>
                                <% } %>
                                <% berita.forEach(b => { %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3 px-4">
                                            <p class="font-semibold text-slate-800 text-xs line-clamp-1"><%= b.judul %></p>
                                            <p class="text-[10px] text-slate-400 mt-0.5">slug: <%= b.slug %></p>
