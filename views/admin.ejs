                        <div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-semibold self-start sm:self-auto border border-slate-200/80">
                            <button type="button" id="tab-btn-builder-items" onclick="switchHalamanContentMode('builder')" class="px-3 py-1.5 rounded-lg bg-blue-900 text-white shadow-xs transition flex items-center gap-1.5 cursor-pointer">
