<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Admin - SMPN 1 Rantepao</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.25s ease-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-slate-900 text-white flex-shrink-0 flex flex-col justify-between border-r border-slate-800 fixed inset-y-0 left-0 z-30 transition-transform duration-300 md:translate-x-0 -translate-x-full" id="sidebar">
        <div>
            <!-- School Brand Header -->
            <div class="h-20 px-6 flex items-center gap-3 border-b border-slate-800/80 bg-slate-950/40">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 font-black flex items-center justify-center text-lg shadow-md shadow-amber-500/20">
                    S1
                </div>
                <div>
                    <h1 class="font-bold text-sm text-white tracking-wide leading-tight">SMPN 1 RANTEPAO</h1>
                    <span class="text-[11px] font-medium text-amber-400">Control Panel Admin</span>
                </div>
            </div>

            <!-- Admin Profile Tag -->
            <% const currentUser = (typeof user !== 'undefined' && user) ? user : (typeof locals !== 'undefined' && locals.user ? locals.user : null); %>
            <div class="mx-4 my-4 p-3 rounded-xl bg-slate-800/60 border border-slate-700/50 flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs uppercase">
                    <%= (currentUser && currentUser.nama) ? currentUser.nama.substring(0, 2) : 'AD' %>
                </div>
                <div class="overflow-hidden flex-1">
                    <p class="text-xs font-semibold text-white truncate"><%= (currentUser && currentUser.nama) ? currentUser.nama : 'Administrator' %></p>
                    <p class="text-[10px] text-emerald-400 flex items-center gap-1 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> <%= (currentUser && currentUser.role) ? currentUser.role : 'admin' %>
                    </p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="px-3 space-y-1 text-sm font-medium">
                <button type="button" onclick="switchTab('overview')" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="overview">
                    <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                    <span>Ringkasan Info</span>
                </button>

                <button type="button" onclick="switchTab('berita')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="berita">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                        <span>Kelola Berita</span>
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= stats.totalBerita %></span>
                </button>

                <button type="button" onclick="switchTab('pengumuman')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="pengumuman">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
                        <span>Pengumuman</span>
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= stats.totalPengumuman %></span>
                </button>

                <button type="button" onclick="switchTab('guru')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="guru">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        <span>Guru & Staf</span>
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= stats.totalGuru %></span>
                </button>

                <button type="button" onclick="switchTab('komite')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="komite">
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-users-gear w-5 text-center text-slate-400 group-hover:text-amber-400 transition text-sm"></i>
                        <span>Komite Sekolah</span>
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= (typeof stats !== 'undefined' && stats.totalKomite) ? stats.totalKomite : 0 %></span>
                </button>

                <button type="button" onclick="switchTab('ppdb')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="ppdb">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        <span>PPDB 2026</span>
                    </div>
                    <% if (typeof stats !== 'undefined' && stats.ppdbMenunggu > 0) { %>
                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500 text-slate-950 font-extrabold animate-pulse"><%= stats.ppdbMenunggu %> Verif</span>
                    <% } else { %>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= (typeof stats !== 'undefined' && stats.totalPPDB) ? stats.totalPPDB : 0 %></span>
                    <% } %>
                </button>

                <button type="button" onclick="switchTab('eskul')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="eskul">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>Ekstrakurikuler</span>
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= (typeof stats !== 'undefined' && stats.totalEskul) ? stats.totalEskul : 0 %></span>
                </button>

                <button type="button" onclick="switchTab('galeri')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="galeri">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <span>Galeri Foto</span>
                    </div>
                    <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= (typeof stats !== 'undefined' && stats.totalGaleri) ? stats.totalGaleri : 0 %></span>
                </button>

                <button type="button" onclick="switchTab('profil')" class="nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="profil">
                    <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    <span>Profil Sekolah</span>
                </button>

                <button type="button" onclick="switchTab('pesan')" class="nav-btn w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition group" data-tab="pesan">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 text-slate-400 group-hover:text-amber-400 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        <span>Pesan Masuk</span>
                    </div>
                    <% if (stats.pesanBaru > 0) { %>
                        <span class="text-[11px] px-2 py-0.5 rounded-full bg-red-500 text-white font-bold animate-pulse"><%= stats.pesanBaru %> Baru</span>
                    <% } else { %>
                        <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 font-bold"><%= stats.totalPesan %></span>
                    <% } %>
                </button>
            </nav>
        </div>

        <!-- Sidebar Footer Action -->
        <div class="p-4 border-t border-slate-800 bg-slate-950/40 space-y-2">
            <a href="/" target="_blank" class="w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-semibold rounded-lg bg-blue-600 hover:bg-blue-500 text-white shadow-sm transition">
                <span>Kunjungi Website Publik</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a href="/logout" onclick="return confirm('Apakah Anda yakin ingin keluar (logout) dari panel admin?')" class="w-full flex items-center justify-center gap-2 px-3 py-2 text-xs font-semibold rounded-lg bg-red-950/40 hover:bg-red-600 text-red-300 hover:text-white border border-red-800/50 transition">
                <span>Keluar (Logout)</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            </a>
            <p class="text-[11px] text-slate-500 text-center mt-2">&copy; SMPN 1 Rantepao</p>
        </div>
    </aside>

    <!-- MAIN WRAPPER -->
    <div class="flex-1 md:ml-64 flex flex-col min-h-screen">
        
        <!-- TOPBAR -->
        <header class="h-20 bg-white border-b border-slate-200 px-6 flex items-center justify-between sticky top-0 z-20 shadow-sm">
            <div class="flex items-center gap-3">
                <button type="button" onclick="toggleSidebar()" class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
                <div>
                    <h2 id="topbar-title" class="font-bold text-lg text-slate-800 leading-tight">Dashboard Overview</h2>
                    <p class="text-xs text-slate-400">Toraja Utara, Sulawesi Selatan</p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <div class="hidden sm:flex items-center text-xs text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg border border-slate-200/60 font-medium">
                    <i class="fa-regular fa-calendar text-slate-400 mr-2"></i><%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                </div>
                <a href="/" target="_blank" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition">
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-500"></i>
                    <span>Lihat Website</span>
                </a>
                <a href="/logout" onclick="return confirm('Apakah Anda yakin ingin keluar (logout) dari panel admin?')" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 border border-red-200 hover:border-red-600 rounded-lg transition shadow-xs" title="Keluar dari Panel Admin">
                    <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    <span>Keluar (Logout)</span>
                </a>
            </div>
        </header>

        <!-- FLASH ALERT MESSAGE -->
        <% if (alert) { %>
            <div class="mx-6 mt-6 p-4 rounded-xl border flex items-center justify-between <%= alert.status === 'success' ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-red-50 border-red-200 text-red-800' %> shadow-sm" id="alert-box">
                <div class="flex items-center gap-3">
                    <% if (alert.status === 'success') { %>
                        <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-xs"><i class="fa-solid fa-check"></i></div>
                    <% } else { %>
                        <div class="w-8 h-8 rounded-full bg-red-500 text-white flex items-center justify-center font-bold text-xs"><i class="fa-solid fa-xmark"></i></div>
                    <% } %>
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wider"><%= alert.status === 'success' ? 'Berhasil' : 'Pemberitahuan' %></p>
                        <p class="text-sm font-medium"><%= alert.message %></p>
                    </div>
                </div>
                <button type="button" onclick="document.getElementById('alert-box').remove()" class="text-slate-400 hover:text-slate-600 p-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        <% } %>

        <!-- MAIN BODY CONTENT -->
        <main class="p-6 flex-1 max-w-7xl w-full mx-auto">

            <!-- ============================================== -->
            <!-- TAB 1: OVERVIEW -->
            <!-- ============================================== -->
            <div id="tab-overview" class="tab-content">
                <!-- Stats Overview Cards -->
                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
                    <!-- Stat Card: Berita -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Berita</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= stats.totalBerita %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-500">Publikasi artikel</span>
                            <button type="button" onclick="switchTab('berita')" class="text-blue-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>

                    <!-- Stat Card: Pengumuman -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pengumuman</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= stats.totalPengumuman %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-500">Info resmi sekolah</span>
                            <button type="button" onclick="switchTab('pengumuman')" class="text-amber-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>

                    <!-- Stat Card: Guru & Staf -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Guru & Staf</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= stats.totalGuru %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-500">Tenaga pendidik</span>
                            <button type="button" onclick="switchTab('guru')" class="text-emerald-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>

                    <!-- Stat Card: Komite Sekolah -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Komite Sekolah</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= (typeof stats !== 'undefined' && stats.totalKomite) ? stats.totalKomite : 0 %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                                <i class="fa-solid fa-users-gear text-xl"></i>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-500">Pengurus kemitraan</span>
                            <button type="button" onclick="switchTab('komite')" class="text-blue-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>

                    <!-- Stat Card: Ekstrakurikuler -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Ekstrakurikuler</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= (typeof stats !== 'undefined' && stats.totalEskul) ? stats.totalEskul : 0 %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-500">Bakat & Minat</span>
                            <button type="button" onclick="switchTab('eskul')" class="text-indigo-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>

                    <!-- Stat Card: Galeri Foto -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Galeri Foto</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= (typeof stats !== 'undefined' && stats.totalGaleri) ? stats.totalGaleri : 0 %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-pink-50 text-pink-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="text-slate-500">Dokumentasi</span>
                            <button type="button" onclick="switchTab('galeri')" class="text-pink-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>

                    <!-- Stat Card: Pesan Masuk -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Pesan Masuk</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= stats.totalPesan %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="<%= stats.pesanBaru > 0 ? 'text-red-500 font-bold' : 'text-slate-500' %>">
                                <%= stats.pesanBaru %> belum dibaca
                            </span>
                            <button type="button" onclick="switchTab('pesan')" class="text-purple-600 font-semibold hover:underline">Buka →</button>
                        </div>
                    </div>

                    <!-- Stat Card: PPDB 2026/2027 -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow transition">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">PPDB 2026</p>
                                <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= (typeof stats !== 'undefined' && stats.totalPPDB) ? stats.totalPPDB : 0 %></h3>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                            <span class="<%= (typeof stats !== 'undefined' && stats.ppdbMenunggu > 0) ? 'text-amber-600 font-bold' : 'text-slate-500' %>">
                                <%= (typeof stats !== 'undefined' && stats.ppdbMenunggu) ? stats.ppdbMenunggu : 0 %> belum verifikasi
                            </span>
                            <button type="button" onclick="switchTab('ppdb')" class="text-amber-600 font-semibold hover:underline">Kelola →</button>
                        </div>
                    </div>
                </div>

                <!-- Quick Action Banners -->
                <div class="bg-gradient-to-r from-blue-900 via-blue-950 to-slate-900 rounded-2xl p-6 text-white mb-8 shadow-sm">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <span class="text-xs bg-amber-500 text-slate-950 font-bold px-2.5 py-1 rounded-full uppercase">Pintasan Cepat</span>
                            <h3 class="text-xl font-bold mt-2">Selamat Datang di Panel Pengelolaan SMPN 1 Rantepao</h3>
                            <p class="text-xs text-slate-300 mt-1">Gunakan tombol di samping untuk segera menerbitkan berita baru, mengelola PPDB, atau memperbarui data sekolah.</p>
                        </div>
                        <div class="flex flex-wrap gap-2.5">
                            <button type="button" onclick="openModal('modal-tambah-ppdb')" class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-lg transition shadow">
                                + Pendaftar PPDB
                            </button>
                            <button type="button" onclick="openModal('modal-tambah-berita')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-lg border border-white/20 transition">
                                + Tulis Berita
                            </button>
                            <button type="button" onclick="openModal('modal-tambah-pengumuman')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-lg border border-white/20 transition">
                                + Pengumuman
                            </button>
                            <button type="button" onclick="openModal('modal-tambah-guru')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-lg border border-white/20 transition">
                                + Guru/Staf
                            </button>
                            <button type="button" onclick="openModal('modal-tambah-komite')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-lg border border-white/20 transition">
                                + Komite
                            </button>
                            <button type="button" onclick="switchTab('profil')" class="px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-semibold rounded-lg border border-white/20 transition flex items-center gap-1.5">
                                <i class="fa-solid fa-gear"></i> Edit Profil
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Two Column Recent Summaries -->
                <div class="grid lg:grid-cols-2 gap-6">
                    <!-- Recent Berita Card -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
                        <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
                            <h4 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-600"></span> Berita Terakhir Terbit
                            </h4>
                            <button type="button" onclick="switchTab('berita')" class="text-xs text-blue-600 font-semibold hover:underline">Semua Berita →</button>
                        </div>
                        <% if (berita.length === 0) { %>
                            <p class="text-xs text-slate-400 text-center py-6">Belum ada berita yang diterbitkan.</p>
                        <% } else { %>
                            <div class="divide-y divide-slate-100">
                                <% berita.slice(0, 4).forEach(item => { %>
                                    <div class="py-3 flex items-start justify-between gap-3">
                                        <div class="overflow-hidden">
                                            <p class="text-xs font-bold text-slate-800 truncate"><%= item.judul %></p>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-700"><%= item.nama_kategori %></span>
                                                <span class="text-[10px] text-slate-400"><i class="fa-regular fa-calendar-days text-slate-400 mr-1"></i><%= new Date(item.tanggal_publish).toLocaleDateString('id-ID') %></span>
                                            </div>
                                        </div>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-semibold flex-shrink-0 <%= item.status === 'publish' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600' %>">
                                            <%= item.status %>
                                        </span>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                    <!-- Recent Pengumuman Card -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6">
                        <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
                            <h4 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-amber-500"></span> Pengumuman Terakhir
                            </h4>
                            <button type="button" onclick="switchTab('pengumuman')" class="text-xs text-amber-600 font-semibold hover:underline">Semua Pengumuman →</button>
                        </div>
                        <% if (pengumuman.length === 0) { %>
                            <p class="text-xs text-slate-400 text-center py-6">Belum ada pengumuman.</p>
                        <% } else { %>
                            <div class="divide-y divide-slate-100">
                                <% pengumuman.slice(0, 4).forEach(p => { %>
                                    <div class="py-3">
                                        <div class="flex items-center justify-between">
                                            <p class="text-xs font-bold text-slate-800 truncate"><%= p.judul_pengumuman %></p>
                                            <span class="text-[10px] text-slate-400"><i class="fa-regular fa-calendar-days text-slate-400 mr-1"></i><%= new Date(p.tanggal_terbit).toLocaleDateString('id-ID') %></span>
                                        </div>
                                        <p class="text-xs text-slate-500 mt-1 line-clamp-1"><%= p.isi_pengumuman %></p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 2: KELOLA BERITA -->
            <!-- ============================================== -->
            <div id="tab-berita" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <!-- Action Bar -->
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Daftar Berita & Kegiatan Sekolah</h3>
                            <p class="text-xs text-slate-400">Kelola postingan artikel, berita prestasi, dan kegiatan</p>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <input type="text" id="search-berita" onkeyup="filterBeritaTable()" placeholder="Cari judul berita..." class="text-xs border border-slate-200 rounded-lg px-3 py-2 w-48 focus:outline-blue-600">
                            <button type="button" onclick="openModal('modal-tambah-berita')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 flex-shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                <span>Tambah Berita</span>
                            </button>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse" id="table-berita">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Judul Berita</th>
                                    <th class="py-3 px-4">Kategori</th>
                                    <th class="py-3 px-4">Status</th>
                                    <th class="py-3 px-4">Tanggal Terbit</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (berita.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-8 text-center text-xs text-slate-400">Belum ada data berita. Klik "Tambah Berita" untuk mulai menulis.</td>
                                    </tr>
                                <% } %>
                                <% berita.forEach(b => { %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3 px-4">
                                            <p class="font-semibold text-slate-800 text-xs line-clamp-1"><%= b.judul %></p>
                                            <p class="text-[10px] text-slate-400 mt-0.5">slug: <%= b.slug %></p>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="text-[11px] font-semibold px-2 py-0.5 rounded bg-blue-50 text-blue-700">
                                                <%= b.nama_kategori %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="text-[11px] font-semibold px-2 py-0.5 rounded <%= b.status === 'publish' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200' %>">
                                                <%= b.status %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">
                                            <%= new Date(b.tanggal_publish).toLocaleDateString('id-ID') %>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button" 
                                                        class="btn-edit-berita p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition" 
                                                        title="Edit Berita"
                                                        data-id="<%= b.id_berita %>"
                                                        data-judul="<%= b.judul %>"
                                                        data-kategori="<%= b.kategori_id %>"
                                                        data-status="<%= b.status %>"
                                                        data-isi="<%= b.isi_berita %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                </button>
                                                <form action="/admin/berita/hapus/<%= b.id_berita %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus berita ini?')">
                                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Berita">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 3: KELOLA PENGUMUMAN -->
            <!-- ============================================== -->
            <div id="tab-pengumuman" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Daftar Pengumuman Resmi</h3>
                            <p class="text-xs text-slate-400">Pengumuman libur, jadwal ujian, rapat komite, dan info akademik</p>
                        </div>
                        <button type="button" onclick="openModal('modal-tambah-pengumuman')" class="px-4 py-2 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 self-start sm:self-auto">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            <span>Tambah Pengumuman</span>
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Judul Pengumuman</th>
                                    <th class="py-3 px-4">Isi Singkat</th>
                                    <th class="py-3 px-4">Tanggal Terbit</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (pengumuman.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="py-8 text-center text-xs text-slate-400">Belum ada pengumuman yang dibuat.</td>
                                    </tr>
                                <% } %>
                                <% pengumuman.forEach(p => { %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3 px-4 font-semibold text-slate-800 text-xs"><%= p.judul_pengumuman %></td>
                                        <td class="py-3 px-4 text-xs text-slate-500 max-w-md">
                                            <p class="line-clamp-2"><%= p.isi_pengumuman %></p>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">
                                            <%= new Date(p.tanggal_terbit).toLocaleDateString('id-ID') %>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button" 
                                                        class="btn-edit-pengumuman p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition" 
                                                        title="Edit Pengumuman"
                                                        data-id="<%= p.id_pengumuman %>"
                                                        data-judul="<%= p.judul_pengumuman %>"
                                                        data-isi="<%= p.isi_pengumuman %>"
                                                        data-tanggal="<%= new Date(p.tanggal_terbit).toISOString().split('T')[0] %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                </button>
                                                <form action="/admin/pengumuman/hapus/<%= p.id_pengumuman %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus pengumuman ini?')">
                                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Pengumuman">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 4: KELOLA GURU & STAF -->
            <!-- ============================================== -->
            <div id="tab-guru" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Direktori Guru & Tenaga Kependidikan</h3>
                            <p class="text-xs text-slate-400">Daftar pendidik, staf tata usaha, dan struktur kepengurusan</p>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <input type="text" id="search-guru" onkeyup="filterGuruTable()" placeholder="Cari nama guru..." class="text-xs border border-slate-200 rounded-lg px-3 py-2 w-48 focus:outline-blue-600">
                            <button type="button" onclick="openModal('modal-tambah-guru')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 flex-shrink-0">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                <span>Tambah Guru/Staf</span>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse" id="table-guru">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4 w-12 text-center">Urutan</th>
                                    <th class="py-3 px-4">Nama Lengkap & NIP</th>
                                    <th class="py-3 px-4">L/P</th>
                                    <th class="py-3 px-4">Jabatan</th>
                                    <th class="py-3 px-4">Kategori</th>
                                    <th class="py-3 px-4">Status</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (guru.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="py-8 text-center text-xs text-slate-400">Belum ada data guru/staf.</td>
                                    </tr>
                                <% } %>
                                <% guru.forEach(g => { %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3 px-4 text-center text-xs font-semibold text-slate-400"><%= g.urutan_tampil %></td>
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-3">
                                                <div class="w-8 h-8 rounded-full bg-slate-100 text-slate-700 font-bold flex items-center justify-center text-xs border overflow-hidden">
                                                    <% if (g.foto && !g.foto.startsWith('default') && g.foto !== '') { %>
                                                        <img src="/uploads/guru/<%= g.foto %>" alt="<%= g.nama_lengkap %>" class="w-full h-full object-cover">
                                                    <% } else { %>
                                                        <%= g.nama_lengkap.charAt(0) %>
                                                    <% } %>
                                                </div>
                                                <div>
                                                    <p class="font-semibold text-slate-800 text-xs"><%= g.nama_lengkap %></p>
                                                    <p class="text-[10px] text-slate-400">NIP: <%= g.nip || '-' %></p>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3 px-4 text-xs font-medium text-slate-600"><%= g.jenis_kelamin %></td>
                                        <td class="py-3 px-4 text-xs font-semibold text-slate-700"><%= g.jabatan %></td>
                                        <td class="py-3 px-4">
                                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 border">
                                                <%= g.kategori_pegawai %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded <%= g.status_aktif === 'Aktif' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-red-50 text-red-700 border border-red-200' %>">
                                                <%= g.status_aktif %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button" 
                                                        class="btn-edit-guru p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition" 
                                                        title="Edit Guru/Staf"
                                                        data-id="<%= g.id_guru %>"
                                                        data-nama="<%= g.nama_lengkap %>"
                                                        data-nip="<%= g.nip || '' %>"
                                                        data-jk="<%= g.jenis_kelamin %>"
                                                        data-jabatan="<%= g.jabatan %>"
                                                        data-kategori="<%= g.kategori_pegawai %>"
                                                        data-urutan="<%= g.urutan_tampil %>"
                                                        data-status="<%= g.status_aktif %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                </button>
                                                <form action="/admin/guru/hapus/<%= g.id_guru %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data ini?')">
                                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Guru/Staf">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB: KELOLA KOMITE SEKOLAH -->
            <!-- ============================================== -->
            <div id="tab-komite" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Struktur Pengurus Komite Sekolah</h3>
                            <p class="text-xs text-slate-400">Kelola data pengurus komite, jabatan, periode masa bakti, dan perwakilan unsur kemitraan</p>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <input type="text" id="search-komite" onkeyup="filterKomiteTable()" placeholder="Cari nama pengurus..." class="text-xs border border-slate-200 rounded-lg px-3 py-2 w-48 focus:outline-blue-600">
                            <button type="button" onclick="openModal('modal-tambah-komite')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 flex-shrink-0">
                                <i class="fa-solid fa-plus"></i>
                                <span>Tambah Pengurus Komite</span>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse" id="table-komite">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4 w-12 text-center">Urutan</th>
                                    <th class="py-3 px-4">Foto & Nama Lengkap</th>
                                    <th class="py-3 px-4">Jabatan</th>
                                    <th class="py-3 px-4">Periode</th>
                                    <th class="py-3 px-4">Pekerjaan / Unsur Perwakilan</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (typeof komite === 'undefined' || komite.length === 0) { %>
                                    <tr>
                                        <td colspan="6" class="py-8 text-center text-xs text-slate-400">Belum ada data pengurus komite sekolah.</td>
                                    </tr>
                                <% } %>
                                <% if (typeof komite !== 'undefined') { %>
                                    <% komite.forEach(k => { %>
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="py-3 px-4 text-center text-xs font-semibold text-slate-400"><%= k.urutan_tampil %></td>
                                            <td class="py-3 px-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-slate-900 text-amber-400 font-bold flex items-center justify-center text-xs border border-slate-200 overflow-hidden flex-shrink-0">
                                                        <% if (k.foto && !k.foto.startsWith('default') && k.foto !== '') { %>
                                                            <img src="/uploads/komite/<%= k.foto %>" alt="<%= k.nama_lengkap %>" class="w-full h-full object-cover">
                                                        <% } else { %>
                                                            <i class="fa-solid fa-user-tie"></i>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-bold text-slate-800 text-xs"><%= k.nama_lengkap %></p>
                                                        <p class="text-[10px] text-slate-400">ID Komite #<%= k.id_komite %></p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 px-4">
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 text-amber-800 border border-amber-200 inline-flex items-center gap-1">
                                                    <i class="fa-solid fa-award text-[9px]"></i> <%= k.jabatan %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-xs font-semibold text-slate-600">
                                                <i class="fa-regular fa-calendar-check text-slate-400 mr-1"></i><%= k.periode %>
                                            </td>
                                            <td class="py-3 px-4 text-xs text-slate-700">
                                                <%= k.pekerjaan_atau_unsur %>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <div class="inline-flex items-center gap-1.5">
                                                    <button type="button" 
                                                            class="btn-edit-komite px-2.5 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition flex items-center gap-1.5 shadow-xs" 
                                                            title="Edit Pengurus Komite"
                                                            onclick="openEditKomite(this)"
                                                            data-id="<%= k.id_komite %>"
                                                            data-nama="<%= k.nama_lengkap %>"
                                                            data-jabatan="<%= k.jabatan %>"
                                                            data-periode="<%= k.periode %>"
                                                            data-unsur="<%= k.pekerjaan_atau_unsur %>"
                                                            data-urutan="<%= k.urutan_tampil %>"
                                                            data-foto="<%= k.foto || '' %>">
                                                        <i class="fa-solid fa-pen-to-square text-xs pointer-events-none"></i>
                                                        <span class="pointer-events-none">Edit</span>
                                                    </button>
                                                    <form action="/admin/komite/hapus/<%= k.id_komite %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data pengurus komite <%= k.nama_lengkap %>?')">
                                                        <button type="submit" class="px-2.5 py-1.5 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition flex items-center gap-1.5 shadow-xs" title="Hapus Pengurus Komite">
                                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                                            <span>Hapus</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 5: EDIT PROFIL SEKOLAH -->
            <!-- ============================================== -->
            <div id="tab-profil" class="tab-content">
                <form action="/admin/profil/update" method="POST" class="space-y-6">
                    
                    <!-- Top Save Bar -->
                    <div class="flex items-center justify-between bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Edit Profil & Informasi Sekolah</h3>
                            <p class="text-xs text-slate-400">Data ini tampil secara langsung di halaman depan website sekolah</p>
                        </div>
                        <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span>Simpan Perubahan Profil</span>
                        </button>
                    </div>

                    <!-- Section: Identitas & Kontak -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-school text-blue-900"></i>
                            <span>Identitas Umum & Akreditasi</span>
                        </h4>
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Resmi Sekolah</label>
                                <input type="text" name="nama_sekolah" value="<%= profil.nama_sekolah || '' %>" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">NPSN</label>
                                <input type="text" name="npsn" value="<%= profil.npsn || '' %>" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Akreditasi</label>
                                <input type="text" name="akreditasi" value="<%= profil.akreditasi || '' %>" required placeholder="Contoh: A" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>

                        <div class="grid md:grid-cols-2 gap-4 pt-2">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Nomor Telepon Sekolah</label>
                                <input type="text" name="telepon" value="<%= profil.telepon || '' %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Email Resmi Sekolah</label>
                                <input type="email" name="email_sekolah" value="<%= profil.email_sekolah || '' %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Alamat Lengkap Sekolah</label>
                            <textarea name="alamat" rows="2" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.alamat || '' %></textarea>
                        </div>
                    </div>

                    <!-- Section: Kepala Sekolah -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-user-tie text-blue-900"></i>
                            <span>Data Kepala Sekolah & Sambutan</span>
                        </h4>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap Kepala Sekolah (beserta Gelar)</label>
                                <input type="text" name="nama_kepsek" value="<%= profil.nama_kepsek || '' %>" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">NIP Kepala Sekolah</label>
                                <input type="text" name="nip_kepsek" value="<%= profil.nip_kepsek || '' %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Teks Sambutan Kepala Sekolah</label>
                            <textarea name="sambutan_kepsek" rows="4" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.sambutan_kepsek || '' %></textarea>
                        </div>
                    </div>

                    <!-- Section: Visi, Misi & Sejarah -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-scroll text-blue-900"></i>
                            <span>Visi, Misi & Sejarah Singkat</span>
                        </h4>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Visi Sekolah</label>
                            <textarea name="visi" rows="3" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.visi || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Misi Sekolah (Gunakan baris baru atau penomoran)</label>
                            <textarea name="misi" rows="5" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.misi || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Sejarah Singkat Sekolah</label>
                            <textarea name="sejarah" rows="4" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.sejarah || '' %></textarea>
                        </div>
                    </div>

                    <!-- Section: Google Maps Embed -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-map-location-dot text-blue-900"></i>
                            <span>Embed Google Maps</span>
                        </h4>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Kode / URL Embed Google Maps (iframe / link)</label>
                            <textarea name="maps_embed" rows="3" placeholder="https://maps.google.com/..." class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 font-mono text-slate-600 focus:outline-blue-600"><%= profil.maps_embed || '' %></textarea>
                        </div>
                    </div>

                    <div class="flex justify-end pt-2 pb-4">
                        <button type="submit" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span>Simpan Semua Perubahan Profil</span>
                        </button>
                    </div>

                </form>

                <!-- Section: Keamanan & Ganti Password Admin -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm mt-8 space-y-4">
                    <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-blue-900"></i>
                        <span>Keamanan Akun & Ganti Password Administrator</span>
                    </h4>
                    <form action="/admin/profil/ganti-password" method="POST" class="space-y-4">
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Password Saat Ini (Lama)</label>
                                <input type="password" name="password_lama" required placeholder="Masukkan password lama" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Password Baru</label>
                                <input type="password" name="password_baru" required placeholder="Minimal 5 karakter" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Konfirmasi Password Baru</label>
                                <input type="password" name="konfirmasi_password" required placeholder="Ulangi password baru" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>
                        <div class="flex justify-end pt-2">
                            <button type="submit" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center gap-2">
                                <i class="fa-solid fa-key text-xs"></i>
                                <span>Perbarui Kata Sandi Akun</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 6: PESAN MASUK -->
            <!-- ============================================== -->
            <div id="tab-pesan" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Pesan dari Pengunjung Website</h3>
                            <p class="text-xs text-slate-400">Pertanyaan dan formulir kontak yang dikirim oleh masyarakat/orang tua</p>
                        </div>
                        <span class="text-xs font-semibold px-3 py-1 bg-purple-50 text-purple-700 rounded-lg border border-purple-200">
                            Total: <%= stats.totalPesan %> Pesan (<%= stats.pesanBaru %> Baru)
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Pengirim & Kontak</th>
                                    <th class="py-3 px-4">Subjek & Pesan</th>
                                    <th class="py-3 px-4">Tanggal Kirim</th>
                                    <th class="py-3 px-4">Status</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (pesan.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-8 text-center text-xs text-slate-400">Belum ada pesan yang masuk.</td>
                                    </tr>
                                <% } %>
                                <% pesan.forEach(msg => { %>
                                    <tr class="hover:bg-slate-50/80 transition <%= msg.status_baca === 'Belum Dibaca' ? 'bg-purple-50/20 font-medium' : '' %>">
                                        <td class="py-3 px-4">
                                            <p class="font-semibold text-slate-800 text-xs"><%= msg.nama_pengirim %></p>
                                            <p class="text-[10px] text-slate-500"><%= msg.email_atau_wa %></p>
                                        </td>
                                        <td class="py-3 px-4 max-w-sm">
                                            <p class="text-xs font-bold text-slate-800"><%= msg.subjek %></p>
                                            <p class="text-xs text-slate-500 line-clamp-1"><%= msg.isi_pesan %></p>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">
                                            <%= new Date(msg.tanggal_kirim).toLocaleDateString('id-ID') %>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded <%= msg.status_baca === 'Belum Dibaca' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-slate-100 text-slate-600' %>">
                                                <%= msg.status_baca %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button" 
                                                        class="btn-detail-pesan p-1.5 text-purple-600 hover:bg-purple-50 rounded-md transition" 
                                                        title="Baca Lengkap"
                                                        data-pengirim="<%= msg.nama_pengirim %>"
                                                        data-kontak="<%= msg.email_atau_wa %>"
                                                        data-subjek="<%= msg.subjek %>"
                                                        data-isi="<%= msg.isi_pesan %>"
                                                        data-tanggal="<%= new Date(msg.tanggal_kirim).toLocaleString('id-ID') %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                                </button>
                                                <% if (msg.status_baca === 'Belum Dibaca') { %>
                                                    <form action="/admin/pesan/baca/<%= msg.id_pesan %>" method="POST">
                                                        <button type="submit" class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-md transition" title="Tandai Sudah Dibaca">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                        </button>
                                                    </form>
                                                <% } %>
                                                <form action="/admin/pesan/hapus/<%= msg.id_pesan %>" method="POST" onsubmit="return confirm('Hapus pesan ini?')">
                                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Pesan">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 7: KELOLA EKSTRAKURIKULER -->
            <!-- ============================================== -->
            <div id="tab-eskul" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Daftar Ekstrakurikuler Siswa</h3>
                            <p class="text-xs text-slate-400">Kelola kegiatan pengembangan bakat, minat, kepanduan, dan seni budaya Toraja</p>
                        </div>
                        <button type="button" onclick="openModal('modal-tambah-eskul')" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-sm transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Tambah Eskul</span>
                        </button>
                    </div>

                    <div class="p-4 bg-slate-50 border-b border-slate-100">
                        <input type="text" id="search-eskul" onkeyup="filterEskulTable()" placeholder="Cari ekstrakurikuler atau pembina..." class="w-full sm:w-80 text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white focus:outline-blue-600">
                    </div>

                    <div class="overflow-x-auto">
                        <table id="table-eskul" class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Foto & Nama Eskul</th>
                                    <th class="py-3 px-4">Guru Pembina</th>
                                    <th class="py-3 px-4">Jadwal Latihan</th>
                                    <th class="py-3 px-4">Deskripsi Kegiatan</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (typeof eskul !== 'undefined' && eskul.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-8 text-center text-xs text-slate-400">Belum ada data ekstrakurikuler.</td>
                                    </tr>
                                <% } %>
                                <% if (typeof eskul !== 'undefined') { %>
                                    <% eskul.forEach(e => { %>
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="py-3 px-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-12 h-10 rounded-lg overflow-hidden bg-slate-900 border border-slate-200 flex-shrink-0">
                                                        <% if (e.foto_eskul && e.foto_eskul !== 'default-eskul.jpg') { %>
                                                            <img src="/uploads/eskul/<%= e.foto_eskul %>" alt="<%= e.nama_eskul %>" class="w-full h-full object-cover">
                                                        <% } else { %>
                                                            <div class="w-full h-full flex items-center justify-center text-amber-400 text-xs font-bold">
                                                                <i class="fa-solid fa-medal text-sm"></i>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-bold text-slate-800 text-xs"><%= e.nama_eskul %></p>
                                                        <span class="text-[10px] text-slate-400">ID #<%= e.id_eskul %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 px-4 text-xs font-medium text-slate-700">
                                                <%= e.pembina %>
                                            </td>
                                            <td class="py-3 px-4 text-xs text-slate-600 whitespace-nowrap">
                                                <i class="fa-regular fa-clock text-slate-400 mr-1"></i><%= e.jadwal_latihan %>
                                            </td>
                                            <td class="py-3 px-4 text-xs text-slate-500 max-w-xs">
                                                <p class="line-clamp-2"><%= e.deskripsi %></p>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <div class="inline-flex items-center gap-1.5">
                                                    <button type="button" 
                                                            class="btn-edit-eskul p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition" 
                                                            title="Edit Eskul"
                                                            data-id="<%= e.id_eskul %>"
                                                            data-nama="<%= e.nama_eskul %>"
                                                            data-pembina="<%= e.pembina %>"
                                                            data-jadwal="<%= e.jadwal_latihan %>"
                                                            data-deskripsi="<%= e.deskripsi %>">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                    </button>
                                                    <form action="/admin/eskul/hapus/<%= e.id_eskul %>" method="POST" onsubmit="return confirm('Hapus ekstrakurikuler <%= e.nama_eskul %>?')">
                                                        <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Eskul">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 8: KELOLA GALERI FOTO -->
            <!-- ============================================== -->
            <div id="tab-galeri" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Galeri Dokumentasi Foto Sekolah</h3>
                            <p class="text-xs text-slate-400">Dokumentasi kegiatan akademik, perayaan seni budaya Toraja, fasilitas, dan prestasi</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/galeri" target="_blank" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">
                                ↗ Buka Halaman Galeri
                            </a>
                            <button type="button" onclick="openModal('modal-tambah-galeri')" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-sm transition">
                                <i class="fa-solid fa-plus text-xs"></i>
                                <span>Upload Foto Galeri</span>
                            </button>
                        </div>
                    </div>

                    <div class="p-4 bg-slate-50 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <input type="text" id="search-galeri" onkeyup="filterGaleriCards()" placeholder="Cari judul dokumentasi..." class="w-full sm:w-80 text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white focus:outline-blue-600">
                        <span class="text-xs text-slate-500 font-medium">Total: <%= (typeof stats !== 'undefined' && stats.totalGaleri) ? stats.totalGaleri : 0 %> Foto Terpublikasi</span>
                    </div>

                    <!-- Gallery Cards in Admin -->
                    <div class="p-6">
                        <% if (typeof galeri !== 'undefined' && galeri.length === 0) { %>
                            <div class="text-center py-12 text-slate-400 text-xs">
                                Belum ada foto dokumentasi di galeri. Klik tombol di atas untuk mengunggah foto.
                            </div>
                        <% } %>
                        <div id="galeri-admin-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                            <% if (typeof galeri !== 'undefined') { %>
                                <% galeri.forEach(foto => { %>
                                    <div class="galeri-admin-item bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between group">
                                        <div class="relative aspect-video bg-slate-900 overflow-hidden">
                                            <img src="/uploads/galeri/<%= foto.file_foto %>" alt="<%= foto.judul_foto %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                            <div class="absolute top-2 left-2">
                                                <% if (foto.kategori_galeri === 'Prestasi') { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500 text-blue-950 inline-flex items-center gap-1"><i class="fa-solid fa-trophy text-[9px]"></i> Prestasi</span>
                                                <% } else if (foto.kategori_galeri === 'Fasilitas') { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white inline-flex items-center gap-1"><i class="fa-solid fa-building-columns text-[9px]"></i> Fasilitas</span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-600 text-white inline-flex items-center gap-1"><i class="fa-solid fa-masks-theater text-[9px]"></i> Kegiatan</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="p-4 flex-1 flex flex-col justify-between">
                                            <div>
                                                <p class="text-[10px] text-slate-400 font-medium"><i class="fa-regular fa-calendar text-slate-400 mr-1"></i><%= new Date(foto.tanggal_upload).toLocaleDateString('id-ID') %></p>
                                                <h4 class="font-bold text-xs text-slate-800 mt-1 line-clamp-2"><%= foto.judul_foto %></h4>
                                                <p class="text-[11px] text-slate-500 mt-1.5 line-clamp-2"><%= foto.deskripsi_singkat %></p>
                                            </div>
                                            <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between">
                                                <button type="button" 
                                                        class="btn-edit-galeri text-xs font-semibold text-blue-600 hover:text-blue-800 transition flex items-center gap-1"
                                                        data-id="<%= foto.id_galeri %>"
                                                        data-judul="<%= foto.judul_foto %>"
                                                        data-kategori="<%= foto.kategori_galeri %>"
                                                        data-deskripsi="<%= foto.deskripsi_singkat %>"
                                                        data-tgl="<%= new Date(foto.tanggal_upload).toISOString().split('T')[0] %>">
                                                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                                                    <span>Edit</span>
                                                </button>
                                                <form action="/admin/galeri/hapus/<%= foto.id_galeri %>" method="POST" onsubmit="return confirm('Hapus foto ini dari galeri?')">
                                                    <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 transition flex items-center gap-1">
                                                        <i class="fa-solid fa-trash-can text-xs"></i>
                                                        <span>Hapus</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 9: KELOLA PPDB (PENERIMAAN PESERTA DIDIK BARU) -->
            <!-- ============================================== -->
            <div id="tab-ppdb" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <!-- Action Header Bar -->
                    <div class="p-5 border-b border-slate-100 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[11px] font-extrabold uppercase">Tahun Ajaran 2026/2027</span>
                                <span class="text-xs text-slate-400">Total: <%= (typeof stats !== 'undefined' && stats.totalPPDB) ? stats.totalPPDB : 0 %> Calon Siswa</span>
                            </div>
                            <h3 class="font-bold text-lg text-slate-800 mt-1">Penerimaan Peserta Didik Baru (PPDB)</h3>
                            <p class="text-xs text-slate-400">Verifikasi berkas, pantau 4 jalur seleksi, dan tetapkan kelulusan calon siswa baru</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="button" onclick="window.print()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-print text-xs"></i>
                                <span>Cetak Rekap</span>
                            </button>
                            <a href="/ppdb" target="_blank" class="px-3.5 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold rounded-xl transition flex items-center gap-1.5 border border-blue-200">
                                <span>↗ Form Publik</span>
                            </a>
                            <button type="button" onclick="openModal('modal-tambah-ppdb')" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-xl shadow-sm transition">
                                <i class="fa-solid fa-user-plus text-xs"></i>
                                <span>Tambah Pendaftar Manual</span>
                            </button>
                        </div>
                    </div>

                    <!-- Mini Stat Metric Cards -->
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 p-5 bg-slate-50 border-b border-slate-100">
                        <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
                            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Pendaftar</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-slate-800"><%= (typeof stats !== 'undefined' && stats.totalPPDB) ? stats.totalPPDB : 0 %></span>
                                <span class="text-xs font-bold text-slate-400">Berkas Masuk</span>
                            </div>
                        </div>

                        <div class="p-4 bg-white rounded-xl border border-amber-200/80 shadow-xs">
                            <span class="text-[11px] font-semibold text-amber-600 uppercase tracking-wider">Menunggu Verifikasi</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-amber-600"><%= (typeof stats !== 'undefined' && stats.ppdbMenunggu) ? stats.ppdbMenunggu : 0 %></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Perlu Tindakan</span>
                            </div>
                        </div>

                        <div class="p-4 bg-white rounded-xl border border-blue-200/80 shadow-xs">
                            <span class="text-[11px] font-semibold text-blue-600 uppercase tracking-wider">Berkas Terverifikasi</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-blue-600"><%= (typeof stats !== 'undefined' && stats.ppdbTerverifikasi) ? stats.ppdbTerverifikasi : 0 %></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">Valid</span>
                            </div>
                        </div>

                        <div class="p-4 bg-white rounded-xl border border-emerald-200/80 shadow-xs">
                            <span class="text-[11px] font-semibold text-emerald-600 uppercase tracking-wider">Diterima / Lulus</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-emerald-600"><%= (typeof stats !== 'undefined' && stats.ppdbDiterima) ? stats.ppdbDiterima : 0 %></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">Siswa Baru</span>
                            </div>
                        </div>
                    </div>

                    <!-- Toolbar Filters -->
                    <div class="p-4 bg-white border-b border-slate-100 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
                        <div class="relative flex-1 max-w-md">
                            <input type="text" id="search-ppdb" onkeyup="filterPPDBTable()" placeholder="Cari nama siswa, nomor reg, NISN, atau asal SD..." class="w-full text-xs border border-slate-300 rounded-xl pl-9 pr-3 py-2.5 bg-slate-50 focus:bg-white focus:outline-blue-600 transition">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-3.5 text-slate-400 text-xs"></i>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <!-- Jalur Filter -->
                            <select id="filter-ppdb-jalur" onchange="filterPPDBTable()" class="text-xs border border-slate-300 rounded-xl px-3 py-2.5 bg-white text-slate-700 focus:outline-blue-600">
                                <option value="">Semua Jalur</option>
                                <option value="Zonasi">Jalur Zonasi</option>
                                <option value="Prestasi">Jalur Prestasi</option>
                                <option value="Afirmasi">Jalur Afirmasi</option>
                                <option value="Perpindahan Tugas">Jalur Perpindahan Tugas</option>
                            </select>

                            <!-- Status Filter -->
                            <select id="filter-ppdb-status" onchange="filterPPDBTable()" class="text-xs border border-slate-300 rounded-xl px-3 py-2.5 bg-white text-slate-700 focus:outline-blue-600">
                                <option value="">Semua Status</option>
                                <option value="Menunggu Verifikasi">Menunggu Verifikasi</option>
                                <option value="Berkas Terverifikasi">Berkas Terverifikasi</option>
                                <option value="Diterima">Diterima</option>
                                <option value="Tidak Diterima">Tidak Diterima</option>
                            </select>

                            <button type="button" onclick="resetPPDBFilter()" class="text-xs text-slate-500 hover:text-slate-800 px-2 py-2 font-medium">
                                ↺ Reset
                            </button>
                        </div>
                    </div>

                    <!-- Table List -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse" id="table-ppdb">
                            <thead>
                                <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3.5 px-4">No. Reg & Tanggal</th>
                                    <th class="py-3.5 px-4">Calon Siswa & NISN</th>
                                    <th class="py-3.5 px-4">Asal Sekolah SD</th>
                                    <th class="py-3.5 px-4">Jalur Pendaftaran</th>
                                    <th class="py-3.5 px-4">Orang Tua / Kontak</th>
                                    <th class="py-3.5 px-4">Status Seleksi</th>
                                    <th class="py-3.5 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                <% if (typeof pendaftarPPDB !== 'undefined' && pendaftarPPDB.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-12 text-slate-400">
                                            Belum ada data pendaftar calon siswa PPDB.
                                        </td>
                                    </tr>
                                <% } %>
                                <% if (typeof pendaftarPPDB !== 'undefined') { %>
                                    <% pendaftarPPDB.forEach(item => { %>
                                        <tr class="hover:bg-slate-50/80 transition ppdb-row" 
                                            data-jalur="<%= item.jalur_pendaftaran %>" 
                                            data-status="<%= item.status_seleksi %>">
                                            
                                            <!-- No Reg & Tanggal -->
                                            <td class="py-3.5 px-4">
                                                <span class="font-mono font-bold text-blue-900 bg-blue-50 px-2 py-0.5 rounded text-[11px] border border-blue-200/60 block w-max">
                                                    <%= item.no_pendaftaran %>
                                                </span>
                                                <span class="text-[10px] text-slate-400 block mt-1">
                                                    <i class="fa-regular fa-calendar text-slate-400 mr-1"></i><%= new Date(item.tanggal_daftar).toLocaleDateString('id-ID') %>
                                                </span>
                                            </td>

                                            <!-- Calon Siswa & NISN -->
                                            <td class="py-3.5 px-4">
                                                <div class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                                                    <span><%= item.nama_siswa %></span>
                                                    <span class="text-[10px] px-1.5 py-0.2 rounded font-semibold <%= item.jenis_kelamin === 'Perempuan' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700' %>">
                                                        <%= item.jenis_kelamin === 'Perempuan' ? 'P' : 'L' %>
                                                    </span>
                                                </div>
                                                <div class="text-[11px] text-slate-400 mt-0.5">
                                                    NISN: <span class="font-mono text-slate-600"><%= item.nisn || '-' %></span>
                                                </div>
                                            </td>

                                            <!-- Asal Sekolah -->
                                            <td class="py-3.5 px-4">
                                                <span class="font-medium text-slate-800"><%= item.asal_sekolah %></span>
                                                <span class="text-[10px] text-slate-400 block line-clamp-1 max-w-[180px]" title="<%= item.alamat_domisili %>">
                                                    <i class="fa-solid fa-location-dot text-slate-400 mr-1"></i><%= item.alamat_domisili %>
                                                </span>
                                            </td>

                                            <!-- Jalur Pendaftaran -->
                                            <td class="py-3.5 px-4">
                                                <% if (item.jalur_pendaftaran === 'Zonasi') { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-map-pin text-[10px]"></i> Zonasi
                                                    </span>
                                                <% } else if (item.jalur_pendaftaran === 'Prestasi') { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-trophy text-[10px]"></i> Prestasi
                                                    </span>
                                                <% } else if (item.jalur_pendaftaran === 'Afirmasi') { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-handshake-angle text-[10px]"></i> Afirmasi
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-briefcase text-[10px]"></i> Perpindahan
                                                    </span>
                                                <% } %>
                                            </td>

                                            <!-- Orang Tua & Kontak -->
                                            <td class="py-3.5 px-4">
                                                <p class="font-semibold text-slate-800"><%= item.nama_ortu %></p>
                                                <% const cleanHp = item.no_hp ? item.no_hp.replace(/[^0-9]/g, '') : ''; %>
                                                <% const waLink = cleanHp.startsWith('0') ? '62' + cleanHp.substring(1) : cleanHp; %>
                                                <a href="https://wa.me/<%= waLink %>?text=Halo%20Bpk/Ibu%20<%= encodeURIComponent(item.nama_ortu) %>,%20kami%20dari%20Panitia%20PPDB%20SMPN%201%20Rantepao%20terkait%20pendaftaran%20ananda%20<%= encodeURIComponent(item.nama_siswa) %>" 
                                                   target="_blank" 
                                                   class="inline-flex items-center gap-1 text-[11px] text-emerald-600 hover:text-emerald-700 font-bold mt-0.5">
                                                    <i class="fa-brands fa-whatsapp text-emerald-600"></i>
                                                    <span><%= item.no_hp %></span>
                                                </a>
                                            </td>

                                            <!-- Status Seleksi -->
                                            <td class="py-3.5 px-4">
                                                <% if (item.status_seleksi === 'Menunggu Verifikasi') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                        Menunggu Verifikasi
                                                    </span>
                                                <% } else if (item.status_seleksi === 'Berkas Terverifikasi') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                        <i class="fa-solid fa-circle-check text-xs"></i>
                                                        <span>Berkas Terverifikasi</span>
                                                    </span>
                                                <% } else if (item.status_seleksi === 'Diterima') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                        <i class="fa-solid fa-award text-xs"></i>
                                                        <span>Diterima Lulus</span>
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-red-50 text-red-700 border border-red-200">
                                                        <i class="fa-solid fa-circle-xmark text-xs"></i>
                                                        <span>Tidak Diterima</span>
                                                    </span>
                                                <% } %>
                                            </td>

                                            <!-- Aksi Buttons -->
                                            <td class="py-3.5 px-4 text-center">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <!-- Detail Button -->
                                                    <button type="button" 
                                                            class="btn-detail-ppdb p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition"
                                                            title="Lihat Detail Lengkap"
                                                            data-id="<%= item.id_pendaftar %>"
                                                            data-no="<%= item.no_pendaftaran %>"
                                                            data-nama="<%= item.nama_siswa %>"
                                                            data-nisn="<%= item.nisn || '-' %>"
                                                            data-jk="<%= item.jenis_kelamin %>"
                                                            data-sekolah="<%= item.asal_sekolah %>"
                                                            data-jalur="<%= item.jalur_pendaftaran %>"
                                                            data-ortu="<%= item.nama_ortu %>"
                                                            data-hp="<%= item.no_hp %>"
                                                            data-alamat="<%= item.alamat_domisili %>"
                                                            data-catatan="<%= item.catatan || '-' %>"
                                                            data-status="<%= item.status_seleksi %>"
                                                            data-tanggal="<%= new Date(item.tanggal_daftar).toLocaleString('id-ID') %>"
                                                            data-email="<%= item.email || '-' %>"
                                                            data-nowa="<%= item.no_wa || item.no_hp || '-' %>"
                                                            data-tempatlahir="<%= item.tempat_lahir || '-' %>"
                                                            data-tanggallahir="<%= item.tanggal_lahir ? new Date(item.tanggal_lahir).toLocaleDateString('id-ID') : '-' %>"
                                                            data-agama="<%= item.agama || '-' %>"
                                                            data-npsn="<%= item.npsn_asal_sekolah || '-' %>"
                                                            data-ayah="<%= item.nama_ayah || '-' %>"
                                                            data-ibu="<%= item.nama_ibu || '-' %>"
                                                            data-pekerjaan="<%= item.pekerjaan_ortu || '-' %>"
                                                            data-penghasilan="<%= item.penghasilan_ortu || '-' %>"
                                                            data-foto="<%= item.berkas_foto || '' %>"
                                                            data-kk="<%= item.berkas_kk || '' %>"
                                                            data-akta="<%= item.berkas_akta || '' %>"
                                                            data-ijazah="<%= item.berkas_ijazah || '' %>">
                                                        <i class="fa-solid fa-eye text-xs"></i>
                                                    </button>

                                                    <!-- Ubah Status Button -->
                                                    <button type="button"
                                                            class="btn-status-ppdb p-1.5 text-amber-600 hover:bg-amber-50 rounded-lg transition"
                                                            title="Ubah Status Seleksi"
                                                            data-id="<%= item.id_pendaftar %>"
                                                            data-no="<%= item.no_pendaftaran %>"
                                                            data-nama="<%= item.nama_siswa %>"
                                                            data-status="<%= item.status_seleksi %>"
                                                            data-catatan="<%= item.catatan || '' %>">
                                                        <i class="fa-solid fa-scale-balanced text-xs"></i>
                                                    </button>

                                                    <!-- Edit Button -->
                                                    <button type="button"
                                                            class="btn-edit-ppdb p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-lg transition"
                                                            title="Edit Data Pendaftar"
                                                            data-id="<%= item.id_pendaftar %>"
                                                            data-no="<%= item.no_pendaftaran %>"
                                                            data-nama="<%= item.nama_siswa %>"
                                                            data-nisn="<%= item.nisn || '' %>"
                                                            data-jk="<%= item.jenis_kelamin %>"
                                                            data-sekolah="<%= item.asal_sekolah %>"
                                                            data-jalur="<%= item.jalur_pendaftaran %>"
                                                            data-ortu="<%= item.nama_ortu %>"
                                                            data-hp="<%= item.no_hp %>"
                                                            data-alamat="<%= item.alamat_domisili %>"
                                                            data-catatan="<%= item.catatan || '' %>"
                                                            data-status="<%= item.status_seleksi %>">
                                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                                    </button>

                                                    <!-- Delete Form -->
                                                    <form action="/admin/ppdb/hapus/<%= item.id_pendaftar %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data calon siswa <%= item.nama_siswa %> (<%= item.no_pendaftaran %>)?')">
                                                        <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition" title="Hapus Data">
                                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                                    </form>
                                                </div>
                                            </td>

                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer Count Info -->
                    <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                        <span id="ppdb-counter-text">Menampilkan semua calon siswa pendaftar PPDB</span>
                        <span>Panitia PPDB UPT SMPN 1 Rantepao</span>
                    </div>
                </div>
            </div>

        </main>
    </div>

