                                    <button type="button" onclick="selectQuickIcon('fa-solid fa-school')" class="px-2 py-1 rounded-lg bg-white hover:bg-sky-50 hover:text-sky-700 hover:border-sky-300 border border-slate-200 text-slate-700 text-[11px] font-medium transition flex items-center gap-1.5 shadow-2xs cursor-pointer" title="Sekolah">
