                        <div class="p-3.5 bg-slate-50/80 rounded-2xl border border-slate-200/80 space-y-1.5">
                            <label class="block text-xs font-bold text-slate-700 flex items-center justify-between">
                                <span class="flex items-center gap-1.5">
                                    <i class="fa-solid fa-paragraph text-slate-500"></i>
                                    <span>Paragraf Pembuka / Narasi Pengantar (Opsional)</span>
                                </span>
                                <span class="text-[10px] text-slate-400">Tampil sebelum susunan kartu</span>
                            </label>
                            <textarea id="edit-halaman-pembuka-input" rows="2" 
                                oninput="compileItemsToHtml()"
                                placeholder="Tuliskan kalimat pembuka sebelum daftar kartu fasilitas atau program kerja..."
                                class="w-full text-xs border border-slate-300 rounded-xl p-2.5 bg-white text-slate-800 focus:outline-blue-600 shadow-2xs resize-none"></textarea>
                        </div>

                        <!-- Header List Kartu Konten -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-1">
                            <div class="flex items-center gap-2">
                                <span class="text-xs font-extrabold text-slate-800 uppercase tracking-wide flex items-center gap-1.5">
                                    <i class="fa-solid fa-layer-group text-blue-600"></i>
