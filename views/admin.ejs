                            <div class="flex items-center gap-1 pr-1.5 border-r border-slate-200">
                                <button type="button" onclick="formatBlockTag('p')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 font-semibold text-[11px] transition shadow-xs cursor-pointer" title="Paragraf Biasa">
