                                <button type="button" onclick="formatBlockTag('h5')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-blue-950 font-bold text-[11px] transition shadow-xs cursor-pointer" title="Subjudul">
                                    Subjudul H5
                                </button>
                            </div>

                            <!-- Inline Styling: Bold, Italic, Underline -->
                            <div class="flex items-center gap-1 pr-1.5 border-r border-slate-200">
                                <button type="button" onclick="execVisualCmd('bold')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-800 font-bold text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Tebal (Ctrl+B)">
                                    <i class="fa-solid fa-bold"></i>
