                                <button type="button" onclick="formatBlockTag('h4')" class="px-2.5 py-1 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-blue-950 font-bold text-[11px] transition shadow-xs cursor-pointer" title="Judul Sub-Bab">
