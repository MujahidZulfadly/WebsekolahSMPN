                        </div>
                        <div class="flex items-center gap-2.5">
                            <input type="text" id="search-komite" onkeyup="filterKomiteTable()" placeholder="Cari nama pengurus..." class="text-xs border border-slate-200 rounded-lg px-3 py-2 w-48 focus:outline-blue-600">
                            <button type="button" onclick="openModal('modal-tambah-komite')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 flex-shrink-0">
                                <i class="fa-solid fa-plus"></i>
                                <span>Tambah Pengurus Komite</span>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse" id="table-komite">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4 w-12 text-center">Urutan</th>
                                    <th class="py-3 px-4">Foto & Nama Lengkap</th>
                                    <th class="py-3 px-4">Jabatan</th>
                                    <th class="py-3 px-4">Periode</th>
                                    <th class="py-3 px-4">Pekerjaan / Unsur Perwakilan</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (typeof komite === 'undefined' || komite.length === 0) { %>
                                    <tr>
                                        <td colspan="6" class="py-8 text-center text-xs text-slate-400">Belum ada data pengurus komite sekolah.</td>
                                    </tr>
                                <% } %>
                                <% if (typeof komite !== 'undefined') { %>
                                    <% komite.forEach(k => { %>
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="py-3 px-4 text-center text-xs font-semibold text-slate-400"><%= k.urutan_tampil %></td>
                                            <td class="py-3 px-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-slate-900 text-amber-400 font-bold flex items-center justify-center text-xs border border-slate-200 overflow-hidden flex-shrink-0">
                                                        <% if (k.foto && !k.foto.startsWith('default') && k.foto !== '') { %>
                                                            <img src="/uploads/komite/<%= k.foto %>" alt="<%= k.nama_lengkap %>" class="w-full h-full object-cover">
                                                        <% } else { %>
                                                            <i class="fa-solid fa-user-tie"></i>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-bold text-slate-800 text-xs"><%= k.nama_lengkap %></p>
                                                        <p class="text-[10px] text-slate-400">ID Komite #<%= k.id_komite %></p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 px-4">
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-50 text-amber-800 border border-amber-200 inline-flex items-center gap-1">
                                                    <i class="fa-solid fa-award text-[9px]"></i> <%= k.jabatan %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-xs font-semibold text-slate-600">
                                                <i class="fa-regular fa-calendar-check text-slate-400 mr-1"></i><%= k.periode %>
                                            </td>
                                            <td class="py-3 px-4 text-xs text-slate-700">
                                                <%= k.pekerjaan_atau_unsur %>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <div class="inline-flex items-center gap-1.5">
                                                    <button type="button" 
                                                            class="btn-edit-komite px-2.5 py-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-200 rounded-lg transition flex items-center gap-1.5 shadow-xs" 
                                                            title="Edit Pengurus Komite"
                                                            onclick="openEditKomite(this)"
                                                            data-id="<%= k.id_komite %>"
                                                            data-nama="<%= k.nama_lengkap %>"
                                                            data-jabatan="<%= k.jabatan %>"
                                                            data-periode="<%= k.periode %>"
                                                            data-unsur="<%= k.pekerjaan_atau_unsur %>"
                                                            data-urutan="<%= k.urutan_tampil %>"
                                                            data-foto="<%= k.foto || '' %>">
                                                        <i class="fa-solid fa-pen-to-square text-xs pointer-events-none"></i>
                                                        <span class="pointer-events-none">Edit</span>
                                                    </button>
                                                    <form action="/admin/komite/hapus/<%= k.id_komite %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data pengurus komite <%= k.nama_lengkap %>?')">
                                                        <button type="submit" class="px-2.5 py-1.5 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition flex items-center gap-1.5 shadow-xs" title="Hapus Pengurus Komite">
                                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                                            <span>Hapus</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB: KELOLA STRUKTUR ORGANISASI SEKOLAH -->
            <!-- ============================================== -->
            <div id="tab-struktur" class="tab-content space-y-6">

                <!-- 1. Form Pengaturan Bagan & Keterangan Struktur -->
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden p-6">
                    <form action="/admin/struktur-organisasi/info" method="POST" enctype="multipart/form-data" class="space-y-5">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-slate-100 gap-3">
                            <div>
                                <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-sitemap text-amber-500"></i>
                                    <span>Pengaturan Bagan Gambar &amp; Informasi Struktur</span>
                                </h3>
                                <p class="text-xs text-slate-400">Upload bagan visual hierarki organisasi sekolah dan perbarui deskripsi keterangannya</p>
                            </div>
                            <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-2 self-start sm:self-auto cursor-pointer">
                                <i class="fa-solid fa-floppy-disk"></i>
                                <span>Simpan Bagan &amp; Info</span>
                            </button>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Judul Bagian Struktur</label>
                                <input type="text" name="judul" value="<%= (typeof strukturInfo !== 'undefined' && strukturInfo.judul) ? strukturInfo.judul : 'Struktur Organisasi UPT SMP Negeri 1 Rantepao' %>" required class="w-full text-xs border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Periode / Tahun Ajaran</label>
                                <input type="text" name="periode" value="<%= (typeof strukturInfo !== 'undefined' && strukturInfo.periode) ? strukturInfo.periode : 'Tahun Ajaran 2025/2026' %>" required class="w-full text-xs border border-slate-200 rounded-xl px-3.5 py-2.5 focus:outline-blue-600" placeholder="Contoh: Tahun Ajaran 2025/2026">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wide">Keterangan / Penjelasan Tata Kelola</label>
                            <textarea name="keterangan" rows="2" class="w-full text-xs border border-slate-200 rounded-xl p-3 focus:outline-blue-600" placeholder="Deskripsikan secara singkat alur garis komando, koordinasi, dan pembagian tugas..."><%= (typeof strukturInfo !== 'undefined' && strukturInfo.keterangan) ? strukturInfo.keterangan : '' %></textarea>
                        </div>

                        <!-- Upload & Current Preview Row -->
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-5 pt-3 border-t border-slate-100">
                            <div class="md:col-span-6 space-y-2">
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide">Upload Gambar / Foto Bagan Baru</label>
                                <input type="file" name="foto_bagan" accept="image/*" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-slate-200 rounded-xl cursor-pointer">
                                <p class="text-[11px] text-slate-400">Mendukung format JPG, PNG, WEBP. Disarankan gambar berorientasi lanskap horizontal atau diagram tajam resolusi tinggi.</p>
                            </div>
                            <div class="md:col-span-6">
                                <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wide">Pratinjau Bagan Aktif</label>
                                <% 
                                const curBagan = (typeof strukturInfo !== 'undefined' && strukturInfo.foto_bagan) 
                                    ? ('/uploads/struktur/' + strukturInfo.foto_bagan) 
                                    : '/img/default-bagan-struktur.svg'; 
                                %>
                                <div class="relative rounded-xl overflow-hidden border border-slate-200 bg-slate-900 h-36 flex items-center justify-center group">
                                    <img src="<%= curBagan %>" alt="Bagan Struktur Organisasi" class="h-full w-auto object-contain">
                                    <div class="absolute inset-0 bg-slate-950/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                                        <a href="<%= curBagan %>" target="_blank" class="px-3 py-1.5 rounded-lg bg-white/20 text-white text-xs font-bold hover:bg-white/30 backdrop-blur-sm flex items-center gap-1">
                                            <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                            <span>Lihat Penuh</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- 2. Tabel Personil / Pejabat Struktural -->
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Daftar Pejabat &amp; Personil Struktural</h3>
                            <p class="text-xs text-slate-400">Daftar pimpinan, wakil kepala sekolah, tata usaha, dan koordinator yang ditampilkan di website</p>
                        </div>
                        <div class="flex items-center gap-2.5">
                            <input type="text" id="search-struktur" onkeyup="filterStrukturTable()" placeholder="Cari nama / jabatan..." class="text-xs border border-slate-200 rounded-lg px-3 py-2 w-48 focus:outline-blue-600">
                            <button type="button" onclick="openModal('modal-tambah-struktur')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-lg transition shadow flex items-center gap-1.5 flex-shrink-0 cursor-pointer">
                                <i class="fa-solid fa-plus"></i>
                                <span>Tambah Pejabat</span>
                            </button>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse" id="table-struktur">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4 w-12 text-center">Urutan</th>
                                    <th class="py-3 px-4">Foto &amp; Nama Lengkap</th>
                                    <th class="py-3 px-4">NIP</th>
                                    <th class="py-3 px-4">Jabatan Struktural</th>
                                    <th class="py-3 px-4">Kategori Tingkat</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (typeof strukturAnggota === 'undefined' || strukturAnggota.length === 0) { %>
                                    <tr>
                                        <td colspan="6" class="py-8 text-center text-slate-400 text-xs">
                                            Belum ada data pejabat struktur organisasi. Klik "Tambah Pejabat" untuk menambahkan.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% strukturAnggota.forEach((p) => { %>
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="py-3 px-4 text-center font-bold text-slate-600">
                                                <span class="inline-flex w-7 h-7 rounded-full bg-slate-100 text-slate-700 items-center justify-center text-xs">
                                                    <%= p.urutan || 1 %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4">
                                                <div class="flex items-center gap-3">
                                                    <% 
                                                    let pFoto = '/img/default-avatar.svg';
                                                    if (p.foto && p.foto.trim() !== '') {
                                                        if (p.foto.startsWith('foto_kepsek')) {
                                                            pFoto = '/uploads/profil/' + p.foto;
                                                        } else if (p.foto.startsWith('foto_komite')) {
                                                            pFoto = '/uploads/komite/' + p.foto;
                                                        } else if (p.foto.startsWith('foto-')) {
                                                            pFoto = '/uploads/guru/' + p.foto;
                                                        } else {
                                                            pFoto = '/uploads/struktur/' + p.foto;
                                                        }
                                                    }
                                                    %>
                                                    <img src="<%= pFoto %>" alt="<%= p.nama_lengkap %>" class="w-10 h-10 rounded-full object-cover border border-slate-200" onerror="this.onerror=null; this.src='/img/default-avatar.svg';">
                                                    <span class="font-bold text-slate-800"><%= p.nama_lengkap %></span>
                                                </div>
                                            </td>
                                            <td class="py-3 px-4 text-xs font-mono text-slate-500">
                                                <%= (p.nip && p.nip !== '-') ? p.nip : '-' %>
                                            </td>
                                            <td class="py-3 px-4 font-semibold text-xs text-blue-900">
                                                <%= p.jabatan %>
                                            </td>
                                            <td class="py-3 px-4">
                                                <span class="px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase tracking-wide bg-blue-50 text-blue-700 border border-blue-200">
                                                    <%= p.kategori || 'Pimpinan' %>
                                                </span>
                                            </td>
                                            <td class="py-3 px-4 text-center">
                                                <div class="flex items-center justify-center gap-2">
                                                    <button type="button" 
                                                            class="btn-edit-struktur px-2.5 py-1.5 text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 rounded-lg transition flex items-center gap-1.5 shadow-xs cursor-pointer"
                                                            data-id="<%= p.id %>"
                                                            data-nama="<%= p.nama_lengkap %>"
                                                            data-nip="<%= p.nip || '' %>"
                                                            data-jabatan="<%= p.jabatan %>"
                                                            data-kategori="<%= p.kategori || 'Pimpinan' %>"
                                                            data-urutan="<%= p.urutan || 1 %>">
                                                        <i class="fa-solid fa-pen-to-square text-xs pointer-events-none"></i>
                                                        <span class="pointer-events-none">Edit</span>
                                                    </button>
                                                    <form action="/admin/struktur-organisasi/anggota/hapus/<%= p.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data <%= p.nama_lengkap %>?')">
                                                        <button type="submit" class="px-2.5 py-1.5 text-xs font-semibold text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition flex items-center gap-1.5 shadow-xs cursor-pointer">
                                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                                            <span>Hapus</span>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

            <!-- ============================================== -->
            <!-- TAB 5: EDIT PROFIL SEKOLAH -->
            <!-- ============================================== -->
            <div id="tab-profil" class="tab-content">
                <form action="/admin/profil/update" method="POST" enctype="multipart/form-data" class="space-y-6">
                    
                    <!-- Top Save Bar -->
                    <div class="flex items-center justify-between bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Edit Profil & Informasi Sekolah</h3>
                            <p class="text-xs text-slate-400">Data ini tampil secara langsung di halaman depan website sekolah</p>
                        </div>
                        <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span>Simpan Perubahan Profil</span>
                        </button>
                    </div>

                    <!-- Section: Logo Resmi Sekolah (Kustomisasi Terpusat) -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-100 gap-2">
                            <h4 class="font-bold text-sm text-blue-950 flex items-center gap-2">
                                <i class="fa-solid fa-certificate text-amber-500"></i>
                                <span>Logo Resmi Sekolah (Kustomisasi Terpusat)</span>
                            </h4>
                            <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200 shrink-0 self-start sm:self-auto flex items-center gap-1.5">
                                <i class="fa-solid fa-circle-check text-[10px]"></i>
                                <span>Otomatis Sinkron ke Seluruh Halaman Website</span>
                            </span>
                        </div>

                        <div class="grid md:grid-cols-12 gap-5 items-center bg-slate-50 p-5 rounded-2xl border border-slate-200">
                            <!-- Live Preview Box -->
                            <div class="md:col-span-4 flex flex-col items-center justify-center p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
                                <span class="text-[11px] font-bold text-slate-500 mb-2 uppercase tracking-wider">Pratinjau Logo</span>
                                <div class="w-28 h-28 rounded-2xl bg-slate-50 border border-slate-200 p-2.5 flex items-center justify-center shadow-inner relative group">
                                    <img id="logo-preview-img" src="<%= (profil && profil.logo_sekolah) ? ('/uploads/profil/' + profil.logo_sekolah) : '/uploads/profil/logo-smpn1-rantepao.svg' %>" alt="Logo Sekolah" class="w-full h-full object-contain relative z-10 transition-transform group-hover:scale-105" onerror="this.src='/uploads/profil/logo-smpn1-rantepao.svg'">
                                </div>
                                <p id="logo-preview-filename" class="text-[10px] text-slate-500 mt-2 text-center font-mono truncate max-w-full">
                                    <%= (profil && profil.logo_sekolah) ? profil.logo_sekolah : 'logo-smpn1-rantepao.svg' %>
                                </p>
                            </div>

                            <!-- Upload & Instructions Controls -->
                            <div class="md:col-span-8 space-y-3">
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1.5 flex items-center gap-1.5">
                                        <span>Pilih Berkas Logo Baru</span>
                                        <span class="text-amber-600 text-[10px] font-medium">(PNG transparan, SVG, WEBP, atau JPG)</span>
                                    </label>
                                    <input type="file" name="logo_sekolah" id="input-logo-sekolah" accept="image/*,.svg" onchange="previewLogoSekolah(this)" class="w-full text-xs text-slate-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer bg-white border border-slate-300 rounded-xl p-1.5">
                                </div>

                                <div class="bg-blue-50/80 rounded-xl p-3 border border-blue-200/70 text-[11px] text-blue-900 space-y-1">
                                    <div class="font-bold flex items-center gap-1.5 text-blue-950">
                                        <i class="fa-solid fa-lightbulb text-amber-500"></i>
                                        <span>Panduan Logo Resmi:</span>
                                    </div>
                                    <ul class="list-disc list-inside space-y-0.5 text-slate-600 pl-1 text-[10.5px]">
                                        <li>Logo yang diunggah di sini akan otomatis diterapkan pada: <strong>Navbar atas, Preloader, Favicon browser, Footer bawah, Lembar Bukti PPDB, Portal Calon Siswa, dan Sidebar Panel Admin</strong>.</li>
                                        <li>Disarankan menggunakan gambar dengan latar belakang <strong>transparan (PNG / SVG)</strong> berasio 1:1 (persegi/bulat).</li>
                                        <li>Biarkan isian file kosong jika ingin tetap menggunakan logo yang ada saat ini.</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Identitas & Kontak -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-school text-blue-900"></i>
                            <span>Identitas Umum, Statistik Siswa & Akreditasi</span>
                        </h4>
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Resmi Sekolah</label>
                                <input type="text" name="nama_sekolah" value="<%= profil.nama_sekolah || '' %>" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">NPSN</label>
                                <input type="text" name="npsn" value="<%= profil.npsn || '' %>" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Akreditasi</label>
                                <input type="text" name="akreditasi" value="<%= profil.akreditasi || '' %>" required placeholder="Contoh: A" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>

                        <div class="grid md:grid-cols-2 gap-4 pt-2">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Total Jumlah Siswa Aktif</label>
                                <input type="number" name="jumlah_siswa" value="<%= profil.jumlah_siswa || 886 %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Jumlah Rombongan Belajar (Rombel)</label>
                                <input type="number" name="jumlah_rombel" value="<%= profil.jumlah_rombel || 24 %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>

                        <div class="grid md:grid-cols-2 gap-4 pt-2">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Nomor Telepon Sekolah</label>
                                <input type="text" name="telepon" value="<%= profil.telepon || '' %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Email Resmi Sekolah</label>
                                <input type="email" name="email_sekolah" value="<%= profil.email_sekolah || '' %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Alamat Lengkap Sekolah</label>
                            <textarea name="alamat" rows="2" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.alamat || '' %></textarea>
                        </div>
                    </div>

                    <!-- Section: Kepala Sekolah -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-user-tie text-blue-900"></i>
                            <span>Data Kepala Sekolah & Sambutan Resmi</span>
                        </h4>

                        <div class="grid md:grid-cols-12 gap-4 items-start">
                            <div class="md:col-span-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
                                <label class="block text-xs font-bold text-slate-700 mb-2">Foto Resmi Kepala Sekolah</label>
                                <div class="flex items-center gap-3">
                                    <div class="w-20 h-24 rounded-xl overflow-hidden bg-slate-200 border border-slate-300 flex-shrink-0 shadow-xs">
                                        <% if (profil.foto_kepsek && profil.foto_kepsek !== 'kepsek.jpg') { %>
                                            <img src="/uploads/profil/<%= profil.foto_kepsek %>" alt="Kepala Sekolah" class="w-full h-full object-cover">
                                        <% } else { %>
                                            <div class="w-full h-full flex flex-col items-center justify-center text-slate-400 bg-slate-100 text-xs">
                                                <i class="fa-solid fa-user-tie text-2xl mb-1 text-slate-400"></i>
                                                <span class="text-[9px]">Belum Ada</span>
                                            </div>
                                        <% } %>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <input type="file" name="foto_kepsek" accept="image/*" class="w-full text-[11px] text-slate-500 file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-[11px] file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer">
                                        <p class="text-[10px] text-slate-400 mt-1.5 leading-snug">Format: JPG, PNG, WEBP (Maks 2MB). Kosongkan jika foto tidak diubah.</p>
                                    </div>
                                </div>
                            </div>

                            <div class="md:col-span-8 grid sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Lengkap Kepala Sekolah (beserta Gelar) *</label>
                                    <input type="text" name="nama_kepsek" value="<%= profil.nama_kepsek || '' %>" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-600 mb-1">NIP Kepala Sekolah</label>
                                    <input type="text" name="nip_kepsek" value="<%= profil.nip_kepsek || '' %>" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                                </div>
                                <div class="sm:col-span-2">
                                    <label class="block text-xs font-semibold text-slate-600 mb-1">Teks Sambutan Kepala Sekolah</label>
                                    <textarea name="sambutan_kepsek" rows="4" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.sambutan_kepsek || '' %></textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Visi, Misi & Sejarah -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-scroll text-blue-900"></i>
                            <span>Visi, Misi & Sejarah Singkat</span>
                        </h4>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Visi Sekolah</label>
                            <textarea name="visi" rows="3" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.visi || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Misi Sekolah (Gunakan baris baru atau penomoran)</label>
                            <textarea name="misi" rows="5" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.misi || '' %></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Sejarah Singkat Sekolah</label>
                            <textarea name="sejarah" rows="4" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600"><%= profil.sejarah || '' %></textarea>
                        </div>
                    </div>

                    <!-- Section: Google Maps Embed & Kustomisasi Lokasi Sekolah -->
                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
                        <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                            <i class="fa-solid fa-map-location-dot text-blue-900"></i>
                            <span>Pengaturan Lokasi & Peta Sekolah</span>
                        </h4>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Judul / Label Lokasi</label>
                                <input type="text" name="label_lokasi" value="<%= profil.label_lokasi || 'Lokasi Sekolah' %>" placeholder="Contoh: Lokasi Sekolah" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Wilayah / Kota</label>
                                <input type="text" name="wilayah_lokasi" value="<%= profil.wilayah_lokasi || 'Kec. Rantepao, Toraja Utara' %>" placeholder="Contoh: Kec. Rantepao, Toraja Utara" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Keterangan Gedung / Status</label>
                                <input type="text" name="keterangan_lokasi" value="<%= profil.keterangan_lokasi || 'Gedung Utama' %>" placeholder="Contoh: Gedung Utama" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 text-slate-800 focus:outline-blue-600">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Kode / URL Embed Google Maps (iframe / link)</label>
                            <textarea name="maps_embed" rows="3" placeholder="https://maps.google.com/..." class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 font-mono text-slate-600 focus:outline-blue-600"><%= profil.maps_embed || '' %></textarea>
                            <p class="text-[11px] text-slate-400 mt-1">Kosongkan jika ingin menggunakan tampilan peta bawaan berdasar alamat sekolah.</p>
                        </div>
                    </div>

                    <div class="flex justify-end pt-2 pb-4">
                        <button type="submit" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span>Simpan Semua Perubahan Profil</span>
                        </button>
                    </div>

                </form>

                
                <!-- ============================================================== -->
                <!-- SECTION: KELOLA BANNER SLIDER BERANDA (HERO SHOWCASE)          -->
                <!-- ============================================================== -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm mt-8 space-y-5">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-100">
                        <div class="flex items-center gap-3">
                            <span class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg shadow-sm">
                                <i class="fa-solid fa-images"></i>
                            </span>
                            <div>
                                <h4 class="font-bold text-base text-blue-950 flex items-center gap-2">
                                    <span>Banner Slider Beranda (Hero Showcase)</span>
                                    <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200/60">
                                        <%= (typeof heroSliders !== 'undefined' && heroSliders) ? heroSliders.length : 0 %> Slide
                                    </span>
                                </h4>
                                <p class="text-xs text-slate-500 mt-0.5">Kelola gambar banner bergerak utama di halaman depan beranda website sekolah.</p>
                            </div>
                        </div>
                        <button type="button" onclick="openModal('modal-tambah-slider')" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md transition hover:-translate-y-0.5">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Tambah Slide Banner</span>
                        </button>
                    </div>

                    <!-- Grid Card Slider -->
                    <% if (typeof heroSliders !== 'undefined' && heroSliders && heroSliders.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        <% heroSliders.forEach((slide, idx) => { %>
                        <div class="group relative bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden hover:shadow-lg transition-all duration-200 flex flex-col justify-between">
                            <div>
                                <!-- Image Preview & Badges -->
                                <div class="relative h-44 w-full bg-slate-900 overflow-hidden">
                                    <img src="<%= slide.gambar.startsWith('http') ? slide.gambar : (slide.gambar.startsWith('/') ? slide.gambar : '/' + slide.gambar) %>" 
                                         alt="<%= slide.judul %>" 
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/30 to-black/30"></div>
                                    
                                    <!-- Badges Urutan & Status -->
                                    <div class="absolute top-3 left-3 flex items-center gap-1.5">
                                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/95 text-slate-800 shadow-sm backdrop-blur-sm flex items-center gap-1">
                                            <i class="fa-solid fa-arrow-down-1-9 text-slate-500 text-[10px]"></i>
                                            Urutan: #<%= slide.urutan %>
                                        </span>
                                    </div>

                                    <div class="absolute top-3 right-3">
                                        <% if (slide.status_aktif === 'Aktif') { %>
                                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-emerald-500 text-white shadow-sm flex items-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                            Aktif
                                        </span>
                                        <% } else { %>
                                        <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-600 text-slate-200 shadow-sm flex items-center gap-1">
                                            <i class="fa-solid fa-eye-slash text-[10px]"></i>
                                            Nonaktif
                                        </span>
                                        <% } %>
                                    </div>

                                    <div class="absolute bottom-3 left-3 right-3">
                                        <h5 class="text-white font-bold text-sm leading-snug line-clamp-1 drop-shadow"><%= slide.judul %></h5>
                                    </div>
                                </div>

                                <!-- Body Info -->
                                <div class="p-4 space-y-2.5">
                                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                                        <%= slide.deskripsi || 'Tidak ada deskripsi tambahan.' %>
                                    </p>

                                    <div class="pt-2.5 border-t border-slate-200/70 text-[11px] text-slate-500 flex items-center gap-1.5">
                                        <i class="fa-solid fa-arrow-up-right-from-square text-blue-500 text-[10px]"></i>
                                        <span class="font-medium text-slate-700">Tombol:</span>
                                        <span class="truncate bg-slate-200/70 px-2 py-0.5 rounded text-slate-700 font-mono text-[10px]" title="<%= slide.teks_tombol %> -> <%= slide.link_tombol %>">
                                            <%= slide.teks_tombol || 'Selengkapnya' %> &rarr; <%= slide.link_tombol || '#' %>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Footer Actions -->
                            <div class="px-4 py-3 bg-white border-t border-slate-200/70 flex items-center justify-between gap-2">
                                <!-- Form Toggle Status -->
                                <form action="/admin/slider/toggle/<%= slide.id %>" method="POST" class="inline">
                                    <button type="submit" 
                                            class="text-[11px] font-semibold px-2.5 py-1.5 rounded-lg border transition <%= slide.status_aktif === 'Aktif' ? 'border-amber-200 bg-amber-50 text-amber-700 hover:bg-amber-100' : 'border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100' %>"
                                            title="Ubah Status Tampil">
                                        <i class="fa-solid <%= slide.status_aktif === 'Aktif' ? 'fa-pause' : 'fa-play' %> mr-1"></i>
                                        <%= slide.status_aktif === 'Aktif' ? 'Nonaktifkan' : 'Aktifkan' %>
                                    </button>
                                </form>

                                <div class="flex items-center gap-1.5">
                                    <!-- Edit Button -->
                                    <button type="button" 
                                            class="btn-edit-slider p-2 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition text-xs" 
                                            title="Edit Slide Banner"
                                            data-id="<%= slide.id %>"
                                            data-judul="<%= slide.judul %>"
                                            data-deskripsi="<%= slide.deskripsi || '' %>"
                                            data-tekstombol="<%= slide.teks_tombol || '' %>"
                                            data-linktombol="<%= slide.link_tombol || '' %>"
                                            data-urutan="<%= slide.urutan %>"
                                            data-status="<%= slide.status_aktif %>"
                                            data-gambar="<%= slide.gambar %>">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>

                                    <!-- Delete Button -->
                                    <form action="/admin/slider/hapus/<%= slide.id %>" method="POST" class="inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus slide banner ini? Gambar file banner akan ikut terhapus dari server.');">
                                        <button type="submit" class="p-2 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition text-xs" title="Hapus Slide Banner">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <% } else { %>
                    <div class="py-12 px-4 text-center bg-slate-50 border-2 border-dashed border-slate-200 rounded-2xl">
                        <i class="fa-solid fa-images text-3xl text-slate-300 mb-3 block"></i>
                        <h5 class="text-sm font-bold text-slate-700">Belum Ada Slide Banner Beranda</h5>
                        <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Tambahkan slide banner pertama untuk ditampilkan pada showcase beranda utama website.</p>
                        <button type="button" onclick="openModal('modal-tambah-slider')" class="mt-4 inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Tambah Slide Baru</span>
                        </button>
                    </div>
                    <% } %>
                </div>

                <!-- Section: Keamanan & Ganti Password Admin -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm mt-8 space-y-4">
                    <h4 class="font-bold text-sm text-blue-950 pb-2 border-b border-slate-100 flex items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-blue-900"></i>
                        <span>Keamanan Akun & Ganti Password Administrator</span>
                    </h4>
                    <form action="/admin/profil/ganti-password" method="POST" class="space-y-4">
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Password Saat Ini (Lama)</label>
                                <input type="password" name="password_lama" required placeholder="Masukkan password lama" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Password Baru</label>
                                <input type="password" name="password_baru" required placeholder="Minimal 5 karakter" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">Konfirmasi Password Baru</label>
                                <input type="password" name="konfirmasi_password" required placeholder="Ulangi password baru" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                            </div>
                        </div>
                        <div class="flex justify-end pt-2">
                            <button type="submit" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs rounded-xl transition shadow flex items-center gap-2">
                                <i class="fa-solid fa-key text-xs"></i>
                                <span>Perbarui Kata Sandi Akun</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 6: PESAN MASUK -->
            <!-- ============================================== -->
            <div id="tab-pesan" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Pesan dari Pengunjung Website</h3>
                            <p class="text-xs text-slate-400">Pertanyaan dan formulir kontak yang dikirim oleh masyarakat/orang tua</p>
                        </div>
                        <span class="text-xs font-semibold px-3 py-1 bg-purple-50 text-purple-700 rounded-lg border border-purple-200">
                            Total: <%= stats.totalPesan %> Pesan (<%= stats.pesanBaru %> Baru)
                        </span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Pengirim & Kontak</th>
                                    <th class="py-3 px-4">Subjek & Pesan</th>
                                    <th class="py-3 px-4">Tanggal Kirim</th>
                                    <th class="py-3 px-4">Status</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (pesan.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-8 text-center text-xs text-slate-400">Belum ada pesan yang masuk.</td>
                                    </tr>
                                <% } %>
                                <% pesan.forEach(msg => { %>
                                    <tr class="hover:bg-slate-50/80 transition <%= msg.status_baca === 'Belum Dibaca' ? 'bg-purple-50/20 font-medium' : '' %>">
                                        <td class="py-3 px-4">
                                            <p class="font-semibold text-slate-800 text-xs"><%= msg.nama_pengirim %></p>
                                            <p class="text-[10px] text-slate-500"><%= msg.email_atau_wa %></p>
                                        </td>
                                        <td class="py-3 px-4 max-w-sm">
                                            <p class="text-xs font-bold text-slate-800"><%= msg.subjek %></p>
                                            <p class="text-xs text-slate-500 line-clamp-1"><%= msg.isi_pesan %></p>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">
                                            <%= new Date(msg.tanggal_kirim).toLocaleDateString('id-ID') %>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="text-[10px] font-semibold px-2 py-0.5 rounded <%= msg.status_baca === 'Belum Dibaca' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-slate-100 text-slate-600' %>">
                                                <%= msg.status_baca %>
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button" 
                                                        class="btn-detail-pesan p-1.5 text-purple-600 hover:bg-purple-50 rounded-md transition" 
                                                        title="Baca Lengkap"
                                                        data-pengirim="<%= msg.nama_pengirim %>"
                                                        data-kontak="<%= msg.email_atau_wa %>"
                                                        data-subjek="<%= msg.subjek %>"
                                                        data-isi="<%= msg.isi_pesan %>"
                                                        data-tanggal="<%= new Date(msg.tanggal_kirim).toLocaleString('id-ID') %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                                </button>
                                                <% if (msg.status_baca === 'Belum Dibaca') { %>
                                                    <form action="/admin/pesan/baca/<%= msg.id_pesan %>" method="POST">
                                                        <button type="submit" class="p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-md transition" title="Tandai Sudah Dibaca">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                        </button>
                                                    </form>
                                                <% } %>
                                                <form action="/admin/pesan/hapus/<%= msg.id_pesan %>" method="POST" onsubmit="return confirm('Hapus pesan ini?')">
                                                    <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Pesan">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 7: KELOLA EKSTRAKURIKULER -->
            <!-- ============================================== -->
            <div id="tab-eskul" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Daftar Ekstrakurikuler Siswa</h3>
                            <p class="text-xs text-slate-400">Kelola kegiatan pengembangan bakat, minat, kepanduan, dan seni budaya Toraja</p>
                        </div>
                        <button type="button" onclick="openModal('modal-tambah-eskul')" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-sm transition">
                            <i class="fa-solid fa-plus text-xs"></i>
                            <span>Tambah Eskul</span>
                        </button>
                    </div>

                    <div class="p-4 bg-slate-50 border-b border-slate-100">
                        <input type="text" id="search-eskul" onkeyup="filterEskulTable()" placeholder="Cari ekstrakurikuler atau pembina..." class="w-full sm:w-80 text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white focus:outline-blue-600">
                    </div>

                    <div class="overflow-x-auto">
                        <table id="table-eskul" class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-50 text-slate-500 text-[11px] uppercase tracking-wider font-semibold border-b border-slate-100">
                                    <th class="py-3 px-4">Foto & Nama Eskul</th>
                                    <th class="py-3 px-4">Guru Pembina</th>
                                    <th class="py-3 px-4">Jadwal Latihan</th>
                                    <th class="py-3 px-4">Deskripsi Kegiatan</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (typeof eskul !== 'undefined' && eskul.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="py-8 text-center text-xs text-slate-400">Belum ada data ekstrakurikuler.</td>
                                    </tr>
                                <% } %>
                                <% if (typeof eskul !== 'undefined') { %>
                                    <% eskul.forEach(e => { %>
                                        <tr class="hover:bg-slate-50/80 transition">
                                            <td class="py-3 px-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-12 h-10 rounded-lg overflow-hidden bg-slate-900 border border-slate-200 flex-shrink-0">
                                                        <% if (e.foto_eskul && e.foto_eskul !== 'default-eskul.jpg') { %>
                                                            <img src="/uploads/eskul/<%= e.foto_eskul %>" alt="<%= e.nama_eskul %>" class="w-full h-full object-cover">
                                                        <% } else { %>
                                                            <div class="w-full h-full flex items-center justify-center text-amber-400 text-xs font-bold">
                                                                <i class="fa-solid fa-medal text-sm"></i>
                                                            </div>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-bold text-slate-800 text-xs"><%= e.nama_eskul %></p>
                                                        <span class="text-[10px] text-slate-400">ID #<%= e.id_eskul %></span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-3 px-4 text-xs font-medium text-slate-700">
                                                <%= e.pembina %>
                                            </td>
                                            <td class="py-3 px-4 text-xs text-slate-600 whitespace-nowrap">
                                                <i class="fa-regular fa-clock text-slate-400 mr-1"></i><%= e.jadwal_latihan %>
                                            </td>
                                            <td class="py-3 px-4 text-xs text-slate-500 max-w-xs">
                                                <p class="line-clamp-2"><%= e.deskripsi %></p>
                                            </td>
                                            <td class="py-3 px-4 text-center whitespace-nowrap">
                                                <div class="inline-flex items-center gap-1.5">
                                                    <button type="button" 
                                                            class="btn-edit-eskul p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition" 
                                                            title="Edit Eskul"
                                                            data-id="<%= e.id_eskul %>"
                                                            data-nama="<%= e.nama_eskul %>"
                                                            data-pembina="<%= e.pembina %>"
                                                            data-jadwal="<%= e.jadwal_latihan %>"
                                                            data-deskripsi="<%= e.deskripsi %>">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                                    </button>
                                                    <form action="/admin/eskul/hapus/<%= e.id_eskul %>" method="POST" onsubmit="return confirm('Hapus ekstrakurikuler <%= e.nama_eskul %>?')">
                                                        <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-md transition" title="Hapus Eskul">
                                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 8: KELOLA GALERI FOTO -->
            <!-- ============================================== -->
            <div id="tab-galeri" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h3 class="font-bold text-base text-slate-800">Galeri Dokumentasi Foto Sekolah</h3>
                            <p class="text-xs text-slate-400">Dokumentasi kegiatan akademik, perayaan seni budaya Toraja, fasilitas, dan prestasi</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <a href="/galeri" target="_blank" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition">
                                ↗ Buka Halaman Galeri
                            </a>
                            <button type="button" onclick="openModal('modal-tambah-galeri')" class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-sm transition">
                                <i class="fa-solid fa-plus text-xs"></i>
                                <span>Upload Foto Galeri</span>
                            </button>
                        </div>
                    </div>

                    <div class="p-4 bg-slate-50 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <input type="text" id="search-galeri" onkeyup="filterGaleriCards()" placeholder="Cari judul dokumentasi..." class="w-full sm:w-80 text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white focus:outline-blue-600">
                        <span class="text-xs text-slate-500 font-medium">Total: <%= (typeof stats !== 'undefined' && stats.totalGaleri) ? stats.totalGaleri : 0 %> Foto Terpublikasi</span>
                    </div>

                    <!-- Gallery Cards in Admin -->
                    <div class="p-6">
                        <% if (typeof galeri !== 'undefined' && galeri.length === 0) { %>
                            <div class="text-center py-12 text-slate-400 text-xs">
                                Belum ada foto dokumentasi di galeri. Klik tombol di atas untuk mengunggah foto.
                            </div>
                        <% } %>
                        <div id="galeri-admin-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                            <% if (typeof galeri !== 'undefined') { %>
                                <% galeri.forEach(foto => { %>
                                    <div class="galeri-admin-item bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col justify-between group">
                                        <div class="relative aspect-video bg-slate-900 overflow-hidden">
                                            <img src="/uploads/galeri/<%= foto.file_foto %>" alt="<%= foto.judul_foto %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                            <div class="absolute top-2 left-2">
                                                <% if (foto.kategori_galeri === 'Prestasi') { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500 text-blue-950 inline-flex items-center gap-1"><i class="fa-solid fa-trophy text-[9px]"></i> Prestasi</span>
                                                <% } else if (foto.kategori_galeri === 'Fasilitas') { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-600 text-white inline-flex items-center gap-1"><i class="fa-solid fa-building-columns text-[9px]"></i> Fasilitas</span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-600 text-white inline-flex items-center gap-1"><i class="fa-solid fa-masks-theater text-[9px]"></i> Kegiatan</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <div class="p-4 flex-1 flex flex-col justify-between">
                                            <div>
                                                <p class="text-[10px] text-slate-400 font-medium"><i class="fa-regular fa-calendar text-slate-400 mr-1"></i><%= new Date(foto.tanggal_upload).toLocaleDateString('id-ID') %></p>
                                                <h4 class="font-bold text-xs text-slate-800 mt-1 line-clamp-2"><%= foto.judul_foto %></h4>
                                                <p class="text-[11px] text-slate-500 mt-1.5 line-clamp-2"><%= foto.deskripsi_singkat %></p>
                                            </div>
                                            <div class="pt-3 mt-3 border-t border-slate-100 flex items-center justify-between">
                                                <button type="button" 
                                                        class="btn-edit-galeri text-xs font-semibold text-blue-600 hover:text-blue-800 transition flex items-center gap-1"
                                                        data-id="<%= foto.id_galeri %>"
                                                        data-judul="<%= foto.judul_foto %>"
                                                        data-kategori="<%= foto.kategori_galeri %>"
                                                        data-deskripsi="<%= foto.deskripsi_singkat %>"
                                                        data-tgl="<%= new Date(foto.tanggal_upload).toISOString().split('T')[0] %>">
                                                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                                                    <span>Edit</span>
                                                </button>
                                                <form action="/admin/galeri/hapus/<%= foto.id_galeri %>" method="POST" onsubmit="return confirm('Hapus foto ini dari galeri?')">
                                                    <button type="submit" class="text-xs font-semibold text-red-600 hover:text-red-800 transition flex items-center gap-1">
                                                        <i class="fa-solid fa-trash-can text-xs"></i>
                                                        <span>Hapus</span>
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 9: KELOLA PPDB (PENERIMAAN PESERTA DIDIK BARU) -->
            <!-- ============================================== -->
            <div id="tab-ppdb" class="tab-content">
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <!-- Action Header Bar -->
                    <div class="p-5 border-b border-slate-100 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                        <div>
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800 text-[11px] font-extrabold uppercase">T.A. <%= (typeof ppdbSetting !== 'undefined' && ppdbSetting.tahun_ajaran) ? ppdbSetting.tahun_ajaran : '2026/2027' %></span>
                                <% const statusLoketBadge = (typeof ppdbSetting !== 'undefined' && ppdbSetting.status_loket) ? ppdbSetting.status_loket : 'Buka'; %>
                                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider <%= statusLoketBadge === 'Buka' ? 'bg-emerald-100 text-emerald-800' : (statusLoketBadge === 'Tutup' ? 'bg-rose-100 text-rose-800' : 'bg-blue-100 text-blue-800') %>">
                                    Loket: <%= statusLoketBadge %>
                                </span>
                                <span class="text-xs text-slate-400">Total: <%= (typeof stats !== 'undefined' && stats.totalPPDB) ? stats.totalPPDB : 0 %> Calon Siswa (Kuota: <%= (typeof ppdbSetting !== 'undefined' && ppdbSetting.kuota_total) ? ppdbSetting.kuota_total : 320 %>)</span>
                            </div>
                            <h3 class="font-bold text-lg text-slate-800 mt-1">Penerimaan Peserta Didik Baru (PPDB)</h3>
                            <p class="text-xs text-slate-400">Verifikasi berkas, pantau 4 jalur seleksi, atur kuota gelombang, dan tetapkan kelulusan calon siswa baru</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <button type="button" onclick="openModal('modal-pengaturan-ppdb')" class="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-sliders text-xs"></i>
                                <span>Pengaturan PPDB & Kuota</span>
                            </button>
                            <button type="button" onclick="window.print()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-xl transition flex items-center gap-1.5 shadow-sm">
                                <i class="fa-solid fa-print text-xs"></i>
                                <span>Cetak Rekap</span>
                            </button>
                            <a href="/ppdb" target="_blank" class="px-3.5 py-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold rounded-xl transition flex items-center gap-1.5 border border-blue-200">
                                <span>↗ Form Publik</span>
                            </a>
                            <button type="button" onclick="openModal('modal-tambah-ppdb')" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold rounded-xl shadow-sm transition">
                                <i class="fa-solid fa-user-plus text-xs"></i>
                                <span>Tambah Pendaftar Manual</span>
                            </button>
                        </div>
                    </div>

                    <!-- Mini Stat Metric Cards -->
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 p-5 bg-slate-50 border-b border-slate-100">
                        <div class="p-4 bg-white rounded-xl border border-slate-200 shadow-xs">
                            <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Total Pendaftar</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-slate-800"><%= (typeof stats !== 'undefined' && stats.totalPPDB) ? stats.totalPPDB : 0 %></span>
                                <span class="text-xs font-bold text-slate-400">Berkas Masuk</span>
                            </div>
                        </div>

                        <div class="p-4 bg-white rounded-xl border border-amber-200/80 shadow-xs">
                            <span class="text-[11px] font-semibold text-amber-600 uppercase tracking-wider">Menunggu Verifikasi</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-amber-600"><%= (typeof stats !== 'undefined' && stats.ppdbMenunggu) ? stats.ppdbMenunggu : 0 %></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">Perlu Tindakan</span>
                            </div>
                        </div>

                        <div class="p-4 bg-white rounded-xl border border-blue-200/80 shadow-xs">
                            <span class="text-[11px] font-semibold text-blue-600 uppercase tracking-wider">Berkas Terverifikasi</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-blue-600"><%= (typeof stats !== 'undefined' && stats.ppdbTerverifikasi) ? stats.ppdbTerverifikasi : 0 %></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-800">Valid</span>
                            </div>
                        </div>

                        <div class="p-4 bg-white rounded-xl border border-emerald-200/80 shadow-xs">
                            <span class="text-[11px] font-semibold text-emerald-600 uppercase tracking-wider">Diterima / Lulus</span>
                            <div class="flex items-baseline justify-between mt-1">
                                <span class="text-2xl font-black text-emerald-600"><%= (typeof stats !== 'undefined' && stats.ppdbDiterima) ? stats.ppdbDiterima : 0 %></span>
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">Siswa Baru</span>
                            </div>
                        </div>
                    </div>

                    <!-- Toolbar Filters -->
                    <div class="p-4 bg-white border-b border-slate-100 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
                        <div class="relative flex-1 max-w-md">
                            <input type="text" id="search-ppdb" onkeyup="filterPPDBTable()" placeholder="Cari nama siswa, nomor reg, NISN, atau asal SD..." class="w-full text-xs border border-slate-300 rounded-xl pl-9 pr-3 py-2.5 bg-slate-50 focus:bg-white focus:outline-blue-600 transition">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-3.5 text-slate-400 text-xs"></i>
                        </div>

                        <div class="flex flex-wrap items-center gap-2">
                            <!-- Jalur Filter -->
                            <select id="filter-ppdb-jalur" onchange="filterPPDBTable()" class="text-xs border border-slate-300 rounded-xl px-3 py-2.5 bg-white text-slate-700 focus:outline-blue-600">
                                <option value="">Semua Jalur</option>
                                <option value="Zonasi">Jalur Zonasi</option>
                                <option value="Prestasi">Jalur Prestasi</option>
                                <option value="Afirmasi">Jalur Afirmasi</option>
                                <option value="Perpindahan Tugas">Jalur Perpindahan Tugas</option>
                            </select>

                            <!-- Status Filter -->
                            <select id="filter-ppdb-status" onchange="filterPPDBTable()" class="text-xs border border-slate-300 rounded-xl px-3 py-2.5 bg-white text-slate-700 focus:outline-blue-600">
                                <option value="">Semua Status</option>
                                <option value="Menunggu Verifikasi">Menunggu Verifikasi</option>
                                <option value="Berkas Terverifikasi">Berkas Terverifikasi</option>
                                <option value="Diterima">Diterima</option>
                                <option value="Tidak Diterima">Tidak Diterima</option>
                            </select>

                            <button type="button" onclick="resetPPDBFilter()" class="text-xs text-slate-500 hover:text-slate-800 px-2 py-2 font-medium">
                                ↺ Reset
                            </button>
                        </div>
                    </div>

                    <!-- Table List -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse" id="table-ppdb">
                            <thead>
                                <tr class="bg-slate-50/80 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3.5 px-4">No. Reg & Tanggal</th>
                                    <th class="py-3.5 px-4">Calon Siswa & NISN</th>
                                    <th class="py-3.5 px-4">Asal Sekolah SD</th>
                                    <th class="py-3.5 px-4">Jalur Pendaftaran</th>
                                    <th class="py-3.5 px-4">Orang Tua / Kontak</th>
                                    <th class="py-3.5 px-4">Status Seleksi</th>
                                    <th class="py-3.5 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 text-xs">
                                <% if (typeof pendaftarPPDB !== 'undefined' && pendaftarPPDB.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-12 text-slate-400">
                                            Belum ada data pendaftar calon siswa PPDB.
                                        </td>
                                    </tr>
                                <% } %>
                                <% if (typeof pendaftarPPDB !== 'undefined') { %>
                                    <% pendaftarPPDB.forEach(item => { %>
                                        <tr class="hover:bg-slate-50/80 transition ppdb-row" 
                                            data-jalur="<%= item.jalur_pendaftaran %>" 
                                            data-status="<%= item.status_seleksi %>">
                                            
                                            <!-- No Reg & Tanggal -->
                                            <td class="py-3.5 px-4">
                                                <span class="font-mono font-bold text-blue-900 bg-blue-50 px-2 py-0.5 rounded text-[11px] border border-blue-200/60 block w-max">
                                                    <%= item.no_pendaftaran %>
                                                </span>
                                                <span class="text-[10px] text-slate-400 block mt-1">
                                                    <i class="fa-regular fa-calendar text-slate-400 mr-1"></i><%= new Date(item.tanggal_daftar).toLocaleDateString('id-ID') %>
                                                </span>
                                            </td>

                                            <!-- Calon Siswa & NISN -->
                                            <td class="py-3.5 px-4">
                                                <div class="font-bold text-slate-900 text-sm flex items-center gap-1.5">
                                                    <span><%= item.nama_siswa %></span>
                                                    <span class="text-[10px] px-1.5 py-0.2 rounded font-semibold <%= item.jenis_kelamin === 'Perempuan' ? 'bg-pink-100 text-pink-700' : 'bg-blue-100 text-blue-700' %>">
                                                        <%= item.jenis_kelamin === 'Perempuan' ? 'P' : 'L' %>
                                                    </span>
                                                </div>
                                                <div class="text-[11px] text-slate-400 mt-0.5">
                                                    NISN: <span class="font-mono text-slate-600"><%= item.nisn || '-' %></span>
                                                </div>
                                            </td>

                                            <!-- Asal Sekolah -->
                                            <td class="py-3.5 px-4">
                                                <span class="font-medium text-slate-800"><%= item.asal_sekolah %></span>
                                                <span class="text-[10px] text-slate-400 block line-clamp-1 max-w-[180px]" title="<%= item.alamat_domisili %>">
                                                    <i class="fa-solid fa-location-dot text-slate-400 mr-1"></i><%= item.alamat_domisili %>
                                                </span>
                                            </td>

                                            <!-- Jalur Pendaftaran -->
                                            <td class="py-3.5 px-4">
                                                <% if (item.jalur_pendaftaran === 'Zonasi') { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-map-pin text-[10px]"></i> Zonasi
                                                    </span>
                                                <% } else if (item.jalur_pendaftaran === 'Prestasi') { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-trophy text-[10px]"></i> Prestasi
                                                    </span>
                                                <% } else if (item.jalur_pendaftaran === 'Afirmasi') { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-handshake-angle text-[10px]"></i> Afirmasi
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200 inline-flex items-center gap-1">
                                                        <i class="fa-solid fa-briefcase text-[10px]"></i> Perpindahan
                                                    </span>
                                                <% } %>
                                            </td>

                                            <!-- Orang Tua & Kontak -->
                                            <td class="py-3.5 px-4">
                                                <p class="font-semibold text-slate-800"><%= item.nama_ortu %></p>
                                                <% const cleanHp = item.no_hp ? item.no_hp.replace(/[^0-9]/g, '') : ''; %>
                                                <% const waLink = cleanHp.startsWith('0') ? '62' + cleanHp.substring(1) : cleanHp; %>
                                                <a href="https://wa.me/<%= waLink %>?text=Halo%20Bpk/Ibu%20<%= encodeURIComponent(item.nama_ortu) %>,%20kami%20dari%20Panitia%20PPDB%20SMPN%201%20Rantepao%20terkait%20pendaftaran%20ananda%20<%= encodeURIComponent(item.nama_siswa) %>" 
                                                   target="_blank" 
                                                   class="inline-flex items-center gap-1 text-[11px] text-emerald-600 hover:text-emerald-700 font-bold mt-0.5">
                                                    <i class="fa-brands fa-whatsapp text-emerald-600"></i>
                                                    <span><%= item.no_hp %></span>
                                                </a>
                                            </td>

                                            <!-- Status Seleksi -->
                                            <td class="py-3.5 px-4">
                                                <% if (item.status_seleksi === 'Menunggu Verifikasi') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                                        Menunggu Verifikasi
                                                    </span>
                                                <% } else if (item.status_seleksi === 'Berkas Terverifikasi') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-200">
                                                        <i class="fa-solid fa-circle-check text-xs"></i>
                                                        <span>Berkas Terverifikasi</span>
                                                    </span>
                                                <% } else if (item.status_seleksi === 'Diterima') { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                        <i class="fa-solid fa-award text-xs"></i>
                                                        <span>Diterima Lulus</span>
                                                    </span>
                                                <% } else { %>
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-red-50 text-red-700 border border-red-200">
                                                        <i class="fa-solid fa-circle-xmark text-xs"></i>
                                                        <span>Tidak Diterima</span>
                                                    </span>
                                                <% } %>
                                            </td>

                                            <!-- Aksi Buttons -->
                                            <td class="py-3.5 px-4 text-center">
                                                <div class="flex items-center justify-center gap-1.5">
                                                    <!-- Detail Button -->
                                                    <button type="button" 
                                                            class="btn-detail-ppdb p-1.5 text-blue-600 hover:bg-blue-50 rounded-lg transition"
                                                            title="Lihat Detail Lengkap"
                                                            data-id="<%= item.id_pendaftar %>"
                                                            data-no="<%= item.no_pendaftaran %>"
                                                            data-nama="<%= item.nama_siswa %>"
                                                            data-nisn="<%= item.nisn || '-' %>"
                                                            data-jk="<%= item.jenis_kelamin %>"
                                                            data-sekolah="<%= item.asal_sekolah %>"
                                                            data-jalur="<%= item.jalur_pendaftaran %>"
                                                            data-ortu="<%= item.nama_ortu %>"
                                                            data-hp="<%= item.no_hp %>"
                                                            data-alamat="<%= item.alamat_domisili %>"
                                                            data-catatan="<%= item.catatan || '-' %>"
                                                            data-status="<%= item.status_seleksi %>"
                                                            data-tanggal="<%= new Date(item.tanggal_daftar).toLocaleString('id-ID') %>"
                                                            data-email="<%= item.email || '-' %>"
                                                            data-nowa="<%= item.no_wa || item.no_hp || '-' %>"
                                                            data-tempatlahir="<%= item.tempat_lahir || '-' %>"
                                                            data-tanggallahir="<%= item.tanggal_lahir ? new Date(item.tanggal_lahir).toLocaleDateString('id-ID') : '-' %>"
                                                            data-agama="<%= item.agama || '-' %>"
                                                            data-npsn="<%= item.npsn_asal_sekolah || '-' %>"
                                                            data-ayah="<%= item.nama_ayah || '-' %>"
                                                            data-ibu="<%= item.nama_ibu || '-' %>"
                                                            data-pekerjaan="<%= item.pekerjaan_ortu || '-' %>"
                                                            data-penghasilan="<%= item.penghasilan_ortu || '-' %>"
                                                            data-foto="<%= item.berkas_foto || '' %>"
                                                            data-kk="<%= item.berkas_kk || '' %>"
                                                            data-akta="<%= item.berkas_akta || '' %>"
                                                            data-ijazah="<%= item.berkas_ijazah || '' %>">
                                                        <i class="fa-solid fa-eye text-xs"></i>
                                                    </button>

                                                    <!-- Ubah Status Button -->
                                                    <button type="button"
                                                            class="btn-status-ppdb p-1.5 text-amber-600 hover:bg-amber-50 rounded-lg transition"
                                                            title="Ubah Status Seleksi"
                                                            data-id="<%= item.id_pendaftar %>"
                                                            data-no="<%= item.no_pendaftaran %>"
                                                            data-nama="<%= item.nama_siswa %>"
                                                            data-status="<%= item.status_seleksi %>"
                                                            data-catatan="<%= item.catatan || '' %>">
                                                        <i class="fa-solid fa-scale-balanced text-xs"></i>
                                                    </button>

                                                    <!-- Edit Button -->
                                                    <button type="button"
                                                            class="btn-edit-ppdb p-1.5 text-emerald-600 hover:bg-emerald-50 rounded-lg transition"
                                                            title="Edit Data Pendaftar"
                                                            data-id="<%= item.id_pendaftar %>"
                                                            data-no="<%= item.no_pendaftaran %>"
                                                            data-nama="<%= item.nama_siswa %>"
                                                            data-nisn="<%= item.nisn || '' %>"
                                                            data-jk="<%= item.jenis_kelamin %>"
                                                            data-sekolah="<%= item.asal_sekolah %>"
                                                            data-jalur="<%= item.jalur_pendaftaran %>"
                                                            data-ortu="<%= item.nama_ortu %>"
                                                            data-hp="<%= item.no_hp %>"
                                                            data-alamat="<%= item.alamat_domisili %>"
                                                            data-catatan="<%= item.catatan || '' %>"
                                                            data-status="<%= item.status_seleksi %>">
                                                        <i class="fa-solid fa-pen-to-square text-xs"></i>
                                                    </button>

                                                    <!-- Delete Form -->
                                                    <form action="/admin/ppdb/hapus/<%= item.id_pendaftar %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data calon siswa <%= item.nama_siswa %> (<%= item.no_pendaftaran %>)?')">
                                                        <button type="submit" class="p-1.5 text-red-600 hover:bg-red-50 rounded-lg transition" title="Hapus Data">
                                                            <i class="fa-solid fa-trash-can text-xs"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                                    </form>
                                                </div>
                                            </td>

                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer Count Info -->
                    <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
                        <span id="ppdb-counter-text">Menampilkan semua calon siswa pendaftar PPDB</span>
                        <span>Panitia PPDB UPT SMPN 1 Rantepao</span>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- TAB 11: KELOLA HALAMAN PROFIL & SARANA (STATIS) -->
            <!-- ============================================== -->
                        <div id="tab-halaman-statis" class="tab-content space-y-6">
                <!-- Header Card -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600 text-xl font-bold shadow-sm shrink-0">
                            <i class="fa-solid fa-file-lines"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="font-extrabold text-lg text-slate-900 leading-tight">Kelola Konten Halaman Profil & Sarana</h3>
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                    ● Modal Popup Aktif
                                </span>
                            </div>
                            <p class="text-xs text-slate-500 mt-1 max-w-2xl">
                                Kelola isi teks, slip kartu, dan struktur kartu informasi yang muncul secara instan saat pengunjung mengklik sub-menu <strong>Profil / Tentang Kami</strong> di website (Sejarah Singkat, Sarana Prasarana, Program Kerja, dan Kondisi Siswa).
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <a href="/" target="_blank" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-700 transition flex items-center gap-2">
                            <i class="fa-solid fa-arrow-up-right-from-square text-xs text-slate-500"></i>
                            <span>Buka Web & Uji Modal</span>
                        </a>
                    </div>
                </div>

                <!-- Cards Grid List Halaman Profil -->
                <% const listHalaman = (typeof halamanStatis !== 'undefined' && Array.isArray(halamanStatis)) ? halamanStatis.filter(h => h.slug !== 'visi-misi') : []; %>
                <div class="grid lg:grid-cols-2 gap-5">
                    <% if (listHalaman.length > 0) { %>
                        <% listHalaman.forEach((hal) => { %>
                            <% 
                                const themeMap = {
                                    'amber': { bg: 'bg-amber-50', text: 'text-amber-600', border: 'border-amber-200', pill: 'bg-amber-100 text-amber-800' },
                                    'emerald': { bg: 'bg-emerald-50', text: 'text-emerald-600', border: 'border-emerald-200', pill: 'bg-emerald-100 text-emerald-800' },
                                    'purple': { bg: 'bg-purple-50', text: 'text-purple-600', border: 'border-purple-200', pill: 'bg-purple-100 text-purple-800' },
                                    'rose': { bg: 'bg-rose-50', text: 'text-rose-600', border: 'border-rose-200', pill: 'bg-rose-100 text-rose-800' },
                                    'cyan': { bg: 'bg-cyan-50', text: 'text-cyan-600', border: 'border-cyan-200', pill: 'bg-cyan-100 text-cyan-800' },
                                    'indigo': { bg: 'bg-indigo-50', text: 'text-indigo-600', border: 'border-indigo-200', pill: 'bg-indigo-100 text-indigo-800' },
                                    'teal': { bg: 'bg-teal-50', text: 'text-teal-600', border: 'border-teal-200', pill: 'bg-teal-100 text-teal-800' },
                                    'blue': { bg: 'bg-blue-50', text: 'text-blue-600', border: 'border-blue-200', pill: 'bg-blue-100 text-blue-800' }
                                };
                                const theme = themeMap[hal.warna_badge] || themeMap['blue'];
                                const safeIkon = hal.ikon || 'fa-solid fa-file-lines';
                            %>
                            <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all p-5 flex flex-col justify-between group">
                                <div>
                                    <!-- Card Header -->
                                    <div class="flex items-start justify-between gap-3 pb-3 border-b border-slate-100">
                                        <div class="flex items-center gap-3">
                                            <div class="w-11 h-11 rounded-2xl <%= theme.bg %> <%= theme.text %> border <%= theme.border %> flex items-center justify-center text-lg font-bold shadow-xs shrink-0 transition-colors">
                                                <i class="<%= safeIkon %>"></i>
                                            </div>
                                            <div>
                                                <div class="flex flex-wrap items-center gap-2">
                                                    <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-slate-100 text-slate-600 border border-slate-200">
                                                        slug: <%= hal.slug %>
                                                    </span>
                                                    <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md <%= theme.pill %> border <%= theme.border %>">
                                                        ● <%= hal.warna_badge || 'blue' %>
                                                    </span>
                                                    <% 
                                                        let cardItemsCount = 0;
                                                        try {
                                                            const parsed = JSON.parse(hal.items_json || '[]');
                                                            if (Array.isArray(parsed)) cardItemsCount = parsed.length;
                                                        } catch(e) {}
                                                    %>
                                                    <% if (cardItemsCount > 0) { %>
                                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 border border-blue-200 flex items-center gap-1">
                                                            <i class="fa-solid fa-shapes text-blue-500"></i> <%= cardItemsCount %> Kartu Item
                                                        </span>
                                                    <% } %>
                                                </div>
                                                <h4 class="font-extrabold text-base text-slate-900 mt-1.5 leading-snug">
                                                    <%= hal.judul %>
                                                </h4>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Content Preview -->
                                    <div class="py-3">
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Deskripsi Slip Kartu:</p>
                                        <div class="p-3 bg-slate-50/90 rounded-xl border border-slate-100 text-xs text-slate-600 line-clamp-2 leading-relaxed">
                                            <%= hal.ringkasan || (hal.konten || '').replace(/<[^>]*>?/gm, ' ').replace(/\s+/g, ' ').trim() %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Card Footer Actions -->
                                <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
                                    <span class="flex items-center gap-1.5 text-[11px]">
                                        <i class="fa-solid fa-clock-rotate-left text-slate-300"></i>
                                        <span>Update: <%= new Date(hal.updated_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <button type="button" 
                                            class="btn-preview-halaman px-3 py-1.5 rounded-xl text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 transition flex items-center gap-1.5 cursor-pointer"
                                            data-slug="<%= hal.slug %>"
                                            data-judul="<%= hal.judul %>"
                                            data-konten="<%= encodeURIComponent(hal.konten || '') %>">
                                            <i class="fa-solid fa-eye text-xs text-slate-500"></i>
                                            <span>Pratinjau</span>
                                        </button>
                                        <button type="button" 
                                            class="btn-edit-halaman px-3.5 py-1.5 rounded-xl text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 transition flex items-center gap-1.5 shadow-sm cursor-pointer"
                                            data-id="<%= hal.id %>"
                                            data-slug="<%= hal.slug %>"
                                            data-judul="<%= hal.judul %>"
                                            data-ikon="<%= safeIkon %>"
                                            data-ringkasan="<%= encodeURIComponent(hal.ringkasan || '') %>"
                                            data-warna-badge="<%= hal.warna_badge || 'blue' %>"
                                            data-pembuka="<%= encodeURIComponent(hal.paragraf_pembuka || '') %>"
                                            data-penutup="<%= encodeURIComponent(hal.paragraf_penutup || '') %>"
                                            data-items="<%= encodeURIComponent(hal.items_json || '[]') %>"
                                            data-konten="<%= encodeURIComponent(hal.konten || '') %>">
                                            <i class="fa-solid fa-pen-to-square text-xs"></i>
                                            <span>Edit Konten & Slip</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="col-span-full py-12 text-center bg-white rounded-2xl border border-slate-200">
                            <i class="fa-solid fa-file-circle-exclamation text-4xl text-slate-300 mb-3"></i>
                            <p class="font-bold text-slate-700">Belum ada halaman profil</p>
                            <p class="text-xs text-slate-400 mt-1">Data awal sedang diinisialisasi oleh sistem.</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </main>
    </div>

    <!-- ============================================== -->
    <!-- MODALS SECTION -->
    <!-- ============================================== -->

    <!-- MODAL TAMBAH EKSTRAKURIKULER -->
    <div id="modal-tambah-eskul" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-plus text-blue-600"></i>
                    <span>Tambah Ekstrakurikuler</span>
                </h3>
                <button type="button" onclick="closeModal('modal-tambah-eskul')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form action="/admin/eskul/tambah" method="POST" enctype="multipart/form-data" class="space-y-4 mt-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Ekstrakurikuler</label>
                    <input type="text" name="nama_eskul" required placeholder="Contoh: Sanggar Seni Pa'gellu Toraja" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Guru Pembina</label>
                        <input type="text" name="pembina" required placeholder="Contoh: Ibu Margaretha, S.Sn." class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Jadwal Latihan</label>
                        <input type="text" name="jadwal_latihan" required placeholder="Contoh: Jumat, 15.00 - 17.00 WITA" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Deskripsi Kegiatan</label>
                    <textarea name="deskripsi" rows="3" required placeholder="Jelaskan tujuan dan kegiatan eskul..." class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600"></textarea>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Foto Kegiatan / Eskul (Opsional)</label>
                    <input type="file" name="foto_eskul" accept="image/*" class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 focus:outline-blue-600 bg-white">
                </div>
                <div class="flex justify-end gap-2 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeModal('modal-tambah-eskul')" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Batal</button>
                    <button type="submit" class="px-5 py-2 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm">Simpan Eskul</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDIT EKSTRAKURIKULER -->
    <div id="modal-edit-eskul" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-blue-600"></i>
                    <span>Edit Ekstrakurikuler</span>
                </h3>
                <button type="button" onclick="closeModal('modal-edit-eskul')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <form id="form-edit-eskul" method="POST" enctype="multipart/form-data" class="space-y-4 mt-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nama Ekstrakurikuler</label>
                    <input type="text" id="edit-eskul-nama" name="nama_eskul" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Guru Pembina</label>
                        <input type="text" id="edit-eskul-pembina" name="pembina" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Jadwal Latihan</label>
                        <input type="text" id="edit-eskul-jadwal" name="jadwal_latihan" required class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
