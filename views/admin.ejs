                    <!-- PANEL 2: EDITOR VISUAL BEBAS & WYSIWYG -->
                    <div id="mode-content-wysiwyg" class="hidden space-y-2">
                        <div class="p-2.5 bg-amber-50 rounded-xl border border-amber-200 text-[11px] text-amber-800 flex items-center gap-2">
                            <i class="fa-solid fa-circle-info text-amber-600 text-xs shrink-0"></i>
