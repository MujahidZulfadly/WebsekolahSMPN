                                    <button type="button" onclick="selectQuickIcon('fa-solid fa-handshake')" class="px-2 py-1 rounded-lg bg-white hover:bg-teal-50 hover:text-teal-700 hover:border-teal-300 border border-slate-200 text-slate-700 text-[11px] font-medium transition flex items-center gap-1.5 shadow-2xs cursor-pointer" title="Kemitraan / Komite">
                                        <i class="fa-solid fa-handshake text-teal-500 text-xs"></i> <span>Komite</span>
                                    </button>
                                    <button type="button" onclick="selectQuickIcon('fa-solid fa-chalkboard-user')" class="px-2 py-1 rounded-lg bg-white hover:bg-amber-50 hover:text-amber-700 hover:border-amber-300 border border-slate-200 text-slate-700 text-[11px] font-medium transition flex items-center gap-1.5 shadow-2xs cursor-pointer" title="Civitas Guru">
