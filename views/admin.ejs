                                <button type="button" onclick="execVisualCmd('italic')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-800 italic text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Miring (Ctrl+I)">
