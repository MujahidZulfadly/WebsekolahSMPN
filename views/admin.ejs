                                    <button type="button" onclick="selectQuickIcon('fa-solid fa-book-open-reader')" class="px-2 py-1 rounded-lg bg-white hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-300 border border-slate-200 text-slate-700 text-[11px] font-medium transition flex items-center gap-1.5 shadow-2xs cursor-pointer" title="Perpustakaan & Literasi">
