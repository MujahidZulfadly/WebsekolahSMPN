                            <div class="flex items-center gap-1 pr-1.5 border-r border-slate-200">
                                <button type="button" onclick="execVisualCmd('justifyLeft')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Rata Kiri">
                                    <i class="fa-solid fa-align-left"></i>
                                </button>
                                <button type="button" onclick="execVisualCmd('justifyCenter')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Rata Tengah">
                                    <i class="fa-solid fa-align-center"></i>
                                </button>
                                <button type="button" onclick="execVisualCmd('justifyFull')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Rata Kanan-Kiri (Justify)">
                                    <i class="fa-solid fa-align-justify"></i>
                                </button>
                            </div>

                            <!-- Undo / Redo / Clear -->
                            <div class="flex items-center gap-1 ml-auto">
                                <button type="button" onclick="execVisualCmd('undo')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-600 text-xs flex items-center justify-center transition cursor-pointer" title="Urungkan (Undo - Ctrl+Z)">
                                    <i class="fa-solid fa-rotate-left"></i>
                                </button>
                                <button type="button" onclick="execVisualCmd('redo')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-600 text-xs flex items-center justify-center transition cursor-pointer" title="Ulangi (Redo - Ctrl+Y)">
