                                            <p class="line-clamp-2"><%= p.isi_pengumuman %></p>
                                        </td>
                                        <td class="py-3 px-4 text-xs text-slate-500 whitespace-nowrap">
                                            <%= new Date(p.tanggal_terbit).toLocaleDateString('id-ID') %>
                                        </td>
                                        <td class="py-3 px-4 text-center whitespace-nowrap">
                                            <div class="inline-flex items-center gap-1.5">
                                                <button type="button" 
                                                        class="btn-edit-pengumuman p-1.5 text-blue-600 hover:bg-blue-50 rounded-md transition" 
                                                        title="Edit Pengumuman"
                                                        data-id="<%= p.id_pengumuman %>"
                                                        data-judul="<%= p.judul_pengumuman %>"
                                                        data-isi="<%= p.isi_pengumuman %>"
                                                        data-tanggal="<%= new Date(p.tanggal_terbit).toISOString().split('T')[0] %>">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
