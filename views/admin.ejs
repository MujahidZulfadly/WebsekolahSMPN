    <!-- CLIENT JAVASCRIPT LOGIC -->
    <script>
        // Tab switching logic
        const tabTitles = {
            'overview': 'Dashboard Overview',
            'berita': 'Kelola Berita & Artikel',
            'pengumuman': 'Kelola Pengumuman Resmi',
            'guru': 'Kelola Guru & Tenaga Kependidikan',
            'komite': 'Kelola Komite Sekolah',
            'ppdb': 'Kelola Penerimaan Peserta Didik Baru (PPDB 2026/2027)',
            'eskul': 'Kelola Ekstrakurikuler Siswa',
            'galeri': 'Kelola Galeri Dokumentasi Foto',
            'profil': 'Edit Profil & Informasi Sekolah',
            'pesan': 'Kotak Masuk Pesan Pengunjung'
        };

        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-blue-600', 'text-white');
                btn.classList.add('text-slate-300');
            });

            const targetEl = document.getElementById('tab-' + tabId);
            if (targetEl) {
                targetEl.classList.add('active');
            }

            const activeBtn = document.querySelector(`.nav-btn[data-tab="${tabId}"]`);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-300');
                activeBtn.classList.add('bg-blue-600', 'text-white');
            }

            const titleEl = document.getElementById('topbar-title');
            if (titleEl && tabTitles[tabId]) {
                titleEl.textContent = tabTitles[tabId];
            }

            window.location.hash = tabId;
        }

        // Modal Handlers
        function openModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('hidden');
        }

        function closeModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        }

        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                document.querySelectorAll('[id^="modal-"]').forEach(el => el.classList.add('hidden'));
            }
        });

        // Event Delegation for Edit & Detail Modals (Prevents any auto-formatter regex breaking!)
        document.addEventListener('click', function(e) {
            // 1. Edit Berita
            const editBeritaBtn = e.target.closest('.btn-edit-berita');
            if (editBeritaBtn) {
                document.getElementById('form-edit-berita').action = '/admin/berita/edit/' + editBeritaBtn.dataset.id;
                document.getElementById('edit-berita-judul').value = editBeritaBtn.dataset.judul;
                document.getElementById('edit-berita-kategori').value = editBeritaBtn.dataset.kategori;
                document.getElementById('edit-berita-isi').value = editBeritaBtn.dataset.isi;
                document.getElementById('edit-berita-status').value = editBeritaBtn.dataset.status;
                openModal('modal-edit-berita');
                return;
            }

            // 2. Edit Pengumuman
            const editPengumumanBtn = e.target.closest('.btn-edit-pengumuman');
            if (editPengumumanBtn) {
                document.getElementById('form-edit-pengumuman').action = '/admin/pengumuman/edit/' + editPengumumanBtn.dataset.id;
                document.getElementById('edit-pengumuman-judul').value = editPengumumanBtn.dataset.judul;
                document.getElementById('edit-pengumuman-isi').value = editPengumumanBtn.dataset.isi;
                document.getElementById('edit-pengumuman-tanggal').value = editPengumumanBtn.dataset.tanggal;
                openModal('modal-edit-pengumuman');
                return;
            }

            // 3. Edit Guru
            const editGuruBtn = e.target.closest('.btn-edit-guru');
            if (editGuruBtn) {
                document.getElementById('form-edit-guru').action = '/admin/guru/edit/' + editGuruBtn.dataset.id;
                document.getElementById('edit-guru-nama').value = editGuruBtn.dataset.nama;
                document.getElementById('edit-guru-nip').value = editGuruBtn.dataset.nip;
                document.getElementById('edit-guru-jk').value = editGuruBtn.dataset.jk;
                document.getElementById('edit-guru-jabatan').value = editGuruBtn.dataset.jabatan;
                document.getElementById('edit-guru-kategori').value = editGuruBtn.dataset.kategori;
                document.getElementById('edit-guru-urutan').value = editGuruBtn.dataset.urutan;
                document.getElementById('edit-guru-status').value = editGuruBtn.dataset.status;
                openModal('modal-edit-guru');
                return;
            }

            // 3b. Edit Komite Sekolah
            const editKomiteBtn = e.target.closest('.btn-edit-komite');
            if (editKomiteBtn) {
                openEditKomite(editKomiteBtn);
                return;
            }

            // 4. Detail Pesan
            const detailPesanBtn = e.target.closest('.btn-detail-pesan');
            if (detailPesanBtn) {
                document.getElementById('detail-pesan-pengirim').textContent = detailPesanBtn.dataset.pengirim;
                document.getElementById('detail-pesan-kontak').textContent = detailPesanBtn.dataset.kontak;
                document.getElementById('detail-pesan-subjek').textContent = detailPesanBtn.dataset.subjek;
                document.getElementById('detail-pesan-isi').textContent = detailPesanBtn.dataset.isi;
                document.getElementById('detail-pesan-tanggal').textContent = detailPesanBtn.dataset.tanggal;
                openModal('modal-lihat-pesan');
                return;
            }

            // 5. Edit Ekstrakurikuler
            const editEskulBtn = e.target.closest('.btn-edit-eskul');
            if (editEskulBtn) {
                document.getElementById('form-edit-eskul').action = '/admin/eskul/edit/' + editEskulBtn.dataset.id;
                document.getElementById('edit-eskul-nama').value = editEskulBtn.dataset.nama;
                document.getElementById('edit-eskul-pembina').value = editEskulBtn.dataset.pembina;
                document.getElementById('edit-eskul-jadwal').value = editEskulBtn.dataset.jadwal;
                document.getElementById('edit-eskul-deskripsi').value = editEskulBtn.dataset.deskripsi;
                openModal('modal-edit-eskul');
                return;
            }

            // 6. Edit Galeri Foto
            const editGaleriBtn = e.target.closest('.btn-edit-galeri');
            if (editGaleriBtn) {
                document.getElementById('form-edit-galeri').action = '/admin/galeri/edit/' + editGaleriBtn.dataset.id;
                document.getElementById('edit-galeri-judul').value = editGaleriBtn.dataset.judul;
                document.getElementById('edit-galeri-kategori').value = editGaleriBtn.dataset.kategori;
                document.getElementById('edit-galeri-tanggal').value = editGaleriBtn.dataset.tgl;
                document.getElementById('edit-galeri-deskripsi').value = editGaleriBtn.dataset.deskripsi;
                openModal('modal-edit-galeri');
                return;
            }

            // 7. Detail Pendaftar PPDB
            const detailPPDBBtn = e.target.closest('.btn-detail-ppdb');
            if (detailPPDBBtn) {
                document.getElementById('detail-ppdb-no').textContent = detailPPDBBtn.dataset.no;
                document.getElementById('detail-ppdb-nama').textContent = detailPPDBBtn.dataset.nama;
                document.getElementById('detail-ppdb-nisn').textContent = detailPPDBBtn.dataset.nisn;
                document.getElementById('detail-ppdb-jk').textContent = detailPPDBBtn.dataset.jk;
                document.getElementById('detail-ppdb-sekolah').textContent = detailPPDBBtn.dataset.sekolah;
                document.getElementById('detail-ppdb-jalur').textContent = 'Jalur ' + detailPPDBBtn.dataset.jalur;
                document.getElementById('detail-ppdb-ortu').textContent = detailPPDBBtn.dataset.ortu;
                document.getElementById('detail-ppdb-hp').textContent = detailPPDBBtn.dataset.hp;
                document.getElementById('detail-ppdb-alamat').textContent = detailPPDBBtn.dataset.alamat;
                document.getElementById('detail-ppdb-catatan').textContent = (detailPPDBBtn.dataset.catatan && detailPPDBBtn.dataset.catatan !== '-') ? detailPPDBBtn.dataset.catatan : 'Tidak ada catatan khusus';
                document.getElementById('detail-ppdb-tanggal').textContent = detailPPDBBtn.dataset.tanggal;

                // Field Tambahan Baru
                document.getElementById('detail-ppdb-ttl').textContent = (detailPPDBBtn.dataset.tempatlahir || '-') + ', ' + (detailPPDBBtn.dataset.tanggallahir || '-');
                document.getElementById('detail-ppdb-agama').textContent = detailPPDBBtn.dataset.agama || '-';
                document.getElementById('detail-ppdb-email').textContent = detailPPDBBtn.dataset.email || '-';
                document.getElementById('detail-ppdb-nowa').textContent = detailPPDBBtn.dataset.nowa || '-';
                document.getElementById('detail-ppdb-npsn').textContent = detailPPDBBtn.dataset.npsn || '-';
                document.getElementById('detail-ppdb-ayah').textContent = detailPPDBBtn.dataset.ayah || '-';
                document.getElementById('detail-ppdb-ibu').textContent = detailPPDBBtn.dataset.ibu || '-';
                document.getElementById('detail-ppdb-pekerjaan').textContent = detailPPDBBtn.dataset.pekerjaan || '-';
                document.getElementById('detail-ppdb-penghasilan').textContent = detailPPDBBtn.dataset.penghasilan || '-';

                // Berkas Upload Rendering
                const foto = detailPPDBBtn.dataset.foto;
                const fotoPreview = document.getElementById('detail-ppdb-foto-preview');
                const fotoContainer = document.getElementById('detail-ppdb-foto-link-container');
                if (foto && foto.trim() !== '') {
                    fotoPreview.innerHTML = `<img src="/uploads/ppdb/${foto}" class="w-full h-full object-cover">`;
                    fotoContainer.innerHTML = `<a href="/uploads/ppdb/${foto}" target="_blank" class="px-2 py-1 bg-blue-50 text-blue-900 rounded-lg font-bold text-[10px] hover:bg-blue-100 border border-blue-200 block text-center">Buka Foto ↗</a>`;
                } else {
                    fotoPreview.innerHTML = `<i class="fa-solid fa-image text-slate-300 text-xl"></i>`;
                    fotoContainer.innerHTML = `<span class="text-[10px] text-slate-400 font-semibold block text-center">Belum Ada</span>`;
                }

                const kk = detailPPDBBtn.dataset.kk;
                const kkContainer = document.getElementById('detail-ppdb-kk-link-container');
                if (kk && kk.trim() !== '') {
                    kkContainer.innerHTML = `<a href="/uploads/ppdb/${kk}" target="_blank" class="px-2 py-1 bg-red-50 text-red-700 rounded-lg font-bold text-[10px] hover:bg-red-100 border border-red-200 block text-center">Unduh KK ↗</a>`;
                } else {
                    kkContainer.innerHTML = `<span class="text-[10px] text-slate-400 font-semibold block text-center">Belum Ada</span>`;
                }

                const akta = detailPPDBBtn.dataset.akta;
                const aktaContainer = document.getElementById('detail-ppdb-akta-link-container');
                if (akta && akta.trim() !== '') {
                    aktaContainer.innerHTML = `<a href="/uploads/ppdb/${akta}" target="_blank" class="px-2 py-1 bg-red-50 text-red-700 rounded-lg font-bold text-[10px] hover:bg-red-100 border border-red-200 block text-center">Unduh Akta ↗</a>`;
                } else {
                    aktaContainer.innerHTML = `<span class="text-[10px] text-slate-400 font-semibold block text-center">Belum Ada</span>`;
                }

                const ijazah = detailPPDBBtn.dataset.ijazah;
                const ijazahContainer = document.getElementById('detail-ppdb-ijazah-link-container');
                if (ijazah && ijazah.trim() !== '') {
                    ijazahContainer.innerHTML = `<a href="/uploads/ppdb/${ijazah}" target="_blank" class="px-2 py-1 bg-amber-50 text-amber-800 rounded-lg font-bold text-[10px] hover:bg-amber-100 border border-amber-200 block text-center">Unduh SKL ↗</a>`;
                } else {
                    ijazahContainer.innerHTML = `<span class="text-[10px] text-slate-400 font-semibold block text-center">Belum Ada</span>`;
                }

                const cleanHp = (detailPPDBBtn.dataset.hp || '').replace(/[^0-9]/g, '');
                const waLink = cleanHp.startsWith('0') ? '62' + cleanHp.substring(1) : cleanHp;
                const waHref = `https://wa.me/${waLink}?text=Halo%20Bpk/Ibu%20${encodeURIComponent(detailPPDBBtn.dataset.ortu)},%20terkait%20pendaftaran%20PPDB%20SMPN%201%20Rantepao%20ananda%20${encodeURIComponent(detailPPDBBtn.dataset.nama)}`;
                document.getElementById('detail-ppdb-wa-link').href = waHref;

                const statusBadge = document.getElementById('detail-ppdb-status-badge');
                statusBadge.textContent = detailPPDBBtn.dataset.status;
                statusBadge.className = 'px-3 py-1 rounded-full text-xs font-bold ' + 
                    (detailPPDBBtn.dataset.status === 'Diterima' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                    (detailPPDBBtn.dataset.status === 'Berkas Terverifikasi' ? 'bg-blue-50 text-blue-700 border border-blue-200' :
                    (detailPPDBBtn.dataset.status === 'Tidak Diterima' ? 'bg-red-50 text-red-700 border border-red-200' : 'bg-amber-50 text-amber-700 border border-amber-200')));

                // Bind Quick Status Button inside detail modal
                const quickStatusBtn = document.getElementById('btn-quick-status-from-detail');
                quickStatusBtn.onclick = function() {
                    closeModal('modal-detail-ppdb');
                    document.getElementById('form-status-ppdb').action = '/admin/ppdb/status/' + detailPPDBBtn.dataset.id;
                    document.getElementById('status-ppdb-nama').textContent = detailPPDBBtn.dataset.nama;
                    document.getElementById('status-ppdb-no').textContent = 'No. Pendaftaran: ' + detailPPDBBtn.dataset.no;
                    document.getElementById('status-ppdb-select').value = detailPPDBBtn.dataset.status;
                    document.getElementById('status-ppdb-catatan').value = (detailPPDBBtn.dataset.catatan && detailPPDBBtn.dataset.catatan !== '-') ? detailPPDBBtn.dataset.catatan : '';
                    openModal('modal-status-ppdb');
                };

                openModal('modal-detail-ppdb');
                return;
            }

            // 8. Ubah Status PPDB
            const statusPPDBBtn = e.target.closest('.btn-status-ppdb');
            if (statusPPDBBtn) {
                document.getElementById('form-status-ppdb').action = '/admin/ppdb/status/' + statusPPDBBtn.dataset.id;
                document.getElementById('status-ppdb-nama').textContent = statusPPDBBtn.dataset.nama;
                document.getElementById('status-ppdb-no').textContent = 'No. Pendaftaran: ' + statusPPDBBtn.dataset.no;
                document.getElementById('status-ppdb-select').value = statusPPDBBtn.dataset.status;
                document.getElementById('status-ppdb-catatan').value = statusPPDBBtn.dataset.catatan || '';
                openModal('modal-status-ppdb');
                return;
            }

            // 9. Edit Data PPDB
            const editPPDBBtn = e.target.closest('.btn-edit-ppdb');
            if (editPPDBBtn) {
                document.getElementById('form-edit-ppdb').action = '/admin/ppdb/edit/' + editPPDBBtn.dataset.id;
                document.getElementById('edit-ppdb-header-no').textContent = 'No. Registrasi: ' + editPPDBBtn.dataset.no;
                document.getElementById('edit-ppdb-nama').value = editPPDBBtn.dataset.nama;
                document.getElementById('edit-ppdb-nisn').value = editPPDBBtn.dataset.nisn !== '-' ? editPPDBBtn.dataset.nisn : '';
                document.getElementById('edit-ppdb-jk').value = editPPDBBtn.dataset.jk;
                document.getElementById('edit-ppdb-sekolah').value = editPPDBBtn.dataset.sekolah;
                document.getElementById('edit-ppdb-jalur').value = editPPDBBtn.dataset.jalur;
                document.getElementById('edit-ppdb-status').value = editPPDBBtn.dataset.status;
                document.getElementById('edit-ppdb-ortu').value = editPPDBBtn.dataset.ortu;
                document.getElementById('edit-ppdb-hp').value = editPPDBBtn.dataset.hp;
                document.getElementById('edit-ppdb-alamat').value = editPPDBBtn.dataset.alamat;
                document.getElementById('edit-ppdb-catatan').value = editPPDBBtn.dataset.catatan || '';
                openModal('modal-edit-ppdb');
                return;
            }
        });

        // Search & Filter in PPDB Table
        function filterPPDBTable() {
            const query = (document.getElementById('search-ppdb').value || '').toLowerCase().trim();
            const jalur = document.getElementById('filter-ppdb-jalur').value;
            const status = document.getElementById('filter-ppdb-status').value;
            const rows = document.querySelectorAll('#table-ppdb tbody tr.ppdb-row');
            let visibleCount = 0;

            rows.forEach(r => {
                const rowText = r.innerText.toLowerCase();
                const rowJalur = r.dataset.jalur || '';
                const rowStatus = r.dataset.status || '';

                const matchQuery = !query || rowText.includes(query);
                const matchJalur = !jalur || rowJalur === jalur;
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchJalur && matchStatus) {
                    r.style.display = '';
                    visibleCount++;
                } else {
                    r.style.display = 'none';
                }
            });

            const counter = document.getElementById('ppdb-counter-text');
            if (counter) {
                counter.textContent = `Menampilkan ${visibleCount} dari ${rows.length} calon siswa`;
            }
        }

        function resetPPDBFilter() {
            document.getElementById('search-ppdb').value = '';
            document.getElementById('filter-ppdb-jalur').value = '';
            document.getElementById('filter-ppdb-status').value = '';
            filterPPDBTable();
        }

        // Search in Eskul Table
        function filterEskulTable() {
            const query = document.getElementById('search-eskul').value.toLowerCase();
            const rows = document.querySelectorAll('#table-eskul tbody tr');
            rows.forEach(r => {
                const text = r.innerText.toLowerCase();
                r.style.display = text.includes(query) ? '' : 'none';
            });
        }

