                        <input type="text" name="pembina" required placeholder="Contoh: Ibu Margaretha, S.Sn." class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Jadwal Latihan</label>
