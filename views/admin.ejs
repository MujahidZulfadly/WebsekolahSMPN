                                </button>
                                <button type="button" onclick="execVisualCmd('underline')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-800 underline text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Garis Bawah (Ctrl+U)">
                                    <i class="fa-solid fa-underline"></i>
                                </button>
                            </div>

                            <!-- Lists -->
                            <div class="flex items-center gap-1 pr-1.5 border-r border-slate-200">
                                <button type="button" onclick="execVisualCmd('insertUnorderedList')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Daftar Poin (Bullet List)">
                                    <i class="fa-solid fa-list-ul"></i>
                                </button>
                                <button type="button" onclick="execVisualCmd('insertOrderedList')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 text-xs flex items-center justify-center transition shadow-xs cursor-pointer" title="Daftar Angka (Numbered List)">
                                    <i class="fa-solid fa-list-ol"></i>
                                </button>
