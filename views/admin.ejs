    <!-- ============================================== -->
    <!-- 11. MODAL EDIT DATA PENDAFTAR PPDB -->
    <!-- ============================================== -->
    <div id="modal-edit-ppdb" class="fixed inset-0 z-50 hidden bg-slate-950/60 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 overflow-y-auto max-h-[90vh]">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <div>
                    <h3 class="font-bold text-base sm:text-lg text-slate-800 flex items-center gap-2">
                        <i class="fa-solid fa-pen-to-square text-blue-600"></i>
                        <span>Edit Data Calon Siswa PPDB</span>
                    </h3>
                    <p id="edit-ppdb-header-no" class="text-xs text-blue-900 font-mono font-bold mt-0.5"></p>
                </div>
                <button type="button" onclick="closeModal('modal-edit-ppdb')" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="form-edit-ppdb" method="POST" class="space-y-4 mt-4 text-xs">
                <div class="grid sm:grid-cols-12 gap-4">
                    <div class="sm:col-span-8">
                        <label class="block font-semibold text-slate-600 mb-1">Nama Lengkap Siswa *</label>
                        <input type="text" id="edit-ppdb-nama" name="nama_siswa" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                    <div class="sm:col-span-4">
                        <label class="block font-semibold text-slate-600 mb-1">NISN (10 Digit)</label>
                        <input type="text" id="edit-ppdb-nisn" name="nisn" maxlength="15" class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Jenis Kelamin *</label>
                        <select id="edit-ppdb-jk" name="jenis_kelamin" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white">
                            <option value="Laki-laki">Laki-laki</option>
                            <option value="Perempuan">Perempuan</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Asal Sekolah SD / MI *</label>
                        <input type="text" id="edit-ppdb-sekolah" name="asal_sekolah" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600">
                    </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-semibold text-slate-600 mb-1">Jalur Pendaftaran *</label>
                        <select id="edit-ppdb-jalur" name="jalur_pendaftaran" required class="w-full border border-slate-300 rounded-lg px-3 py-2.5 focus:outline-blue-600 bg-white">
                            <option value="Zonasi">Jalur Zonasi (Domisili KK)</option>
                            <option value="Prestasi">Jalur Prestasi (Akademik / Non-Akademik)</option>
                            <option value="Afirmasi">Jalur Afirmasi (KIP / PKH / Disabilitas)</option>
