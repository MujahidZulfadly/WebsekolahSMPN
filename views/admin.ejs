                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Controls -->
            <div class="flex items-center justify-between pt-5 mt-4 border-t border-slate-100">
                <button type="button" id="btn-quick-status-from-detail" class="px-4 py-2 text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <i class="fa-solid fa-scale-balanced"></i>
                    <span>Ubah Status Seleksi</span>
                </button>
                <button type="button" onclick="closeModal('modal-detail-ppdb')" class="px-5 py-2 text-xs font-bold bg-slate-800 hover:bg-slate-700 text-white rounded-xl transition">
                    Tutup Detail
