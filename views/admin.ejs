                                <button type="button" onclick="execVisualCmd('removeFormat')" class="w-7 h-7 rounded-lg bg-white hover:bg-slate-100 border border-slate-200 text-rose-600 text-xs flex items-center justify-center transition cursor-pointer" title="Hapus Format">
