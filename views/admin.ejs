        // Open & Populate Edit Modal for Komite Sekolah
        function openEditKomite(btn) {
            if (!btn) return;
            const id = btn.dataset.id;
            const nama = btn.dataset.nama || '';
            const jabatan = btn.dataset.jabatan || '';
            const periode = btn.dataset.periode || '';
            const unsur = btn.dataset.unsur || '';
            const urutan = btn.dataset.urutan || 10;
            const foto = btn.dataset.foto || '';

            document.getElementById('form-edit-komite').action = '/admin/komite/edit/' + id;
            document.getElementById('edit-komite-nama').value = nama;
            document.getElementById('edit-komite-jabatan').value = jabatan;
            document.getElementById('edit-komite-periode').value = periode;
            document.getElementById('edit-komite-unsur').value = unsur;
            document.getElementById('edit-komite-urutan').value = urutan;

            const imgEl = document.getElementById('edit-komite-img');
            const iconEl = document.getElementById('edit-komite-icon');
            const fileEl = document.getElementById('edit-komite-filename');

            if (foto && !foto.startsWith('default') && foto !== '') {
                imgEl.src = '/uploads/komite/' + foto;
                imgEl.classList.remove('hidden');
                iconEl.classList.add('hidden');
                fileEl.textContent = foto;
            } else {
                imgEl.classList.add('hidden');
                iconEl.classList.remove('hidden');
                fileEl.textContent = 'default-komite.jpg (Foto Bawaan)';
            }

            openModal('modal-edit-komite');
        }

        // Sidebar toggle for mobile
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            sb.classList.toggle('-translate-x-full');
        }

        // Initialize active tab from query param or hash on load
        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const queryTab = urlParams.get('tab');
            const hashTab = window.location.hash ? window.location.hash.substring(1) : null;
            const initialTab = queryTab || hashTab || '<%= activeTab || "overview" %>';
            switchTab(initialTab);
        });
    </script>
</body>
