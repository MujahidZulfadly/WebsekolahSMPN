                                    <i class="fa-solid fa-plus text-xs"></i>
                                    <span>Tambah Kartu Baru</span>
                                </button>
                            </div>
                        </div>

                        <!-- Container Dynamic Items List -->
                        <div id="halaman-items-container" class="space-y-3 max-h-[480px] overflow-y-auto pr-1">
