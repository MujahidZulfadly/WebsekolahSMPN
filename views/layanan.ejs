<!DOCTYPE html>
<html lang="id" class="scroll-smooth">

<head>
    <%- include('partials/head', { title: (layanan.namaLengkap || layanan.nama) + ' - Layanan Sekolah | ' + (profil.nama_sekolah || 'UPT SMPN 1 Rantepao') }) %>
</head>

<body class="bg-slate-50 text-slate-800 font-sans antialiased flex flex-col min-h-screen selection:bg-amber-500 selection:text-blue-950">

    <!-- Navbar Global -->
    <%- include('partials/navbar', { activePage: 'layanan' }) %>

    <!-- ============================================================== -->
    <!-- SUB-HERO BANNER                                                -->
    <!-- ============================================================== -->
    <section class="relative bg-gradient-to-br from-blue-950 via-blue-900 to-slate-900 text-white pt-14 pb-20 sm:pt-16 sm:pb-24 px-4 sm:px-6 lg:px-8 overflow-hidden">
        <!-- Ambient Background Glow Circles -->
        <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-blue-600/20 blur-3xl pointer-events-none"></div>
        <div class="absolute top-1/2 -right-24 w-80 h-80 rounded-full bg-amber-500/15 blur-3xl pointer-events-none"></div>

        <div class="max-w-5xl mx-auto relative z-10 text-center">

            <!-- Breadcrumbs Navigation -->
            <nav class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs text-slate-300 mb-5">
                <a href="/" class="hover:text-amber-400 transition-colors font-medium">Beranda</a>
                <span class="text-slate-500 text-[10px]">/</span>
                <span class="text-slate-300">Layanan Lain</span>
                <span class="text-slate-500 text-[10px]">/</span>
                <span class="text-amber-400 font-bold"><%= layanan.nama %></span>
            </nav>

            <!-- Kategori Badge -->
            <div class="mb-3">
                <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/40 text-amber-300 text-xs font-black uppercase tracking-wider backdrop-blur-md shadow-sm">
                    <i class="fa-solid <%= layanan.icon %> text-amber-400"></i>
                    <span><%= layanan.kategori %></span>
                </span>
            </div>

            <!-- Page Title -->
            <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight">
                <%= layanan.namaLengkap || layanan.nama %>
            </h1>

            <!-- Subtitle -->
            <p class="mt-3.5 text-sm sm:text-base text-slate-300 max-w-2xl mx-auto leading-relaxed font-normal">
                <%= layanan.deskripsi %>
            </p>

        </div>

        <!-- Wave Divider Bottom -->
        <div class="absolute bottom-0 left-0 w-full overflow-hidden leading-none pointer-events-none">
            <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-8 sm:h-12 preserve-3d">
                <path d="M0,32 C360,60 1080,0 1440,32 L1440,60 L0,60 Z" class="fill-slate-50"></path>
            </svg>
        </div>
    </section>

    <!-- ============================================================== -->
    <!-- KONTEN: HALAMAN CONTOH / PLACEHOLDER LAYANAN EKSTERNAL          -->
    <!-- ============================================================== -->
    <main class="flex-grow max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-6 sm:-mt-10 relative z-20 w-full mb-16">
        
        <!-- Kartu Utama Placeholder -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-xl border border-slate-200/80 text-center relative overflow-hidden">
            
            <!-- Top Subtle Stripe -->
            <div class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-amber-400 via-amber-500 to-yellow-400"></div>

            <!-- Big Icon Display -->
            <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto rounded-3xl bg-amber-50 text-amber-600 border border-amber-200 flex items-center justify-center text-3xl sm:text-4xl shadow-inner mb-6">
                <i class="fa-solid <%= layanan.icon %>"></i>
            </div>

            <!-- Status Pill -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold mb-4 border border-slate-200">
                <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                <span>Halaman Contoh / Web Mandiri Terpisah</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-black text-blue-950 tracking-tight">
                Portal <%= layanan.nama %>
            </h2>

            <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto mt-3 leading-relaxed">
                Menu ini merupakan contoh integrasi tautan ke sistem / aplikasi mandiri. Setiap layanan pada menu ini sesungguhnya memiliki sistem web tersendiri di luar portal utama sekolah.
            </p>

            <!-- Card Info Box -->
            <div class="max-w-lg mx-auto mt-8 bg-slate-50 border border-slate-200 rounded-2xl p-4 sm:p-5 text-left space-y-3">
                <div class="flex items-start gap-3">
                    <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-900 flex items-center justify-center text-xs shrink-0 mt-0.5">
                        <i class="fa-solid fa-circle-info"></i>
                    </span>
                    <div class="text-xs text-slate-600 leading-relaxed">
                        <span class="font-bold text-slate-800">Catatan Sistem:</span>
                        <%= layanan.catatan %>
                    </div>
                </div>
                <div class="flex items-start gap-3 pt-2.5 border-t border-slate-200/70">
                    <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center text-xs shrink-0 mt-0.5">
                        <i class="fa-solid fa-link"></i>
                    </span>
                    <div class="text-xs text-slate-600 leading-relaxed">
                        <span class="font-bold text-slate-800">Tautan Eksternal:</span>
                        <span class="font-mono text-slate-500 bg-white px-2 py-0.5 rounded border border-slate-200 ml-1">Belum Terhubung (Simulasi)</span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                <a href="/" class="px-6 py-3 rounded-2xl bg-blue-950 hover:bg-blue-900 text-white font-bold text-xs shadow-lg shadow-blue-950/20 transition flex items-center gap-2">
                    <i class="fa-solid fa-arrow-left text-xs"></i>
                    <span>Kembali ke Beranda</span>
                </a>
                <button type="button" onclick="history.back()" class="px-5 py-3 rounded-2xl border border-slate-300 hover:bg-slate-50 text-slate-700 font-bold text-xs transition flex items-center gap-2">
                    <i class="fa-solid fa-rotate-left text-xs text-slate-400"></i>
                    <span>Halaman Sebelumnya</span>
                </button>
            </div>

        </div>

        <!-- ============================================================== -->
        <!-- JELAJAHI 10 LAYANAN LAINNYA                                    -->
        <!-- ============================================================== -->
        <div class="mt-12">
            <div class="flex items-center justify-between mb-5">
                <div>
                    <h3 class="font-black text-lg text-blue-950">Daftar Semua Layanan Lain</h3>
                    <p class="text-xs text-slate-500">Pilih salah satu menu layanan eksternal di bawah ini.</p>
                </div>
                <span class="text-xs font-bold text-amber-600 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
                    <%= (typeof semuaLayanan !== 'undefined') ? semuaLayanan.length : 10 %> Layanan
                </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                <% if (typeof semuaLayanan !== 'undefined' && semuaLayanan) { %>
                    <% semuaLayanan.forEach(item => { %>
                        <a href="/layanan/<%= item.slug %>" class="group p-4 rounded-2xl border transition-all duration-200 flex items-center gap-3.5 <%= item.slug === layanan.slug ? 'bg-amber-50/80 border-amber-300 shadow-sm' : 'bg-white hover:bg-slate-50 border-slate-200 hover:border-amber-300 hover:shadow-md' %>">
                            <span class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-bold shrink-0 transition-colors <%= item.slug === layanan.slug ? 'bg-amber-500 text-blue-950' : 'bg-slate-100 text-slate-600 group-hover:bg-amber-500 group-hover:text-blue-950' %>">
                                <i class="fa-solid <%= item.icon %>"></i>
                            </span>
                            <div class="min-w-0 flex-1">
                                <h4 class="font-bold text-xs text-blue-950 truncate group-hover:text-amber-600 transition-colors">
                                    <%= item.nama %>
                                </h4>
                                <p class="text-[11px] text-slate-500 truncate mt-0.5">
                                    <%= item.kategori %>
                                </p>
                            </div>
                            <i class="fa-solid fa-chevron-right text-xs text-slate-300 group-hover:text-amber-500 group-hover:translate-x-1 transition-all shrink-0"></i>
                        </a>
                    <% }); %>
                <% } %>
            </div>
        </div>

    </main>

    <!-- Footer Global -->
    <%- include('partials/footer') %>

</body>

</html>

